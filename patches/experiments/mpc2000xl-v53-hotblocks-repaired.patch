+bool nec_common_device::execute_mpc2000xl_v53_shift(
+	mpc2000xl_v53_hotblock_state &state, bool opcode_consumed)
+{
+	static constexpr u8 offsets[] = { 0, 2, 4, 6, 7, 10 };
+	static constexpr u8 lengths[] = { 2, 2, 2, 1, 3, 2 };
+
+	if ((state.active != mpc2000xl_v53_hotblock_state::block::SHIFT_014F1) ||
+		(state.index >= std::size(offsets)) || !m_mpc2000xl_v53_hotblocks_available ||
+		!m_MF || m_rep_params || m_seg_prefix || m_halted || m_TF ||
+		(Sreg(PS) != state.ps) ||
+		(m_ip != u16(state.ip + offsets[state.index] + (opcode_consumed ? 1 : 0))) ||
+		(machine().debug_flags & (DEBUG_FLAG_ENABLED | DEBUG_FLAG_CALL_HOOK)))
+	{
+		clear_mpc2000xl_v53_hotblock(state);
+		return false;
+	}
+
+	const unsigned index = state.index;
+	if ((index == 2) || (index == 5))
+	{
+		consume_mpc2000xl_v53_hotblock_bytes(1);
+		EMPTY_PREfetch();
+		consume_mpc2000xl_v53_hotblock_bytes(1);
+	}
+	else
+		consume_mpc2000xl_v53_hotblock_bytes(lengths[index] - (opcode_consumed ? 1 : 0));
+
+	switch (index)
+	{
+	case 0:
+	{
+		uint32_t ModRM = 0xe7, src = Wreg(IY), dst = src;
+		CLK(2);
+		SHL_WORD(1);
+		m_OverVal = (src ^ dst) & 0x8000;
+		break;
+	}
+	case 1:
+	{
+		uint32_t src = Wreg(IX), dst = src;
+		CLK(2);
+		ROLC_WORD;
+		Wreg(IX) = dst;
+		m_OverVal = (src ^ dst) & 0x8000;
+		break;
+	}
+	case 2:
+		if (CF)
+		{
+			CLK(3);
+			m_ip = u16(m_ip + 0x0b);
+			CHANGE_PC;
+			clear_mpc2000xl_v53_hotblock(state);
+			return true;
+		}
+		CLK(3);
+		break;
+	case 3:
+	{
+		IncWordReg(BP);
+		CLK(2);
+		break;
+	}
+	case 4:
+	{
+		uint32_t dst = Wreg(BP), src = 0x20;
+		SUBW;
+		CLK(2);
+		break;
+	}
+	case 5:
+		if (!ZF)
+		{
+			CLK(3);
+			m_ip = u16(m_ip - 12);
+			CHANGE_PC;
+			state.index = 0;
+		}
+		else
+		{
+			CLK(3);
+			clear_mpc2000xl_v53_hotblock(state);
+		}
+		return true;
+	}
+	state.index++;
+	return true;
+}
+
+bool nec_common_device::execute_mpc2000xl_v53_lcd(
+	mpc2000xl_v53_hotblock_state &state, bool opcode_consumed)
+{
+	static constexpr u8 offsets[] = { 0, 4, 8, 12, 15, 16, 18, 23, 25, 28, 29, 32 };
+	static constexpr u8 lengths[] = { 4, 4, 4, 3, 1, 2, 2, 2, 3, 1, 3, 2 };
+
+	if ((state.active != mpc2000xl_v53_hotblock_state::block::LCD_1ACBD) ||
+		(state.index >= std::size(offsets)) || !m_mpc2000xl_v53_hotblocks_available ||
+		!m_MF || m_rep_params || m_seg_prefix || m_halted || m_TF ||
+		(Sreg(PS) != state.ps) ||
+		(m_ip != u16(state.ip + offsets[state.index] + (opcode_consumed ? 1 : 0))) ||
+		(machine().debug_flags & (DEBUG_FLAG_ENABLED | DEBUG_FLAG_CALL_HOOK)))
+	{
+		clear_mpc2000xl_v53_hotblock(state);
+		return false;
+	}
+
+	const unsigned index = state.index;
+	if (index == 6)
+	{
+		consume_mpc2000xl_v53_hotblock_bytes(1);
+		EMPTY_PREfetch();
+		consume_mpc2000xl_v53_hotblock_bytes(1);
+	}
+	else
+		consume_mpc2000xl_v53_hotblock_bytes(lengths[index] - (opcode_consumed ? 1 : 0));
+
+	switch (index)
+	{
+	case 0:
+	case 1:
+	case 2:
+	{
+		static constexpr u16 displacements[] = { 0x57a2, 0x5f22, 0x66a2 };
+		m_E16 = 0;
+		m_E16 = u8(displacements[index]);
+		m_E16 += u16(u8(displacements[index] >> 8)) << 8;
+		m_EO = u16(Wreg(BW) + (int16_t)m_E16);
+		m_EA = DefaultBase(DS0) + m_EO;
+		uint32_t src = read_mem_byte(m_EA);
+		uint32_t dst = Breg(AH);
+		if (index == 0)
+			dst = src;
+		else if (index == 1)
+		{
+			ORB;
+		}
+		else
+		{
+			XORB;
+		}
+		Breg(AH) = dst;
+		CLK(index ? 6 : 5);
+		break;
+	}
+	case 3:
+		Wreg(DW) = 0x0060;
+		CLK(2);
+		break;
+	case 4:
+		Breg(AL) = read_port_byte(Wreg(DW));
+		CLK(5);
+		clear_mpc2000xl_v53_hotblock(state);
+		break;
+	case 5:
+	{
+		uint32_t ModRM = 0xe0, src = Breg(AL), dst = src;
+		CLK(2);
+		SHL_BYTE(1);
+		m_OverVal = (src ^ dst) & 0x80;
+		break;
+	}
+	case 6:
+		if (ZF)
+		{
+			CLK(3);
+			m_ip = u16(m_ip + 3);
+			CHANGE_PC;
+			state.index = 7;
+		}
+		else
+		{
+			CLK(3);
+			clear_mpc2000xl_v53_hotblock(state);
+		}
+		return true;
+	case 7:
+		Breg(AL) = Breg(AH);
+		CLK(2);
+		break;
+	case 8:
+		Wreg(DW) = 0x0062;
+		CLK(2);
+		break;
+	case 9:
+		write_port_byte(Wreg(DW), Breg(AL));
+		CLK(3);
+		clear_mpc2000xl_v53_hotblock(state);
+		break;
+	case 10:
+	{
+		uint32_t dst = Wreg(BW), src = 0x20;
+		ADDW;
+		Wreg(BW) = dst;
+		CLK(2);
+		break;
+	}
+	case 11:
+		Wreg(CW)--;
+		if (Wreg(CW))
+		{
+			m_ip = u16(m_ip - 34);
+			CLK(6);
+			state.index = 0;
+		}
+		else
+		{
+			CLK(3);
+			clear_mpc2000xl_v53_hotblock(state);
+		}
+		return true;
+	}
+	if (state.active != mpc2000xl_v53_hotblock_state::block::NONE)
+		state.index++;
+	return true;
+}
