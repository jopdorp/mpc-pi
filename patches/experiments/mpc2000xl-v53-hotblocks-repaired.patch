+bool nec_common_device::try_mpc2000xl_v53_hotblock_8a(
+	mpc2000xl_v53_hotblock_state &state, u16 ps, u16 ip)
+{
+	static constexpr u8 blit_code[] =
+	{
+		0x8a, 0x25, 0x8a, 0x45, 0x01, 0x23, 0xc2, 0x8a,
+		0x3c, 0x2a, 0xdb, 0xd3, 0xeb, 0x0b, 0xc3, 0x88,
+		0x25, 0x88, 0x45, 0x01, 0x46, 0x83, 0xc7, 0x20,
+		0xfe, 0xcd, 0x75, 0xe4
+	};
+	static constexpr u8 lcd_code[] =
+	{
+		0x8a, 0xa7, 0xa2, 0x57, 0x0a, 0xa7, 0x22, 0x5f,
+		0x32, 0xa7, 0xa2, 0x66, 0xba, 0x60, 0x00, 0xec,
+		0xd0, 0xe0, 0x74, 0x03, 0xe8, 0xd1, 0xfe, 0x8a,
+		0xc4, 0xba, 0x62, 0x00, 0xee, 0x83, 0xc3, 0x20,
+		0xe2, 0xde
+	};
+
+	if ((Sreg(PS) != ps) || (m_ip != u16(ip + 1)) || m_seg_prefix ||
+		m_TF ||
+		(machine().debug_flags & (DEBUG_FLAG_ENABLED | DEBUG_FLAG_CALL_HOOK)) ||
+		((((u32(ps) << 4) + ip) != 0x1b1a8U) &&
+			(((u32(ps) << 4) + ip) != 0x1acbdU)))
+		return false;
+
+	if (((u32(ps) << 4) + ip) == 0x1b1a8U)
+	{
+		if (!(m_mpc2000xl_v53_hotblock_mask & 0x01))
+			return false;
+		if (!validate_mpc2000xl_v53_hotblock_code(state, ps, ip, blit_code, std::size(blit_code)) ||
+			!validate_mpc2000xl_v53_blit_data(state))
+			return false;
+		state.active = mpc2000xl_v53_hotblock_state::block::BLIT_1B1A8;
+	}
+	else
+	{
+		if (!(m_mpc2000xl_v53_hotblock_mask & 0x04))
+			return false;
+		if (!validate_mpc2000xl_v53_hotblock_code(state, ps, ip, lcd_code, std::size(lcd_code)) ||
+			!validate_mpc2000xl_v53_lcd_data())
+			return false;
+		state.active = mpc2000xl_v53_hotblock_state::block::LCD_1ACBD;
+	}
+	state.index = 0;
+	state.ps = ps;
+	state.ip = ip;
+	return execute_mpc2000xl_v53_hotblock(state, true);
+}
+
+bool nec_common_device::try_mpc2000xl_v53_hotblock_d1(
+	mpc2000xl_v53_hotblock_state &state, u16 ps, u16 ip)
+{
+	static constexpr u8 shift_code[] =
+	{
+		0xd1, 0xe7, 0xd1, 0xd6, 0x72, 0x0b,
+		0x45, 0x83, 0xfd, 0x20, 0x75, 0xf4
+	};
+
+	if ((Sreg(PS) != ps) || (m_ip != u16(ip + 1)) ||
+		((u32(ps) << 4) + ip) != 0x014f1U || m_seg_prefix || m_TF ||
+		!Wreg(BP) || (Wreg(BP) > 31) ||
+		!(m_mpc2000xl_v53_hotblock_mask & 0x02) ||
+		(machine().debug_flags & (DEBUG_FLAG_ENABLED | DEBUG_FLAG_CALL_HOOK)) ||
+		!validate_mpc2000xl_v53_hotblock_code(state, ps, ip, shift_code, std::size(shift_code)))
+		return false;
+
+	state.active = mpc2000xl_v53_hotblock_state::block::SHIFT_014F1;
+	state.index = 0;
+	state.ps = ps;
+	state.ip = ip;
+	return execute_mpc2000xl_v53_hotblock(state, true);
+}
+
+bool nec_common_device::execute_mpc2000xl_v53_hotblock(
+	mpc2000xl_v53_hotblock_state &state, bool opcode_consumed)
+{
+	switch (state.active)
+	{
+	case mpc2000xl_v53_hotblock_state::block::BLIT_1B1A8:
+		return execute_mpc2000xl_v53_blit(state, opcode_consumed);
+	case mpc2000xl_v53_hotblock_state::block::SHIFT_014F1:
+		return execute_mpc2000xl_v53_shift(state, opcode_consumed);
+	case mpc2000xl_v53_hotblock_state::block::LCD_1ACBD:
+		return execute_mpc2000xl_v53_lcd(state, opcode_consumed);
+	default:
+		return false;
+	}
+}
