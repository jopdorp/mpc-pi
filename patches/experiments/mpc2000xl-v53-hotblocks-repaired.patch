+bool nec_common_device::validate_mpc2000xl_v53_hotblock_code(
+	mpc2000xl_v53_hotblock_state &state, u16 ps, u16 ip, const u8 *bytes, unsigned length)
+{
+	if (!length || ((u32(ip) + length) > 0x10000U))
+		return false;
+
+	const u32 logical_start = (u32(ps) << 4) + ip;
+	const u32 logical_end = logical_start + length - 1;
+	if (m_xa && ((logical_start >> 14) != (logical_end >> 14)))
+		return false;
+
+	const offs_t address_mask = m_program->addrmask();
+	const offs_t physical_start = v33_translate(logical_start) & address_mask;
+	if ((physical_start >> 12) != ((physical_start + length - 1) >> 12))
+		return false;
+
+	memory_access<24, 1, 0, ENDIANNESS_LITTLE>::specific program;
+	m_program->specific(program);
+	u16 const *start_words = nullptr;
+	const offs_t physical_word_start = physical_start & ~offs_t(1);
+	for (unsigned index = 0; index < length; ++index)
+	{
+		const offs_t physical = v33_translate(logical_start + index) & address_mask;
+		if (physical != (physical_start + index))
+			return false;
+		if (program.lookup_read_byte_flags(physical) != 0)
+			return false;
+
+		u16 const *const words = reinterpret_cast<u16 const *>(
+			m_cache16.read_ptr(physical & ~offs_t(1)));
+		if (!words)
+			return false;
+		if (!start_words)
+			start_words = words;
+		if (words != (start_words + (((physical & ~offs_t(1)) - physical_word_start) >> 1)))
+			return false;
+	}
+
+	u8 const *const current = reinterpret_cast<u8 const *>(start_words);
+	for (unsigned index = 0; index < length; ++index)
+		if (current[BYTE_XOR_LE((physical_start & 1) + index)] != bytes[index])
+			return false;
+
+	state.code_start = physical_start;
+	state.code_end = physical_start + length - 1;
+	return true;
+}
