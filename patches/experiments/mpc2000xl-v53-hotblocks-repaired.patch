+bool nec_common_device::execute_mpc2000xl_v53_blit(
+	mpc2000xl_v53_hotblock_state &state, bool opcode_consumed)
+{
+	static constexpr u8 offsets[] = { 0, 2, 5, 7, 9, 11, 13, 15, 17, 20, 21, 24, 26 };
+	static constexpr u8 lengths[] = { 2, 3, 2, 2, 2, 2, 2, 2, 3, 1, 3, 2, 2 };
+
+	if ((state.active != mpc2000xl_v53_hotblock_state::block::BLIT_1B1A8) ||
+		(state.index >= std::size(offsets)) ||
+		!m_mpc2000xl_v53_hotblocks_available || !m_MF || m_rep_params ||
+		m_seg_prefix || m_halted || m_TF || (Sreg(PS) != state.ps) ||
+		(m_ip != u16(state.ip + offsets[state.index] +
+			(opcode_consumed ? 1 : 0))) ||
+		(machine().debug_flags & (DEBUG_FLAG_ENABLED | DEBUG_FLAG_CALL_HOOK)))
+	{
+		clear_mpc2000xl_v53_hotblock(state);
+		return false;
+	}
+
+	const unsigned index = state.index;
+	if (index == 12)
+	{
+		consume_mpc2000xl_v53_hotblock_bytes(1);
+		EMPTY_PREfetch();
+		consume_mpc2000xl_v53_hotblock_bytes(1);
+	}
+	else
+		consume_mpc2000xl_v53_hotblock_bytes(lengths[index] - (opcode_consumed ? 1 : 0));
+	switch (index)
+	{
+	case 0:
+		m_EO = Wreg(IY);
+		m_EA = DefaultBase(DS0) + m_EO;
+		Breg(AH) = read_mem_byte(m_EA);
+		CLK(5);
+		break;
+	case 1:
+		m_EO = u16(Wreg(IY) + 1);
+		m_EA = DefaultBase(DS0) + m_EO;
+		Breg(AL) = read_mem_byte(m_EA);
+		CLK(5);
+		break;
+	case 2:
+	{
+		uint32_t dst = Wreg(AW), src = Wreg(DW);
+		ANDW;
+		Wreg(AW) = dst;
+		CLK(2);
+		break;
+	}
+	case 3:
+		m_EO = Wreg(IX);
+		m_EA = DefaultBase(DS0) + m_EO;
+		Breg(BH) = read_mem_byte(m_EA);
+		CLK(5);
+		break;
+	case 4:
+	{
+		uint32_t dst = Breg(BL), src = Breg(BL);
+		SUBB;
+		Breg(BL) = dst;
+		CLK(2);
+		break;
+	}
+	case 5:
+	{
+		uint32_t ModRM = 0xeb, dst = Wreg(BW);
+		u8 const count = Breg(CL);
+		CLK(2);
+		if (count)
+		{
+			SHR_WORD(count);
+		}
+		break;
+	}
+	case 6:
+	{
+		uint32_t dst = Wreg(AW), src = Wreg(BW);
+		ORW;
+		Wreg(AW) = dst;
+		CLK(2);
+		break;
+	}
+	case 7:
+		m_EO = Wreg(IY);
+		m_EA = DefaultBase(DS0) + m_EO;
+		write_mem_byte(m_EA, Breg(AH));
+		CLK(3);
+		break;
+	case 8:
+		m_EO = u16(Wreg(IY) + 1);
+		m_EA = DefaultBase(DS0) + m_EO;
+		write_mem_byte(m_EA, Breg(AL));
+		CLK(3);
+		break;
+	case 9:
+	{
+		IncWordReg(IX);
+		CLK(2);
+		break;
+	}
+	case 10:
+	{
+		uint32_t dst = Wreg(IY), src = 0x20;
+		CLK(2);
+		ADDW;
+		Wreg(IY) = dst;
+		break;
+	}
+	case 11:
+	{
+		const uint32_t tmp = Breg(CH);
+		const uint32_t tmp1 = tmp - 1;
+		m_OverVal = (tmp == 0x80);
+		SetAF(tmp1, tmp, 1);
+		SetSZPF_Byte(tmp1);
+		Breg(CH) = tmp1;
+		CLK(2);
+		break;
+	}
+	case 12:
+		if (!ZF)
+		{
+			CLK(3);
+			m_ip = u16(m_ip - 28);
+			CHANGE_PC;
+			state.index = 0;
+		}
+		else
+		{
+			CLK(3);
+			clear_mpc2000xl_v53_hotblock(state);
+		}
+		return true;
+	}
+
+	state.index++;
+	return true;
+}
