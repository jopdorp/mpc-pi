+bool nec_common_device::validate_mpc2000xl_v53_blit_data(
+	const mpc2000xl_v53_hotblock_state &state)
+{
+	if (!Breg(CH) || (Breg(CH) > 7))
+		return false;
+
+	memory_access<24, 1, 0, ENDIANNESS_LITTLE>::specific program;
+	m_program->specific(program);
+	const offs_t address_mask = m_program->addrmask();
+	const u32 data_base = u32(Sreg(DS0)) << 4;
+
+	auto const direct_read = [this, &program, address_mask](u32 logical)
+	{
+		const offs_t physical = v33_translate(logical) & address_mask;
+		return !program.lookup_read_byte_flags(physical) &&
+			(m_cache16.read_ptr(physical & ~offs_t(1)) != nullptr);
+	};
+	auto const direct_nonoverlap_write = [this, &program, &state, address_mask](u32 logical)
+	{
+		const offs_t physical = v33_translate(logical) & address_mask;
+		return !program.lookup_write_byte_flags(physical) &&
+			(m_program->get_write_ptr(physical) != nullptr) &&
+			((physical < state.code_start) || (physical > state.code_end));
+	};
+
+	for (unsigned iteration = 0; iteration < Breg(CH); ++iteration)
+	{
+		const u16 si = u16(Wreg(IX) + iteration);
+		const u16 di = u16(Wreg(IY) + (iteration * 0x20));
+		if (!direct_read(data_base + si) ||
+			!direct_read(data_base + di) ||
+			!direct_read(data_base + u16(di + 1)) ||
+			!direct_nonoverlap_write(data_base + di) ||
+			!direct_nonoverlap_write(data_base + u16(di + 1)))
+			return false;
+	}
+	return true;
+}
+
+bool nec_common_device::validate_mpc2000xl_v53_lcd_data()
+{
+	if (!Wreg(CW) || (Wreg(CW) > 60))
+		return false;
+	const u16 column = u16(Wreg(BW) - (0x20 * (60 - Wreg(CW))));
+	if (column >= 0x14)
+		return false;
+
+	memory_access<24, 1, 0, ENDIANNESS_LITTLE>::specific program;
+	m_program->specific(program);
+	const offs_t address_mask = m_program->addrmask();
+	const u32 data_base = u32(Sreg(DS0)) << 4;
+	for (u16 const displacement : { u16(0x57a2), u16(0x5f22), u16(0x66a2) })
+	{
+		const u16 offset = u16(Wreg(BW) + displacement);
+		const offs_t physical = v33_translate(data_base + offset) & address_mask;
+		if (program.lookup_read_byte_flags(physical) ||
+			!m_cache16.read_ptr(physical & ~offs_t(1)))
+			return false;
+	}
+	return true;
+}
