diff --git a/src/mame/akai/mpc2000.cpp b/src/mame/akai/mpc2000.cpp
--- a/src/mame/akai/mpc2000.cpp
+++ b/src/mame/akai/mpc2000.cpp
@@ -760,12 +760,15 @@ void mpc2000_state::mpc2000(machine_config &config)
 	const bool brk88_hle = brk88_hle_mode && std::strcmp(brk88_hle_mode, "0");
 	const char *const brkfd_hle_mode = osd_getenv("MAME_MPC_V53_BRKFD_HLE");
 	const bool brkfd_hle = brkfd_hle_mode && std::strcmp(brkfd_hle_mode, "0");
+	const char *const direct_dispatch_mode = osd_getenv("MAME_MPC_V53_DIRECT_DISPATCH");
+	const bool direct_dispatch = direct_dispatch_mode && std::strcmp(direct_dispatch_mode, "0");
 	if (event_driven_panel)
 		add_panel(config, true, coalesced_panel_timer);
 
 	V53A(config, m_maincpu, 32_MHz_XTAL);
 	m_maincpu->set_mpc2000xl_brk88_hle(brk88_hle);
 	m_maincpu->set_mpc2000xl_brkfd_hle(brkfd_hle);
+	m_maincpu->set_mpc2000xl_direct_dispatch(direct_dispatch);
 	m_maincpu->set_direct_brc_timer(event_driven_panel);
 	m_maincpu->set_addrmap(AS_PROGRAM, &mpc2000_state::mpc2000_map);
 	m_maincpu->set_addrmap(AS_IO, &mpc2000_state::mpc2000_io_map);
