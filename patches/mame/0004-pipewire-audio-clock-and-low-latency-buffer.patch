+void sound_pipewire::write_capture(stream_info &stream)
+{
+	if (m_capture_path.empty() || (stream.m_name != ":speaker") || stream.m_capture.empty())
+		return;
+
+	std::ofstream output(m_capture_path, std::ios::binary | std::ios::trunc);
+	const uint32_t data_size = stream.m_capture.size() * sizeof(int16_t);
+	const uint16_t format = 1;
+	const uint16_t channels = stream.m_channels;
+	const uint16_t bits = 16;
+	const uint32_t byte_rate = stream.m_rate * channels * sizeof(int16_t);
+	const uint16_t block_align = channels * sizeof(int16_t);
+	const uint32_t riff_size = 36 + data_size;
+	output.write("RIFF", 4);
+	output.write(reinterpret_cast<const char *>(&riff_size), sizeof(riff_size));
+	output.write("WAVEfmt ", 8);
+	const uint32_t fmt_size = 16;
+	output.write(reinterpret_cast<const char *>(&fmt_size), sizeof(fmt_size));
+	output.write(reinterpret_cast<const char *>(&format), sizeof(format));
+	output.write(reinterpret_cast<const char *>(&channels), sizeof(channels));
+	output.write(reinterpret_cast<const char *>(&stream.m_rate), sizeof(stream.m_rate));
+	output.write(reinterpret_cast<const char *>(&byte_rate), sizeof(byte_rate));
+	output.write(reinterpret_cast<const char *>(&block_align), sizeof(block_align));
+	output.write(reinterpret_cast<const char *>(&bits), sizeof(bits));
+	output.write("data", 4);
+	output.write(reinterpret_cast<const char *>(&data_size), sizeof(data_size));
+	output.write(reinterpret_cast<const char *>(stream.m_capture.data()), data_size);
+	stream.m_capture.clear();
+}
