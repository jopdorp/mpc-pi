+void sound_pipewire::main_update()
+{
+	const bool realtime_pacing = m_audio_clock && (m_osd->machine().video().speed_factor() <= 1100);
+	const auto update_now = std::chrono::steady_clock::now();
+	pw_thread_loop_lock(m_loop);
+	if (realtime_pacing != m_realtime_pacing)
+	{
+		m_realtime_pacing = realtime_pacing;
+		if (realtime_pacing)
+		{
+			if (m_report_stats)
+				osd_printf_warning("PipeWire: realtime audio-clock pacing started\n");
+			m_realtime_generated_frames = 0;
+			m_realtime_start = std::chrono::steady_clock::now();
+			m_last_main_update = m_realtime_start;
+			m_main_update_count = 0;
+			for (auto &[id, stream] : m_streams)
+			{
+				if (!stream.m_is_output)
+					continue;
+				stream.m_buffer.clear();
+				stream.m_prebuffering = true;
+				stream.m_buffer_stats_ready = false;
+				stream.m_observed_underruns = 0;
+				stream.m_observed_overruns = 0;
+				stream.m_updates_since_report = 0;
+			}
+		}
+	}
+	else if (m_realtime_pacing)
+	{
+		const auto gap_us = std::chrono::duration_cast<std::chrono::microseconds>(update_now - m_last_main_update).count();
+		if (m_report_stats && (gap_us > 5500))
+		{
+			uint32_t queued = 0;
+			auto primary = m_streams.find(m_primary_output_id);
+			if (primary != m_streams.end())
+				queued = primary->second.m_buffer.available();
+			osd_printf_warning(
+				"PipeWire: late main audio update: gap_us=%lld, queued=%u, update=%llu\n",
+				(long long)gap_us,
+				queued,
+				(unsigned long long)m_main_update_count);
+		}
+		m_last_main_update = update_now;
+		m_main_update_count++;
+	}
+
+	while (m_realtime_pacing)
+	{
+		bool room = true;
+		for (const auto &[id, stream] : m_streams)
+		{
+			if (stream.m_is_output && (stream.m_buffer.available() > stream.m_prebuffer_frames))
+			{
+				room = false;
+				break;
+			}
+		}
+		if (room)
+			break;
+		pw_thread_loop_wait(m_loop);
+	}
 	pw_thread_loop_unlock(m_loop);
 }
 
