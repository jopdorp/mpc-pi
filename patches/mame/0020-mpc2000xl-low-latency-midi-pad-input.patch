+template<int ch> void mb89371_device::receive_byte(u8 data)
+{
+	if (!m_fast_rx_count[ch] && !m_sio[ch]->rxrdy_r())
+	{
+		m_sio[ch]->receive_byte(data);
+		return;
+	}
+
+	if (m_fast_rx_count[ch] == FAST_RX_QUEUE_SIZE)
+		return;
+	m_fast_rx_queue[ch][m_fast_rx_write[ch]] = data;
+	m_fast_rx_write[ch] = (m_fast_rx_write[ch] + 1) % FAST_RX_QUEUE_SIZE;
+	m_fast_rx_count[ch]++;
+}
+
+template void mb89371_device::receive_byte<0>(u8 data);
+template void mb89371_device::receive_byte<1>(u8 data);
+
+template<int ch> uint8_t mb89371_device::data_r()
+{
+	const u8 data = m_sio[ch]->data_r();
+	if (m_fast_rx_count[ch])
+	{
+		const u8 next = m_fast_rx_queue[ch][m_fast_rx_read[ch]];
+		m_fast_rx_read[ch] = (m_fast_rx_read[ch] + 1) % FAST_RX_QUEUE_SIZE;
+		m_fast_rx_count[ch]--;
+		m_sio[ch]->receive_byte(next);
+	}
+	return data;
+}
