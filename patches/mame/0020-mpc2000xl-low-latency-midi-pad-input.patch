+void mpc2000_state::enqueue_fast_pad_byte(uint8_t data)
+{
+	if (m_fast_pad_count == m_fast_pad_queue.size())
+	{
+		osd_printf_warning("MPC fast-pad input queue overflow; dropping byte %02x\n", data);
+		return;
+	}
+
+	const bool was_empty = !m_fast_pad_count;
+	m_fast_pad_queue[(m_fast_pad_head + m_fast_pad_count) % m_fast_pad_queue.size()] = data;
+	++m_fast_pad_count;
+	if (was_empty)
+	{
+		// The MIDI poll callback already runs on the emulation thread.  Deliver
+		// the first byte synchronously instead of taking a zero-delay scheduler
+		// round trip; subsequent bytes wait until firmware clears RX READY.
+		if (!m_maincpu->scu_rx_ready() && m_maincpu->scu_line_idle())
+		{
+			const uint8_t immediate = m_fast_pad_queue[m_fast_pad_head];
+			m_fast_pad_head = (m_fast_pad_head + 1) % m_fast_pad_queue.size();
+			--m_fast_pad_count;
+			m_maincpu->receive_scu_byte(immediate);
+		}
+		else
+		{
+			m_fast_pad_timer->adjust(attotime::from_usec(16));
+		}
+	}
+}
+
+TIMER_CALLBACK_MEMBER(mpc2000_state::fast_pad_byte_tick)
+{
+	if (!m_fast_pad_count)
+		return;
+
+	// Never overwrite a byte the MPC firmware has not consumed yet.  A short
+	// retry also lets authentic front-panel traffic share the V53 SCU safely.
+	if (m_maincpu->scu_rx_ready() || !m_maincpu->scu_line_idle())
+	{
+		m_fast_pad_timer->adjust(attotime::from_usec(4));
+		return;
+	}
+
+	const uint8_t data = m_fast_pad_queue[m_fast_pad_head];
+	m_fast_pad_head = (m_fast_pad_head + 1) % m_fast_pad_queue.size();
+	--m_fast_pad_count;
+	m_maincpu->receive_scu_byte(data);
+	if (m_fast_pad_count)
+		m_fast_pad_timer->adjust(attotime::from_usec(4));
+}
+
+void mpc2000_state::midi_input_byte(uint8_t data)
+{
+	if (!m_fast_pad_enabled)
+	{
+		m_sio->receive_byte<0>(data);
+		return;
+	}
+
+	// MIDI real-time bytes do not disturb running status.
+	if (data >= 0xf8)
+		return;
+	if (BIT(data, 7))
+	{
+		m_midi_status = data;
+		m_midi_data_pos = 0;
+		return;
+	}
+
+	const uint8_t kind = m_midi_status & 0xf0;
+	if (kind != 0x80 && kind != 0x90)
+		return;
+	if (!m_midi_data_pos)
+	{
+		m_midi_note = data;
+		m_midi_data_pos = 1;
+		return;
+	}
+
+	m_midi_data_pos = 0;
+	if (m_midi_note < 36 || m_midi_note >= 52)
+		return;
+
+	const uint8_t pad = m_midi_note - 36;
+	const uint8_t velocity = (kind == 0x90 && data) ? data : 0;
+	enqueue_fast_pad_byte(0x90 | pad);
+	enqueue_fast_pad_byte(velocity);
+}
