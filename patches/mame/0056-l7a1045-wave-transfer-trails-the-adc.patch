 TIMER_CALLBACK_MEMBER(l7a1045_sound_device::dma_timer_callback)
 {
+	// CHANNEL 3 TRAILS CHANNEL 2; IT MUST NOT RACE IT.
+	//
+	// The two record channels move the same words through the guest's
+	// 0x7F000 ring - channel 2 writes them in, channel 3 reads them out into
+	// wave RAM - and on the real machine both are paced by the one 44.1kHz
+	// audio clock, so channel 3 always reads behind channel 2's pen.
+	//
+	// Here they have the same average rate and nothing else in common. The
+	// ADC clock is the sound stream, which hands over a whole update block at
+	// a time: fifteen frames, thirty stereo words, once every 333us. Channel
+	// 2's DRQ is level and drains that block in a few microseconds, so the
+	// write pointer stands still and then leaps. Channel 3's timer is even.
+	// Same words per second, opposite shape - and measured on a real take the
+	// two crossed on every block: the phase of (channel 2 words in) minus
+	// (channel 3 words out) ran from +4 down to -25 and back, once per block,
+	// which is channel 3 spending most of every 333us copying ring slots the
+	// ADC had not reached yet. What it copied there was the previous lap of
+	// the ring, a whole buffer of audio out of date, and the take came out
+	// with a 3kHz buzz on it - the block rate - which is the crackle.
+	//
+	// So gate the tick on channel 2 being ahead. This is a floor and not a
+	// pace: while channel 2 leads, channel 3 keeps its own even rate and the
+	// wave-RAM write pointer advances smoothly, which is what the voice
+	// monitoring the take and the firmware's level meter both read. The gate
+	// only bites while the lead is being established, and it can never be
+	// crossed, whatever the lead is set to.
+	//
+	// One update block of lead is what makes the gate stop biting, because
+	// one update block is the whole of the sawtooth. It is measured, not
+	// chosen: record_capture() records the largest block the machine has
+	// handed over during this take.
+	if (m_rec_on)
+	{
+		const u32 channels = (m_rec_left && m_rec_right) ? 2 : 1;
+		const u64 lead = u64(std::max(m_rec_block, 1u)) * channels;
+		if (m_adc_words < m_wave_words + lead)
+		{
+			m_rec_held++;
+			return;
+		}
+	}
+
 	m_drq_handler(ASSERT_LINE);
 }
 
