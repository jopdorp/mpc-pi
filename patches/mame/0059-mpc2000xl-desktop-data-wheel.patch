+
+	// Give every key edge exactly one detent.  A held keyboard key
+	// then waits 300 ms and repeats at 10 detents/second.  PORT_KEYDELTA alone
+	// repeats on every 60 Hz tick, so it cannot provide both behaviours.
+	m_keyboard_dial_offset += BIT(pressed, 1) - BIT(pressed, 0);
+	if (digital_state != m_digital_dial_state)
