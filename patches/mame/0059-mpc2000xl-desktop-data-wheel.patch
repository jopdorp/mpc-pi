 TIMER_DEVICE_CALLBACK_MEMBER(mpc2000_state::dial_timer_tick)
 {
-	const int new_dial = m_dataentry->read();
+	const ioport_value dataentry = m_dataentry->read();
+	const int digital_state = (dataentry >> 8) & 3;
+	const int pressed = digital_state & ~m_digital_dial_state;
+
+	// Give every key edge exactly one detent.  A held keyboard key
+	// then waits 300 ms and repeats at 10 detents/second.  PORT_KEYDELTA alone
+	// repeats on every 60 Hz tick, so it cannot provide both behaviours.
+	m_keyboard_dial_offset += BIT(pressed, 1) - BIT(pressed, 0);
+
+	// A wheel notch rides its own dial field, so notch delivery keeps the
+	// dial-device mouse path and stays exactly one detent per notch at any
+	// drag sensitivity.
+	const ioport_value notch = m_dial_notch->read() & 0xff;
+	m_keyboard_dial_offset += int(int8_t(uint8_t(notch - m_notch_dial_last)));
+	m_notch_dial_last = uint8_t(notch);
+	if (digital_state != m_digital_dial_state)
+	{
+		m_digital_dial_state = digital_state;
+		m_keyboard_dial_ticks = 0;
+	}
+	else if ((digital_state == 1) || (digital_state == 2))
+	{
+		m_keyboard_dial_ticks++;
+		if ((m_keyboard_dial_ticks >= 18) && !((m_keyboard_dial_ticks - 18) % 6))
+			m_keyboard_dial_offset += BIT(digital_state, 1) - BIT(digital_state, 0);
+	}
+
+	// The low byte follows the mouse axis on every platform.  X11 only
+	// delivers relative motion while a button is held, but Wayland delivers
+	// it whenever the pointer moves, which turned the wheel on every pass
+	// across the window and left it feeling stuck after a drag.  Gate the
+	// axis on the artwork's drag bit, so the wheel follows only a deliberate
+	// drag on every platform.  The offset freezes while the button is up,
+	// so the transition adds and drops nothing.
+	const uint8_t axis = uint8_t(dataentry & 0xff);
+	if (m_dial_drag->read() & 1)
+		m_mouse_dial_offset = uint8_t(m_mouse_dial_offset + axis - m_mouse_dial_last);
+	m_mouse_dial_last = axis;
+
+	m_keyboard_dial_offset &= 0xff;
+	const int new_dial = (m_mouse_dial_offset + m_keyboard_dial_offset) & 0xff;
 
 	if (new_dial != m_last_dial)
 	{
