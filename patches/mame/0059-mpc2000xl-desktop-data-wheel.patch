+		m_keyboard_dial_ticks++;
+		if ((m_keyboard_dial_ticks >= 18) && !((m_keyboard_dial_ticks - 18) % 6))
+			m_keyboard_dial_offset += BIT(digital_state, 1) - BIT(digital_state, 0);
+	}
+
+	m_keyboard_dial_offset &= 0xff;
+	const int new_dial = ((dataentry & 0xff) + m_keyboard_dial_offset) & 0xff;
 
