+// TEMPORARY DIAGNOSTIC. Writes what the take actually captured and what
+// actually landed in wave RAM, so "garbage" can be measured instead of heard.
+void l7a1045_sound_device::dump_take()
+{
+	if (m_dump_prefix.empty())
+		return;
+
+	const int channels = (m_rec_left && m_rec_right) ? 2 : 1;
+	osd_printf_info("mpc2000xl sampler: DUMP ch=%d wave_words=%llu adc_words=%llu key=%08x captured=%u v0(start %08x end %08x pos %u step %04x) vR(start %08x end %08x pos %u step %04x)\n",
+			channels, (unsigned long long)m_wave_words, (unsigned long long)m_adc_words,
+			m_key, unsigned(m_dump_in.size()),
+			m_voice[0].start, m_voice[0].end, m_voice[0].pos, m_voice[0].step,
+			m_voice[REC_RIGHT_VOICE].start, m_voice[REC_RIGHT_VOICE].end,
+			m_voice[REC_RIGHT_VOICE].pos, m_voice[REC_RIGHT_VOICE].step);
+
+	std::string const in_path = m_dump_prefix + "-in.raw";
+	if (FILE *const f = std::fopen(in_path.c_str(), "wb"))
+	{
+		std::fwrite(m_dump_in.data(), 2, m_dump_in.size(), f);
+		std::fclose(f);
+	}
+
+	char const *const names[2] = { "-wave0.raw", "-waveR.raw" };
+	const int voices[2] = { 0, REC_RIGHT_VOICE };
+	for (int i = 0; i < channels; i++)
+	{
+		const l7a1045_voice &v = m_voice[voices[i]];
+		u64 words = (m_wave_words / channels) + 8192;
+		if (words > (4ull << 20))
+			words = 4ull << 20;
+		std::string const path = m_dump_prefix + names[i];
+		FILE *const f = std::fopen(path.c_str(), "wb");
+		if (!f)
+			continue;
+		for (u64 w = 0; w < words; w++)
+		{
+			const uint16_t sample = m_cache.read_word((v.start << 1) + (w << 1));
+			std::fwrite(&sample, 2, 1, f);
+		}
+		std::fclose(f);
+	}
+	m_dump_in.clear();
+}
