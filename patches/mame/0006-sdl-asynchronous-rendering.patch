+void renderer_sdl1::start_async_worker()
+{
+	m_async_thread = std::thread(&renderer_sdl1::async_worker_loop, this);
+}
+
+void renderer_sdl1::stop_async_worker()
+{
+	if (!m_async_thread.joinable())
+		return;
+	{
+		std::lock_guard<std::mutex> lock(m_async_mutex);
+		m_async_stop = true;
+		m_async_pending = false;
+	}
+	m_async_condition.notify_all();
+	m_async_thread.join();
+}
+
+void renderer_sdl1::wait_async_worker()
+{
+	std::unique_lock<std::mutex> lock(m_async_mutex);
+	m_async_condition.wait(lock, [this]() { return !m_async_pending && !m_async_busy; });
+	m_async_ready = false;
+}
+
+bool renderer_sdl1::ready_for_frame()
+{
+	if (!m_async_thread.joinable())
+		return true;
+	std::unique_lock<std::mutex> lock(m_async_mutex, std::try_to_lock);
+	return lock.owns_lock() && !m_async_pending && !m_async_busy;
+}
+
+void renderer_sdl1::render_async_primitives(
+		render_primitive_list &primlist,
+		uint8_t *const pixels,
+		int const width,
+		int const height,
+		int const pitch,
+		Uint32 const rmask,
+		float const fw,
+		float const fh)
+{
+	primlist.acquire_lock();
+	for (render_primitive &prim : primlist)
+	{
+		prim.bounds.x0 = std::floor(fw * prim.bounds.x0 + 0.5f);
+		prim.bounds.x1 = std::floor(fw * prim.bounds.x1 + 0.5f);
+		prim.bounds.y0 = std::floor(fh * prim.bounds.y0 + 0.5f);
+		prim.bounds.y1 = std::floor(fh * prim.bounds.y1 + 0.5f);
+	}
+
+	switch (rmask)
+	{
+		case 0xff000000:
+			software_renderer<uint32_t, 0,0,0, 24,16,8>::draw_primitives(primlist, pixels, width, height, pitch / 4);
+			break;
+
+		case 0x0000ff00:
+			software_renderer<uint32_t, 0,0,0, 8,16,24>::draw_primitives(primlist, pixels, width, height, pitch / 4);
+			break;
+
+		case 0x00ff0000:
+			software_renderer<uint32_t, 0,0,0, 16,8,0>::draw_primitives(primlist, pixels, width, height, pitch / 4);
+			break;
+
+		case 0x000000ff:
+			software_renderer<uint32_t, 0,0,0, 0,8,16>::draw_primitives(primlist, pixels, width, height, pitch / 4);
+			break;
+
+		case 0xf800:
+			software_renderer<uint16_t, 3,2,3, 11,5,0>::draw_primitives(primlist, pixels, width, height, pitch / 2);
+			break;
+
+		case 0x7c00:
+			software_renderer<uint16_t, 3,3,3, 10,5,0>::draw_primitives(primlist, pixels, width, height, pitch / 2);
+			break;
+
+		default:
+			osd_printf_error("SDL: ERROR! Unknown async video mode: R=%08X\n", rmask);
+			break;
+	}
+	primlist.release_lock();
+}
+
+void renderer_sdl1::async_worker_loop()
+{
+	// The emulator may use a real-time policy.  Rasterization must not inherit it
+	// and compete with the audio/emulation timeline.
+	sched_param parameters { };
+	pthread_setschedparam(pthread_self(), SCHED_OTHER, &parameters);
+
+	for (;;)
+	{
+		std::unique_lock<std::mutex> lock(m_async_mutex);
+		m_async_condition.wait(lock, [this]() { return m_async_stop || m_async_pending; });
+		if (m_async_stop)
+			break;
+
+		unsigned const buffer = m_async_write_buffer;
+		render_primitive_list *const primlist = m_async_primlist;
+		int const width = m_async_width;
+		int const height = m_async_height;
+		int const pitch = m_async_pitch;
+		Uint32 const rmask = m_async_rmask;
+		float const fw = m_async_fw;
+		float const fh = m_async_fh;
+		m_async_pending = false;
+		m_async_busy = true;
+		lock.unlock();
+
+		render_async_primitives(*primlist, m_async_pixels[buffer].data(), width, height, pitch, rmask, fw, fh);
+
+		lock.lock();
+		m_async_ready_buffer = buffer;
+		m_async_ready = true;
+		m_async_busy = false;
+		lock.unlock();
+		m_async_condition.notify_all();
+	}
+}
+
+int renderer_sdl1::draw_async()
+{
+	osd_dim const wdim = window().get_size();
+	if (has_flags(FI_CHANGED) || (wdim != m_last_dim))
+	{
+		wait_async_worker();
+		destroy_all_textures();
+		clear_flags(FI_CHANGED);
+		m_last_dim = wdim;
+		SDL_RenderSetViewport(m_sdl_renderer, nullptr);
+		setup_texture(m_blit_dim);
+		m_blittimer = 3;
+	}
+
+	Uint32 format, rmask, gmask, bmask, amask;
+	int access, width, height, bits_per_pixel;
+	SDL_QueryTexture(m_texture_id, &format, &access, &width, &height);
+	SDL_PixelFormatEnumToMasks(format, &bits_per_pixel, &rmask, &gmask, &bmask, &amask);
+	int const bytes_per_pixel = bits_per_pixel / 8;
+	int const mamewidth = width / m_scale_mode.mult_w;
+	int const mameheight = height / m_scale_mode.mult_h;
+	int const pitch = mamewidth * bytes_per_pixel;
+
+	int vofs = 0;
+	int hofs = 0;
+	int blitwidth = std::min(m_blit_dim.width(), wdim.width());
+	int blitheight = std::min(m_blit_dim.height(), wdim.height());
+	if ((m_blit_dim.width() <= wdim.width()) && video_config.centerh)
+		hofs = (wdim.width() - m_blit_dim.width()) / 2;
+	if ((m_blit_dim.height() <= wdim.height()) && video_config.centerv)
+		vofs = (wdim.height() - m_blit_dim.height()) / 2;
+	m_last_hofs = hofs;
+	m_last_vofs = vofs;
+
+	unsigned ready_buffer = 0;
+	bool have_ready = false;
+	{
+		std::lock_guard<std::mutex> lock(m_async_mutex);
+		if (m_async_ready)
+		{
+			ready_buffer = m_async_ready_buffer;
+			m_async_ready = false;
+			have_ready = true;
+		}
+	}
+
+	if (have_ready)
+	{
+		SDL_UpdateTexture(m_texture_id, nullptr, m_async_pixels[ready_buffer].data(), pitch);
+		if (m_blittimer > 0)
+		{
+			SDL_SetRenderDrawColor(m_sdl_renderer, 0, 0, 0, 0);
+			SDL_RenderFillRect(m_sdl_renderer, nullptr);
+			--m_blittimer;
+		}
+		SDL_Rect const destination { hofs, vofs, blitwidth, blitheight };
+		SDL_RenderCopy(m_sdl_renderer, m_texture_id, nullptr, &destination);
+		SDL_RenderPresent(m_sdl_renderer);
+		if (m_async_first_present)
+		{
+			m_async_first_present = false;
+			osd_printf_warning("SDL soft: asynchronous rasterizer first frame presented on main thread\n");
+		}
+	}
+
+	{
+		std::lock_guard<std::mutex> lock(m_async_mutex);
+		if (!m_async_pending && !m_async_busy && !m_async_ready)
+		{
+			m_async_write_buffer ^= 1;
+			auto &pixels = m_async_pixels[m_async_write_buffer];
+			pixels.resize(std::size_t(pitch) * mameheight);
+			m_async_primlist = window().m_primlist;
+			m_async_width = mamewidth;
+			m_async_height = mameheight;
+			m_async_pitch = pitch;
+			m_async_rmask = rmask;
+			m_async_fw = float(mamewidth) / float(blitwidth);
+			m_async_fh = float(mameheight) / float(blitheight);
+			m_async_pending = true;
+		}
+	}
+	m_async_condition.notify_one();
+	return 0;
+}
