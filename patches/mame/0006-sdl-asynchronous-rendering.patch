+void sdl_window_info::start_async_present()
+{
+	if (!m_async_present_requested || !renderer_sdl_needs_opengl())
+		return;
+
+	// The renderer creates and initializes its GL context on this thread.  Release
+	// it before the presenter thread makes it current for all subsequent draws.
+	if (SDL_GL_MakeCurrent(nullptr, nullptr) < 0)
+		osd_printf_error("OpenGL: failed to release context for async presentation: %s\n", SDL_GetError());
+	{
+		std::lock_guard<std::mutex> lock(m_present_mutex);
+		m_present_stop = false;
+		m_present_pending = false;
+		m_present_busy = false;
+		m_async_present_active = true;
+	}
+	m_present_thread = std::thread(&sdl_window_info::async_present_loop, this);
+}
+
+void sdl_window_info::stop_async_present()
+{
+	if (!m_present_thread.joinable())
+		return;
+	{
+		std::lock_guard<std::mutex> lock(m_present_mutex);
+		m_present_stop = true;
+		m_present_pending = false;
+	}
+	m_present_condition.notify_one();
+	m_present_thread.join();
+	std::lock_guard<std::mutex> lock(m_present_mutex);
+	m_async_present_active = false;
+	m_present_stop = false;
+	m_present_busy = false;
+}
