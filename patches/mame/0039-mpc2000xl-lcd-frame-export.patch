From: mpc-pi
Subject: [PATCH] mpc2000xl: export changed LCD frames to a shared file

MAME_MPC_LCD_EXPORT=<path> writes the 248x60 monochrome LCD frame to <path>
whenever screen_update commits a changed frame, using the 0033 dirty-frame
detector as the trigger: a 16-byte header (magic 'MPCL', u32 sequence, u16
width, u16 height, u32 reserved) plus one byte per pixel. Purely host-side;
no emulated state is touched, so guest timing and PCM are unchanged by
construction (verified: frozen PCM exact with the export active).

Consumed by scripts/maschine/mpc-mk1-display.py, which packs frames into the
Maschine MK1's 5-bpp display format and pushes them over USB bulk endpoint
0x08 (see docs/maschine-mk1-display-protocol.md). Verified end to end with
the daemon's ASCII/PNG preview modes: exported frames carry the live
emulated screen at the changed-frame cadence.

diff --git a/src/mame/akai/mpc2000.cpp b/src/mame/akai/mpc2000.cpp
--- a/src/mame/akai/mpc2000.cpp
+++ b/src/mame/akai/mpc2000.cpp
@@ -201,6 +201,8 @@
 	uint16_t m_vram[256*64];
 	bool m_lcd_skip_unchanged;
 	bool m_lcd_dirty;
+	FILE *m_lcd_export_file = nullptr;
+	uint32_t m_lcd_export_seq = 0;
 	emu_timer *m_panel_txd_timer;
 	emu_timer *m_fast_pad_timer;
 	bool m_fast_pad_enabled;
@@ -216,6 +218,8 @@
 	m_fast_pad_enabled = bool(osd_getenv("MAME_MPC_MIDI_INTERNAL_PADS"));
 	char const *const lcd_skip_unchanged = osd_getenv("MAME_MPC_LCD_SKIP_UNCHANGED");
 	m_lcd_skip_unchanged = lcd_skip_unchanged && std::strcmp(lcd_skip_unchanged, "0");
+	if (char const *const lcd_export = osd_getenv("MAME_MPC_LCD_EXPORT"))
+		m_lcd_export_file = fopen(lcd_export, "wb");
 	save_item(NAME(m_key_scan_row));
 	save_item(NAME(m_drum_scan_row));
 	save_item(NAME(m_midi_status));
@@ -344,6 +348,27 @@
 u32 mpc2000_state::screen_update(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect)
 {
 	bool const changed = !m_lcd_skip_unchanged || m_lcd_dirty;
+	if (changed && m_lcd_export_file)
+	{
+		// 16-byte header + one byte per pixel; rewritten in place so the
+		// consumer sees a consistent snapshot keyed by the sequence number.
+		uint8_t frame[16 + 248 * 60];
+		frame[0] = 'M'; frame[1] = 'P'; frame[2] = 'C'; frame[3] = 'L';
+		m_lcd_export_seq++;
+		frame[4] = uint8_t(m_lcd_export_seq);
+		frame[5] = uint8_t(m_lcd_export_seq >> 8);
+		frame[6] = uint8_t(m_lcd_export_seq >> 16);
+		frame[7] = uint8_t(m_lcd_export_seq >> 24);
+		frame[8] = 248; frame[9] = 0;
+		frame[10] = 60; frame[11] = 0;
+		frame[12] = frame[13] = frame[14] = frame[15] = 0;
+		for (int y = 0; y < 60; y++)
+			for (int x = 0; x < 248; x++)
+				frame[16 + y * 248 + x] = m_vram[(y * 256) + x] ? 1 : 0;
+		fseek(m_lcd_export_file, 0, SEEK_SET);
+		fwrite(frame, 1, sizeof(frame), m_lcd_export_file);
+		fflush(m_lcd_export_file);
+	}
 	for (int y = 0; y < 60; y++)
 	{
 		uint16_t *scanline = &bitmap.pix(y);
