+bool nec_common_device::mpc2000xl_brk77_hle(bool saved_tf)
+{
+	static constexpr u32 tick_address = (0x0fe7U << 4) + 0x0b8a;
+
+	if (!m_mpc2000xl_brk77_hle_enabled || !m_mpc2000xl_rom_valid ||
+		(m_chip_type != V33_TYPE) || (Sreg(PS) != 0x0000) || (m_ip != 0x169b) ||
+		m_rep_params || m_seg_prefix || m_no_interrupt || m_halted ||
+		(m_pending_irq & NMI_IRQ) ||
+		(machine().debug_flags & (DEBUG_FLAG_ENABLED | DEBUG_FLAG_CALL_HOOK)) || saved_tf)
+		return false;
+	if (m_icount < (24 + 41))
+		return false;
+
+	const offs_t address_mask = m_program->addrmask();
+	const offs_t handler_start = v33_translate(0x169b) & address_mask;
+	if (handler_start > (address_mask - 0x0a))
+		return false;
+	const offs_t handler_end = handler_start + 0x0a;
+	const offs_t stack_start = v33_translate(
+		(u32(Sreg(SS)) << 4) + u16(Wreg(SP) - 2)) & address_mask;
+	const offs_t stack_end = v33_translate(
+		(u32(Sreg(SS)) << 4) + u16(Wreg(SP) - 1)) & address_mask;
+	if (((stack_start >= handler_start) && (stack_start <= handler_end)) ||
+		((stack_end >= handler_start) && (stack_end <= handler_end)))
+		return false;
+
+	if (m_mpc2000xl_brk77_handler_valid &&
+		(handler_start != m_mpc2000xl_brk77_cached_handler_start))
+		invalidate_mpc2000xl_brk77_handler();
+
+	if (!m_mpc2000xl_brk77_handler_valid && !validate_mpc2000xl_brk77_handler(handler_start))
+		return false;
+
+	// Preserve every architecturally visible side effect of 0000:169b-16a5.
+	// The firmware handler deliberately leaves BP loaded with its data
+	// segment and returns the tick counter in AW.
+	PUSH(Sreg(DS0));
+	Wreg(BP) = 0x0fe7;
+	Sreg(DS0) = 0x0fe7;
+	Wreg(AW) = read_mem_word(tick_address);
+
+	POP(Sreg(DS0));
+	POP(m_ip);
+	POP(Sreg(PS));
+	i_popf();
+	CHANGE_PC;
+
+	// Empirically measured 41 cycles (V53_ISR23_MEASURE), exclusive of the
+	// calling INT's 24-cycle charge and equal to the plain table sum.
+	// i_popf() charged five.
+	CLK(41 - 5);
+	m_prev_ip = 0x16a5;
+	m_no_interrupt = 0;
+	m_prefetch_count = 0;
+	m_prefetch_reset = 1;
+	return true;
+}
