+bool nec_common_device::validate_mpc2000xl_brk92_handler(offs_t handler_start)
+{
+	static constexpr u8 expected_handler[] =
+	{
+		0x1e, 0x55, 0xbd, 0xe7, 0x0f, 0x8e, 0xdd, 0x3c,
+		0x00, 0x75, 0x05, 0xc6, 0x06, 0xaf, 0x11, 0x00,
+		0xa0, 0xaf, 0x11, 0x5d, 0x1f, 0xcf
+	};
+
+	for (unsigned index = 0; index < std::size(expected_handler); ++index)
+		if (read_mem_byte(0x0fe3 + index) != expected_handler[index])
+			return false;
+
+	m_mpc2000xl_brk92_cached_handler_start = handler_start;
+	m_mpc2000xl_brk92_handler_valid = true;
+	install_mpc2000xl_brk92_write_tap(handler_start);
+	if (!m_mpc2000xl_brk92_reported)
+	{
+		osd_printf_info("%s: MPC2000XL BRK 92 feed-flag service HLE active\n", tag());
+		m_mpc2000xl_brk92_reported = true;
+	}
+	return true;
+}
+
+void nec_common_device::install_mpc2000xl_brk92_write_tap(offs_t handler_start)
+{
+	// The handler starts on an odd address; the tap must be bus-aligned, so
+	// widen to word bounds. A boundary-byte write only forces revalidation.
+	m_mpc2000xl_brk92_handler_tap.remove();
+	m_mpc2000xl_brk92_handler_tap = m_program->install_write_tap(
+		handler_start & ~offs_t(1), (handler_start + 0x15) | 1,
+		"mpc2000xl_brk92_handler",
+		[this](offs_t, u16 &, u16) { invalidate_mpc2000xl_brk92_handler(); },
+		&m_mpc2000xl_brk92_handler_tap);
+}
+
+void nec_common_device::invalidate_mpc2000xl_brk92_handler()
+{
+	m_mpc2000xl_brk92_handler_valid = false;
+}
+
+bool nec_common_device::mpc2000xl_brk92_hle(bool saved_tf)
+{
+	static constexpr u32 flag_address = (0x0fe7U << 4) + 0x11af;
+
+	if (!m_mpc2000xl_brk92_hle_enabled || !m_mpc2000xl_rom_valid ||
+		(m_chip_type != V33_TYPE) || (Sreg(PS) != 0x0000) || (m_ip != 0x0fe3) ||
+		m_rep_params || m_seg_prefix || m_no_interrupt || m_halted ||
+		(m_pending_irq & NMI_IRQ) ||
+		(machine().debug_flags & (DEBUG_FLAG_ENABLED | DEBUG_FLAG_CALL_HOOK)) || saved_tf)
+		return false;
+	if (m_icount < (24 + 65))
+		return false;
+
+	const offs_t address_mask = m_program->addrmask();
+	const offs_t handler_start = v33_translate(0x0fe3) & address_mask;
+	if (handler_start > (address_mask - 0x15))
+		return false;
+	const offs_t handler_end = handler_start + 0x15;
+	const offs_t stack_start = v33_translate(
+		(u32(Sreg(SS)) << 4) + u16(Wreg(SP) - 4)) & address_mask;
+	const offs_t stack_end = v33_translate(
+		(u32(Sreg(SS)) << 4) + u16(Wreg(SP) - 1)) & address_mask;
+	const offs_t flag_start = v33_translate(flag_address) & address_mask;
+	if (((stack_start >= handler_start) && (stack_start <= handler_end)) ||
+		((stack_end >= handler_start) && (stack_end <= handler_end)) ||
+		((flag_start >= handler_start) && (flag_start <= handler_end)))
+		return false;
+
+	if (m_mpc2000xl_brk92_handler_valid &&
+		(handler_start != m_mpc2000xl_brk92_cached_handler_start))
+		invalidate_mpc2000xl_brk92_handler();
+
+	if (!m_mpc2000xl_brk92_handler_valid && !validate_mpc2000xl_brk92_handler(handler_start))
+		return false;
+
+	// Preserve every architecturally visible side effect of 0000:0fe3-0ff8:
+	// the transient saved-DS/BP stack writes, the conditional flag clear
+	// when called with AL=0, and the flag readback into AL.
+	PUSH(Sreg(DS0));
+	PUSH(Wreg(BP));
+	Wreg(BP) = 0x0fe7;
+	Sreg(DS0) = 0x0fe7;
+	const bool consume = (Breg(AL) == 0);
+	if (consume)
+		write_mem_byte(flag_address, 0);
+	Breg(AL) = read_mem_byte(flag_address);
+
+	POP(Wreg(BP));
+	POP(Sreg(DS0));
+	POP(m_ip);
+	POP(Sreg(PS));
+	i_popf();
+	CHANGE_PC;
+
+	// Empirically measured on the interpreter (V53_ISR23_MEASURE): 65
+	// cycles on the clearing path, 54 on the peek path, both exclusive of
+	// the calling INT's 24-cycle charge and equal to the plain table sums
+	// (this handler has no prefetch stalls). i_popf() charged five.
+	const int handler_cycles = consume ? 65 : 54;
+	CLK(handler_cycles - 5);
+	m_prev_ip = 0x0ff8;
+	m_no_interrupt = 0;
+	m_prefetch_count = 0;
+	m_prefetch_reset = 1;
+	return true;
+}
