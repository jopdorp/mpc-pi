+void l7a1045_sound_device::record_capture(sound_stream &stream)
+{
+	for (int j = 0; j < stream.samples(); j++)
+	{
+		for (int ch = 0; ch < 2; ch++)
+		{
+			if (ch == 0 ? !m_rec_left : !m_rec_right)
+				continue;
+
+			int32_t q = int32_t(stream.get(ch, j) * 32767.0f);
+			if (q > 32767) q = 32767;
+			if (q < -32768) q = -32768;
+
+			m_rec_ring[m_rec_wr & (REC_RING - 1)] = int16_t(q);
+			m_rec_wr++;
+			// Overrun drops the OLDEST. A sampler that keeps stale audio
+			// and discards what is being played into it now is worse than
+			// one that glitches.
+			if (m_rec_wr - m_rec_rd > REC_RING)
+				m_rec_rd = m_rec_wr - REC_RING;
+
+			if (m_rec_debug)
+			{
+				const u32 mag = u32(q < 0 ? -q : q);
+				if (mag > m_rec_peak)
+					m_rec_peak = mag;
+			}
+		}
+	}
+
+	update_adc_drq();
+
+	if (m_rec_debug && m_rec_wr >= m_rec_report_at)
+	{
+		// Once a second of captured audio, not once a block: this exists to
+		// answer a yes/no question, not to flood the journal.
+		m_rec_report_at = m_rec_wr + u32(m_sample_rate);
+		// adc_words is DMA channel 2, the ADC filling the guest's ring;
+		// wave_words is channel 3, the same block going on into wave RAM and
+		// advancing the position the firmware times the take by. Both should
+		// climb at the capture rate. wave_words racing ahead is the signature
+		// of the instant-finish bug that arm_dma_timer() exists to prevent.
+		//
+		// ctl carries the arming word so a stereo take (0x58) can be told from
+		// a mono one (0x40) in the same line, and both voice positions are
+		// printed because in stereo they must climb together at HALF the word
+		// rate - that split is the whole of the take-length fix.
+		osd_printf_info("mpc2000xl sampler: rec=%d L=%d R=%d in_peak=%u ring_depth=%u adc_words=%llu wave_words=%llu ctl=%04x pos0=%u posR=%u\n",
