+
+// DMA channel 2: one ADC word per cycle, straight into the guest's 0x7F000
+// ring.
+//
+// AN EMPTY RING WITHHOLDS DATA; IT DOES NOT FABRICATE SILENCE. The two failure
+// modes here pull in opposite directions and the choice matters:
+//
+//   * hand over a zero whenever the ring is empty and the transfer runs to
+//     completion at bus speed on audio that never arrived - which is how a
+//     recording finishes before it starts;
+//   * never complete the transfer and the guest hangs waiting for it.
+//
+// Level-triggered DRQ resolves both without choosing between them. update_adc_drq()
+// drops the request the moment the ring drains, so the DMAC simply stops
+// asking until record_capture() puts more audio in, and it never has to be
+// told a lie. The transfer then advances at exactly the rate audio arrives.
+//
+// The held last value below is therefore unreachable in normal operation. It
+// is kept for the case where the DMAC reads anyway - a flat spot rather than
+// a click, and never a zero that could be mistaken for real silence.
+uint16_t l7a1045_sound_device::adc_dma_r16_cb()
+{
+	if (m_rec_rd != m_rec_wr)
+		m_rec_last = m_rec_ring[m_rec_rd++ & (REC_RING - 1)];
+
+	m_adc_words++;
+	update_adc_drq();
+	return uint16_t(m_rec_last);
+}
