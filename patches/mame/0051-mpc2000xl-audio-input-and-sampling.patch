+void l7a1045_sound_device::set_record_enable(bool on, bool left, bool right)
+{
+	if (on == m_rec_on && left == m_rec_left && right == m_rec_right)
+		return;
+	m_stream->update();   // do not retroactively capture this block
+	if (on && !m_rec_on)
+		m_rec_rd = m_rec_wr = 0;   // a fresh take, not the tail of the last
+	m_rec_on = on;
+	m_rec_left = left;
+	m_rec_right = right;
+}
