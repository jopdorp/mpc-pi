+			int n = 0;
+			if (m_rec_left)  { v += stream.get(0, j); n++; }
+			if (m_rec_right) { v += stream.get(1, j); n++; }
+			if (n == 2) v *= 0.5f;   // sum without letting two hot channels clip
+
+			int32_t q = int32_t(v * 32767.0f);
+			if (q > 32767) q = 32767;
+			if (q < -32768) q = -32768;
