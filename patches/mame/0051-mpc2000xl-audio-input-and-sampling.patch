+
+	// WADCSN NOW DRIVES THE SAMPLER. It was a read-back stub: writes were
+	// stored and nothing happened, so the SAMPLE screen ran and recorded
+	// nothing. Bits 7/6 enable right/left input, bit 3 disables analog.
+	// Decoded by BIT, not by value: the v1.20 ROM computes its start value
+	// at runtime and contains no constant start byte (see
+	// docs/mpc2000xl-sampling-protocol.md). The stop constants it does
+	// write, 0x1A/0x1B, both have 7 and 6 clear - so "a channel is
+	// enabled" is already the firmware's own way of saying "recording".
+	const bool left  = BIT(data, 6);
+	const bool right = BIT(data, 7);
+	const bool analog_ok = !BIT(data, 3);
+	m_dsp->set_record_enable((left || right) && analog_ok, left, right);
 }
 
