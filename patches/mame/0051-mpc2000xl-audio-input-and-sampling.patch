+	// at runtime (docs/mpc2000xl-sampling-protocol.md) rather than writing
+	// a constant, which is why no fixed "start" byte appears anywhere in
+	// the ROM and why this is decoded by bit rather than by value.
+	const bool left  = BIT(data, 6);
+	const bool right = BIT(data, 7);
+	const bool analog_ok = !BIT(data, 3);
