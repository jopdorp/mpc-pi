+void l7a1045_sound_device::set_record_enable(bool on, bool left, bool right)
+{
+	if (on == m_rec_on && left == m_rec_left && right == m_rec_right)
+		return;
+
+	// Resync the stream before changing state so audio already generated
+	// for this block is not retroactively captured (or missed).
+	m_stream->update();
+
+	if (on && !m_rec_on)
+	{
+		// Fresh start: drop whatever was left from a previous take rather
+		// than prepending it to this one.
+		m_rec_rd = m_rec_wr = 0;
+	}
+	m_rec_on = on;
+	m_rec_left = left;
+	m_rec_right = right;
+}
