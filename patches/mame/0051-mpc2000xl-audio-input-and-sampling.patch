+		// answer a yes/no question, not to flood the journal.
+		m_rec_report_at = m_rec_wr + u32(m_sample_rate);
+		// adc_words is DMA channel 2, the ADC filling the guest's ring;
+		// wave_words is channel 3, the same block going on into wave RAM and
+		// advancing the position the firmware times the take by. Both should
+		// climb at the capture rate. wave_words racing ahead is the signature
+		// of the instant-finish bug that arm_dma_timer() exists to prevent.
+		osd_printf_info("mpc2000xl sampler: rec=%d L=%d R=%d in_peak=%u ring_depth=%u adc_words=%llu wave_words=%llu pos=%u\n",
