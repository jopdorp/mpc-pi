diff --git a/src/devices/machine/i8251.cpp b/src/devices/machine/i8251.cpp
--- a/src/devices/machine/i8251.cpp
+++ b/src/devices/machine/i8251.cpp
@@ -99,6 +99,7 @@ void i8251_device::device_start()
 	m_command = 0;
 	m_mode_byte = 0;
 	m_delayed_tx_en = false;
+	m_break_release_pending = false;
 
 	m_rxc_count = 0;
 	m_txc_count = 0;
@@ -124,6 +125,7 @@ void i8251_device::device_start()
 	save_item(NAME(m_command));
 	save_item(NAME(m_mode_byte));
 	save_item(NAME(m_delayed_tx_en));
+	save_item(NAME(m_break_release_pending));
 
 	save_item(NAME(m_cts));
 	save_item(NAME(m_dsr));
@@ -396,6 +398,16 @@ void i8251_device::transmit_clock()
 
 	m_txc_count = 0;
 
+	// With no buffered or shifting character, an asynchronous transmitter only
+	// repeats its already-visible output and status levels at each character
+	// boundary.  Keep the BRG deadline but skip those literal no-op callbacks.
+	if (!m_sync_byte_count &&
+		is_transmit_register_empty() &&
+		((m_status & (I8251_STATUS_TX_READY | I8251_STATUS_TX_EMPTY)) ==
+			(I8251_STATUS_TX_READY | I8251_STATUS_TX_EMPTY)) &&
+		!m_break_release_pending)
+		return;
+
 	if (is_transmit_register_empty())
 	{
 		if ((m_status & I8251_STATUS_TX_READY) == 0 && (is_tx_enabled() || m_delayed_tx_en))
@@ -418,6 +430,7 @@ void i8251_device::transmit_clock()
 			{
 				// return TxD to marking state (high) if not sending break character
 				m_txd_handler(!BIT(m_command, 3));
+				m_break_release_pending = false;
 			}
 		}
 
@@ -524,6 +537,7 @@ void i8251_device::device_reset()
 	LOGSTAT("status is reset to %02x\n", m_status);
 	m_mode_byte = 0;
 	m_command = 0;
+	m_break_release_pending = false;
 	m_rx_data = 0;
 	m_tx_data = 0;
 	m_rxc_count = m_txc_count = 0;
@@ -546,6 +560,11 @@ void i8251_device::command_w(uint8_t data)
 {
 	/* command */
+	const bool was_break = BIT(m_command, 3);
 	m_command = data;
+	if (BIT(data, 3))
+		m_break_release_pending = false;
+	else if (was_break)
+		m_break_release_pending = true;
 
 	LOG("I8251: Command byte: %02x\n", data);
 	LOGCOM(" Tx enable: %d\n", data & 0x01 ? 1 : 0); // bit 0: 0 = transmit disable 1 = transmit enable
diff --git a/src/devices/machine/i8251.h b/src/devices/machine/i8251.h
--- a/src/devices/machine/i8251.h
+++ b/src/devices/machine/i8251.h
@@ -115,6 +115,7 @@ private:
 	uint8_t m_command;
 	uint8_t m_mode_byte;       // mode byte - bit definitions depend on mode - e.g. synchronous, asynchronous
 	bool m_delayed_tx_en;
+	bool m_break_release_pending;
 
 	int32_t m_cts;
 	int32_t m_dsr;
