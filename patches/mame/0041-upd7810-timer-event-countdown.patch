+int32_t upd7810_device::timer_next_horizon()
+{
+	int32_t horizon = INT32_MAX;
+
+	// Timer 0: CNT0 advances once per clkdiv cycles and raises INTFT0 (and
+	// possibly a TO transition) on reaching TM0. External-TI and disabled
+	// sources are not advanced from here at all.
+	if (!(TMM & 0x10))
+	{
+		const int clkdiv = ((TMM & 0x0c) == 0x00) ? 4 : (((TMM & 0x0c) == 0x04) ? 128 : 0);
+		if (clkdiv)
+		{
+			int steps = (int(TM0) - int(CNT0)) & 0xff;
+			if (steps == 0)
+				steps = 256;
+			horizon = std::min<int32_t>(horizon, steps * clkdiv - OVC0);
+		}
+	}
+
+	// Timer 1. In chained mode it is advanced by timer 0, whose own match is
+	// already a horizon, so only the independent clock sources are bounded.
+	if (!(TMM & 0x80))
+	{
+		const int clkdiv = ((TMM & 0x60) == 0x00) ? 4 : (((TMM & 0x60) == 0x20) ? 128 : 0);
+		if (clkdiv)
+		{
+			int steps = (int(TM1) - int(CNT1)) & 0xff;
+			if (steps == 0)
+				steps = 256;
+			horizon = std::min<int32_t>(horizon, steps * clkdiv - OVC1);
+		}
+	}
+
+	// ETIMER: ECNT advances every four cycles. ETM0/ETM1 matches raise
+	// INTFE0/INTFE1 and can change CO0/CO1; a wrap sets the overflow flag.
+	if (0x00 != (ETMM & 0x0c))
+	{
+		// Only the free-running internal clock is bounded here; the CI-gated
+		// and edge-sourced modes depend on an input line that can change
+		// asynchronously inside a window.
+		if (0x00 != (ETMM & 0x03))
+			return 0;
+
+		const uint32_t targets[3] = { uint32_t(ETM0), uint32_t(ETM1), 0 };
+		uint32_t steps = 0x10000;
+		for (uint32_t target : targets)
+		{
+			uint32_t distance = (target - uint32_t(ECNT)) & 0xffff;
+			if (distance == 0)
+				distance = 0x10000;
+			if (distance < steps)
+				steps = distance;
+		}
+		horizon = std::min<int32_t>(horizon, int32_t(steps) * 4 - OVCE);
+	}
+
+	// Timer F/F. Fixed-clock transitions are only unobservable when the
+	// MPC panel coalescing conditions hold; otherwise TO changes every cycle.
+	bool sio_advances = ((SMH & 0x03) == 0x01) || ((SMH & 0x03) == 0x02);
+	if (0x02 == (TMM & 0x03))
+	{
+		if (!(m_coalesce_unconnected_to_output && !(SMH & 0x03) && !(m_mcc & 0x10)))
+			return 0;
+		sio_advances = true;
+	}
+
+	// SIO: an edge can shift a bit out, sample RXD or start a transfer, so
+	// the next half-interval edge always bounds the window.
+	if (sio_advances)
+	{
+		static const int divider[] = { 2, 384 / 3, 24 / 3, 2 };
+		static const int prescale[] = { 1, 1, 16, 64 };
+		const int interval = divider[SMH & 0x03] * prescale[SML & 0x03];
+		horizon = std::min<int32_t>(horizon, (interval / 2) - OVCS);
+	}
+
+	// ADC. The analog sample is taken on the first call after a conversion
+	// completes, so that boundary is kept exact, as is the completion itself
+	// (it writes CR and can raise INTFAD) and any converter reconfiguration.
+	if ((m_shdone == 0) || (PANM != ANM))
+		return 0;
+	horizon = std::min<int32_t>(horizon, m_adtot - m_adcnt + 1);
+
+	return (horizon > 0) ? horizon : 0;
+}
