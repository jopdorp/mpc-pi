 void upd7810_device::handle_timers(int cycles)
 {
+	if (!UNEXPECTED(m_mpc_timer_fast))
+	{
+		handle_timers_core(cycles);
+		return;
+	}
+
+	// Between observable events the walk below cannot change anything the
+	// CPU or the outside world can see, so the cycles are only accumulated.
+	// They are replayed in one chunk at the first instruction boundary that
+	// reaches the horizon - the same boundary at which the unbatched walk
+	// would first have observed the event - which leaves every counter,
+	// IRR bit, output transition and ADC sample on its exact cycle.
+	m_timer_pending += cycles;
+	if (m_timer_pending < m_timer_horizon)
+	{
+		m_timer_fast_hits++;
+		return;
+	}
+
+	const int32_t pending = m_timer_pending;
+	m_timer_pending = 0;
+	handle_timers_core(pending);
+	m_timer_materializes++;
+	m_timer_horizon = timer_next_horizon();
+}
+
+void upd7810_device::timer_materialize()
+{
+	if (m_timer_pending > 0)
+	{
+		const int32_t pending = m_timer_pending;
+		m_timer_pending = 0;
+		handle_timers_core(pending);
+		m_timer_materializes++;
+	}
+	m_timer_horizon = timer_next_horizon();
+}
