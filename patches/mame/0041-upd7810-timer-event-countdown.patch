+void upd7810_device::mpc_idle_stats_head_visit()
+{
+	const uint64_t now = total_cycles();
+	const uint16_t regs[12] =
+	{
+		uint16_t(m_psw), m_ea.w.l, m_va.w.l, m_bc.w.l, m_de.w.l, m_hl.w.l,
+		m_ea2.w.l, m_va2.w.l, m_bc2.w.l, m_de2.w.l, m_hl2.w.l, m_sp.w.l
+	};
+
+	m_mpc_stats_head_visits++;
+	if (m_mpc_stats_have_prev)
+	{
+		const uint32_t delta = uint32_t(now - m_mpc_stats_head_prev_cycles);
+		int slot = 0;
+		while ((slot < m_mpc_stats_delta_n) && (m_mpc_stats_delta_val[slot] != delta))
+			slot++;
+		if (slot == m_mpc_stats_delta_n && m_mpc_stats_delta_n < 16)
+			m_mpc_stats_delta_val[m_mpc_stats_delta_n++] = delta;
+		if (slot < 16)
+			m_mpc_stats_delta_cnt[slot]++;
+
+		if (0 == memcmp(regs, m_mpc_stats_regs, sizeof(regs)))
+			m_mpc_stats_reg_fixed++;
+		else
+			m_mpc_stats_reg_changed++;
+	}
+	memcpy(m_mpc_stats_regs, regs, sizeof(regs));
+	m_mpc_stats_head_prev_cycles = now;
+	m_mpc_stats_have_prev = true;
+}
