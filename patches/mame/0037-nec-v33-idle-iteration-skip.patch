+	bool m_idle_skip_enabled = false;
+	bool m_idle_recording = false;
+	u32 m_idle_heads[IDLE_HEAD_COUNT] = { 0, 0, 0 };
+	// One byte-wide I/O status port may join the recorded read set: reads of
+	// it must be side-effect-free, and its value cannot change inside the
+	// V33's own timeslice because the producing device only advances in its
+	// own slices - the same argument that makes memory verification exact.
+	u16 m_idle_status_port = 0;
+	static constexpr int IDLE_MAX_IO_READS = 8;
+	struct idle_io_read { u16 port; u8 value; };
+	idle_io_read m_idle_io_reads[IDLE_MAX_IO_READS];
+	int m_idle_io_read_count = 0;
+	int m_idle_active_head = -1;
+	idle_phase m_idle_phase = idle_phase::RECORD_PENDING;
+	bool m_idle_viable = true;
+	int m_idle_read_count = 0;
+	int m_idle_write_count = 0;
+	std::unique_ptr<idle_access[]> m_idle_reads;
+	std::unique_ptr<idle_access[]> m_idle_writes;
+	std::unique_ptr<u16[]> m_idle_write_old;
+	std::unique_ptr<idle_probe[]> m_idle_probes;
+	int m_idle_probe_count = 0;
+	bool m_idle_probes_valid = false;
+	idle_snapshot m_idle_snapshot;
+	s32 m_idle_slice_start = 0;
+	u32 m_idle_cycles_accum = 0;
+	u32 m_idle_iter_cycles = 0;
+	u64 m_idle_skipped = 0, m_idle_verify_fail = 0, m_idle_record_attempts = 0;
+	u64 m_idle_fail_io = 0, m_idle_fail_cycles = 0, m_idle_fail_snapshot = 0, m_idle_fail_netzero = 0;
+	u32 m_idle_netzero_dumps = 0;
+	void idle_capture_snapshot(idle_snapshot &into);
+	bool idle_snapshot_matches(const idle_snapshot &against);
+	void idle_begin_recording();
+	void idle_abort_recording();
+	void idle_close_recording();
+	void idle_head_event();
+	bool idle_address_written(offs_t addr, int size) const
+	{
+		for (int i = 0; i < m_idle_write_count; i++)
+		{
+			const idle_access &w = m_idle_writes[i];
+			if ((addr < w.addr + w.size) && (w.addr < addr + size))
+				return true;
+		}
+		return false;
+	}
+	void idle_note_read(offs_t addr, u16 value, u8 size)
+	{
+		if (!m_idle_viable)
+			return;
+		if (idle_address_written(addr, size))
+			return;
+		if (m_idle_read_count >= IDLE_MAX_READS)
+		{
+			m_idle_viable = false;
+			return;
+		}
+		m_idle_reads[m_idle_read_count++] = idle_access{ addr, value, size };
+	}
+	void idle_note_write(offs_t addr, u16 old_value, u8 size)
+	{
+		if (!m_idle_viable)
+			return;
+		// Net-zero is judged against the value before the iteration's FIRST
+		// write to an address, so an exact repeat (same slot re-pushed by
+		// every call in the loop) records once. A partial overlap would make
+		// per-entry accounting ambiguous, so it disqualifies the iteration.
+		for (int i = 0; i < m_idle_write_count; i++)
+		{
+			const idle_access &w = m_idle_writes[i];
+			if (w.addr == addr && w.size == size)
+				return;
+			if ((addr < w.addr + w.size) && (w.addr < addr + size))
+			{
+				m_idle_viable = false;
+				return;
+			}
+		}
+		if (m_idle_write_count >= IDLE_MAX_WRITES)
+		{
+			m_idle_viable = false;
+			return;
+		}
+		m_idle_write_old[m_idle_write_count] = old_value;
+		m_idle_writes[m_idle_write_count++] = idle_access{ addr, 0, size };
+	}
+	void idle_note_io() { m_idle_viable = false; }
+	void idle_io_guard()
+	{
+		if (UNEXPECTED(m_idle_recording))
+			idle_note_io();
+	}
+	u8 recorded_io_read_byte(offs_t port)
+	{
+		const u8 value = io_read_byte(port);
+		if (UNEXPECTED(m_idle_recording))
+			idle_note_io_read(u16(port), value);
+		return value;
+	}
+	void idle_note_io_read(u16 port, u8 value)
+	{
+		if (!m_idle_viable)
+			return;
+		if (m_idle_status_port == 0 || port != m_idle_status_port)
+		{
+			m_idle_viable = false;
+			return;
+		}
+		for (int i = 0; i < m_idle_io_read_count; i++)
+			if (m_idle_io_reads[i].port == port)
+				return;
+		if (m_idle_io_read_count >= IDLE_MAX_IO_READS)
+		{
+			m_idle_viable = false;
+			return;
+		}
+		m_idle_io_reads[m_idle_io_read_count++] = idle_io_read{ port, value };
+	}
+
 	// Direct-pointer data window (MAME_MPC_V53_DATA_WINDOW). A small
 	// direct-mapped table of translated 16 KiB pages, separate for reads and
 	// writes so ROM stays writable only through the handler path. A page that
@@ -186,9 +343,15 @@
 	// null base so it never re-probes on the hot path.
 	static constexpr int DATA_WINDOW_COUNT = 64;
 	struct data_window { offs_t page = ~offs_t(0); u8 *base = nullptr; };
+	// MAME_MPC_V53_PC_HISTOGRAM=<path> (diagnostic): per-instruction linear-PC
+	// counters over the 20-bit space, dumped as binary u64[1M] at exit.
+	std::unique_ptr<u64[]> m_pc_histogram;
+	std::string m_pc_histogram_path;
+
 	bool m_data_window_enable = false;
 	data_window m_data_read_window[DATA_WINDOW_COUNT];
 	data_window m_data_write_window[DATA_WINDOW_COUNT];
+	virtual void device_stop() override;
 	void invalidate_data_windows();
 	u8 *fill_data_window(offs_t phys, bool is_write);
 
@@ -204,6 +367,12 @@
 		if (m_chip_type != CHIP_TYPE_V33)
 			return m_program->read_byte(a);
 		const offs_t phys = v33_translate_fast(a);
+		if (UNEXPECTED(m_idle_recording))
+		{
+			const u8 v = m_program->read_byte(phys);
+			idle_note_read(phys, v, 1);
+			return v;
+		}
 		if (m_data_window_enable)
 		{
 			data_window &w = m_data_read_window[(phys >> 14) & (DATA_WINDOW_COUNT - 1)];
@@ -223,6 +392,12 @@
 		if (m_chip_type != CHIP_TYPE_V33)
 			return m_program->read_word_unaligned(a);
 		const offs_t phys = v33_translate_fast(a);
+		if (UNEXPECTED(m_idle_recording))
+		{
+			const u16 v = m_program->read_word_unaligned(phys);
+			idle_note_read(phys, v, 2);
+			return v;
+		}
 		if (m_data_window_enable && EXPECTED((phys & V33_PAGE_MASK) != V33_PAGE_MASK))
 		{
 			data_window &w = m_data_read_window[(phys >> 14) & (DATA_WINDOW_COUNT - 1)];
@@ -248,6 +423,8 @@
 			return;
 		}
 		const offs_t phys = v33_translate_fast(a);
+		if (UNEXPECTED(m_idle_recording))
+			idle_note_write(phys, m_program->read_byte(phys), 1);
 		if (m_data_window_enable)
 		{
 			data_window &w = m_data_write_window[(phys >> 14) & (DATA_WINDOW_COUNT - 1)];
@@ -276,6 +453,8 @@
 			return;
 		}
 		const offs_t phys = v33_translate_fast(a);
+		if (UNEXPECTED(m_idle_recording))
+			idle_note_write(phys, m_program->read_word_unaligned(phys), 2);
 		if (m_data_window_enable && EXPECTED((phys & V33_PAGE_MASK) != V33_PAGE_MASK))
