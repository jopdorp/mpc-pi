 /***************************************************************************/
 
+void nec_common_device::device_stop()
+{
+	if (m_idle_skip_enabled)
+		fprintf(stderr, "V53_IDLE_SKIP skipped_iterations=%llu iter_cycles=%u reads=%d writes=%d verify_failures=%llu record_attempts=%llu fail_io=%llu fail_cycles=%llu fail_snapshot=%llu fail_netzero=%llu\n",
+				(unsigned long long)m_idle_skipped, m_idle_iter_cycles,
+				m_idle_read_count, m_idle_write_count,
+				(unsigned long long)m_idle_verify_fail,
+				(unsigned long long)m_idle_record_attempts,
+				(unsigned long long)m_idle_fail_io,
+				(unsigned long long)m_idle_fail_cycles,
+				(unsigned long long)m_idle_fail_snapshot,
+				(unsigned long long)m_idle_fail_netzero);
+
+	if (m_pc_histogram)
+	{
+		FILE *const out = fopen(m_pc_histogram_path.c_str(), "wb");
+		if (out)
+		{
+			fwrite(m_pc_histogram.get(), sizeof(u64), 1 << 20, out);
+			fclose(out);
+		}
+	}
+}
+
 void nec_common_device::device_reset()
 {
 	invalidate_fetch_window();
@@ -860,8 +885,248 @@
 	return true;
 }
 
+void nec_common_device::idle_capture_snapshot(idle_snapshot &into)
+{
+	into.regs = m_regs;
+	for (int i = 0; i < 4; i++)
+		into.sregs[i] = m_sregs[i];
+	into.ip = m_ip;
+	into.sign = m_SignVal;
+	into.aux = m_AuxVal;
+	into.over = m_OverVal;
+	into.zero = m_ZeroVal;
+	into.carry = m_CarryVal;
+	into.parity = m_ParityVal;
+	into.tf = m_TF;
+	into.iff = m_IF;
+	into.df = m_DF;
+	into.mf = m_MF;
+	into.no_interrupt = m_no_interrupt;
+	into.rep_params = m_rep_params;
+	into.prefetch_count = m_prefetch_count;
+	into.xa = m_xa;
+}
+
+bool nec_common_device::idle_snapshot_matches(const idle_snapshot &against)
+{
+	if (std::memcmp(against.regs.w, m_regs.w, sizeof(m_regs.w)))
+		return false;
+	for (int i = 0; i < 4; i++)
+		if (against.sregs[i] != m_sregs[i])
+			return false;
+	return against.ip == m_ip
+		&& against.sign == m_SignVal
+		&& against.aux == m_AuxVal
+		&& against.over == m_OverVal
+		&& against.zero == m_ZeroVal
+		&& against.carry == m_CarryVal
+		&& against.parity == m_ParityVal
+		&& against.tf == m_TF
+		&& against.iff == m_IF
+		&& against.df == m_DF
+		&& against.mf == m_MF
+		&& against.no_interrupt == m_no_interrupt
+		&& against.rep_params == m_rep_params
+		&& against.prefetch_count == m_prefetch_count
+		&& against.xa == m_xa;
+}
+
+void nec_common_device::idle_begin_recording()
+{
+	if (!m_idle_reads)
+	{
+		m_idle_reads = std::make_unique<idle_access[]>(IDLE_MAX_READS);
+		m_idle_writes = std::make_unique<idle_access[]>(IDLE_MAX_WRITES);
+		m_idle_write_old = std::make_unique<u16[]>(IDLE_MAX_WRITES);
+	}
+	m_idle_record_attempts++;
+	m_idle_read_count = 0;
+	m_idle_write_count = 0;
+	m_idle_io_read_count = 0;
+	m_idle_viable = true;
+	m_idle_cycles_accum = 0;
+	m_idle_slice_start = m_icount;
+	idle_capture_snapshot(m_idle_snapshot);
+	m_idle_recording = true;
+	m_idle_phase = idle_phase::RECORDING;
+}
+
+void nec_common_device::idle_abort_recording()
+{
+	m_idle_recording = false;
+	m_idle_phase = idle_phase::RECORD_PENDING;
+}
+
+void nec_common_device::idle_close_recording()
+{
+	m_idle_recording = false;
+	m_idle_cycles_accum += u32(m_idle_slice_start - m_icount);
+	const u32 iter_cycles = m_idle_cycles_accum;
+
+	if (!m_idle_viable)
+		m_idle_fail_io++;
+	else if (!(iter_cycles > 0 && iter_cycles < 65536))
+		m_idle_fail_cycles++;
+	else if (!idle_snapshot_matches(m_idle_snapshot))
+		m_idle_fail_snapshot++;
+
+	bool net_zero = m_idle_viable && (iter_cycles > 0) && (iter_cycles < 65536)
+			&& idle_snapshot_matches(m_idle_snapshot);
+	if (net_zero)
+	{
+		const bool was_candidate = true;
+		(void)was_candidate;
+		for (int i = 0; i < m_idle_write_count; i++)
+		{
+			const idle_access &w = m_idle_writes[i];
+			const u16 now = (w.size == 1)
+				? m_program->read_byte(w.addr)
+				: m_program->read_word_unaligned(w.addr);
+			if (now != m_idle_write_old[i])
+			{
+				if (m_idle_netzero_dumps < 24)
+				{
+					fprintf(stderr, "V53_IDLE_NETZERO addr=%05x size=%u old=%04x now=%04x\n",
+							w.addr, w.size, m_idle_write_old[i], now);
+					m_idle_netzero_dumps++;
+				}
+				net_zero = false;
+				break;
+			}
+		}
+	}
+	if (net_zero)
+	{
+		m_idle_iter_cycles = iter_cycles;
+		// Resolve each live-in read to a direct host pointer once, so the
+		// per-timeslice verification is a flat compare loop instead of a
+		// handler-dispatched read per entry. Pages are static RAM here, so a
+		// resolved pointer stays valid; any unresolvable entry keeps the
+		// handler-path verification for the whole set.
+		if (!m_idle_probes)
+			m_idle_probes = std::make_unique<idle_probe[]>(IDLE_MAX_READS);
+		m_idle_probes_valid = true;
+		m_idle_probe_count = 0;
+		for (int i = 0; i < m_idle_read_count && m_idle_probes_valid; i++)
+		{
+			const idle_access &r = m_idle_reads[i];
+			u16 *const lo = static_cast<u16 *>(m_program->get_read_ptr(r.addr));
+			if (!lo)
+			{
+				m_idle_probes_valid = false;
+				break;
+			}
+			const u8 *const lo_b = reinterpret_cast<const u8 *>(lo) + (r.addr & 1);
+			if (r.size == 2)
+			{
+				u16 *const hi = static_cast<u16 *>(m_program->get_read_ptr(r.addr + 1));
+				const u8 *const hi_b = hi
+					? reinterpret_cast<const u8 *>(hi) + ((r.addr + 1) & 1)
+					: nullptr;
+				if (!hi_b || (hi_b != lo_b + 1))
+				{
+					m_idle_probes_valid = false;
+					break;
+				}
+				m_idle_probes[m_idle_probe_count++] = idle_probe{ lo_b, r.value, 2 };
+			}
+			else
+				m_idle_probes[m_idle_probe_count++] = idle_probe{ lo_b, r.value, 1 };
+		}
+		m_idle_phase = idle_phase::ARMED;
+	}
+	else
+	{
+		if (m_idle_viable && (iter_cycles > 0) && (iter_cycles < 65536)
+				&& idle_snapshot_matches(m_idle_snapshot))
+			m_idle_fail_netzero++;
+		m_idle_phase = idle_phase::RECORD_PENDING;
+	}
+}
+
+void nec_common_device::idle_head_event()
+{
+	switch (m_idle_phase)
+	{
+	case idle_phase::ARMED:
+		if ((m_pending_irq == 0) && !m_halted && (m_icount > s32(m_idle_iter_cycles)))
+		{
+			bool unchanged = true;
+			for (int i = 0; i < m_idle_io_read_count; i++)
+			{
+				if (io_read_byte(m_idle_io_reads[i].port) != m_idle_io_reads[i].value)
+				{
+					unchanged = false;
+					break;
+				}
+			}
+			if (unchanged)
+			{
+			if (EXPECTED(m_idle_probes_valid))
+			{
+				for (int i = 0; i < m_idle_probe_count; i++)
+				{
+					const idle_probe &r = m_idle_probes[i];
+					const u16 now = (r.size == 1)
+						? r.ptr[0]
+						: (u16(r.ptr[0]) | (u16(r.ptr[1]) << 8));
+					if (now != r.value)
+					{
+						unchanged = false;
+						break;
+					}
+				}
+			}
+			else
+			{
+				for (int i = 0; i < m_idle_read_count; i++)
+				{
+					const idle_access &r = m_idle_reads[i];
+					const u16 now = (r.size == 1)
+						? m_program->read_byte(r.addr)
+						: m_program->read_word_unaligned(r.addr);
