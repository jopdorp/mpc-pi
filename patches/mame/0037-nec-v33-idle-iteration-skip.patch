+	// MAME_MPC_V53_IDLE_SKIP: exact main-loop idle-iteration skip. One loop
+	// iteration is recorded: its live-in reads (reads not preceded by the
+	// iteration's own write to the same address), its write set, and its cycle
+	// cost. If the iteration closes as a pure fixed point - registers, segment
+	// registers, flags, prefetch state and mode bits identical, every write
+	// net-zero by the time the loop head is reached again, no I/O access and
+	// no external interrupt - then while the live-in read set is unchanged and
+	// no interrupt is pending, whole iterations are charged without executing.
+	// The remainder smaller than one iteration is always executed normally, so
+	// a timeslice boundary or interrupt lands mid-loop exactly as it would
+	// have unskipped. Within one timeslice no other device can touch memory,
+	// which is what makes the once-per-timeslice verification exact.
+	enum class idle_phase : u8 { RECORD_PENDING, RECORDING, ARMED };
+	static constexpr int IDLE_MAX_READS = 1024;
+	static constexpr int IDLE_MAX_WRITES = 256;
+	struct idle_access { offs_t addr; u16 value; u8 size; };
+	struct idle_probe { const u8 *ptr; u16 value; u8 size; };
+	struct idle_snapshot
