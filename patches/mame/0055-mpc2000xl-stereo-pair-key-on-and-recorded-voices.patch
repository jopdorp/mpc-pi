+void l7a1045_sound_device::key_on(int channel)
+{
+	l7a1045_voice* const vptr = &m_voice[channel];
+
+	vptr->frac = 0;
+	vptr->pos = 0;
+	vptr->env_volume = (m_regs[L6028_Volume_Env][channel] & 0xffff'0000) >> 16;
+	vptr->env_pos = 0;
+	vptr->flt_freq = (m_regs[L6028_Filter_Env][channel] & 0xffff'0000) >> 16;
+	vptr->flt_pos = 0;
+	vptr->l = vptr->b = 0;
