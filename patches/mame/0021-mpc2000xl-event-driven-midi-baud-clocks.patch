+void mb89371_device::direct_brg_advance(int channel, const attotime &now)
+{
+	while (m_brg_next[channel] <= now)
+	{
+		m_sio[channel]->clock_cycle();
+		m_brg_next[channel] += m_brg_interval[channel];
+	}
+}
+
+void mb89371_device::direct_brg_fast_forward(int channel, const attotime &now)
+{
+	if (m_brg_next[channel] <= now)
+	{
+		const u64 clocks = (now - m_brg_next[channel]).as_ticks(m_brg_frequency[channel]) + 1;
+		m_brg_next[channel] += m_brg_interval[channel] * clocks;
+	}
+}
+
+void mb89371_device::direct_brg_reschedule(int channel, const attotime &now)
+{
+	m_brg_timer[channel]->adjust(attotime::never, channel);
+	const int clocks = m_sio[channel]->clocks_until_event();
+	if (!BIT(m_mode[channel], MODE_USE_BRG) || !clocks)
+		return;
+
+	const attotime target = m_brg_next[channel] + (m_brg_interval[channel] * (clocks - 1));
+	m_brg_timer[channel]->adjust(target > now ? target - now : attotime::zero, channel);
+}
+
+void mb89371_device::direct_brg_prepare_write(int channel, const attotime &now)
+{
+	if (m_sio[channel]->clock_idle())
+		direct_brg_fast_forward(channel, now);
+	else
+		direct_brg_advance(channel, now);
+}
+
+template<int ch> void mb89371_device::write_rxd(int state)
+{
+	if (BIT(m_mode[ch], MODE_LOOPBACK))
