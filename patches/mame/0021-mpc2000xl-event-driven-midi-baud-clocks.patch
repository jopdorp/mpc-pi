+	if (m_event_driven_brg && BIT(m_mode[ch], MODE_USE_BRG))
+		direct_brg_prepare_write(ch, now);
+	m_sio[ch]->write_rxd(state);
+	if (m_event_driven_brg && BIT(m_mode[ch], MODE_USE_BRG))
+		direct_brg_reschedule(ch, now);
+}
