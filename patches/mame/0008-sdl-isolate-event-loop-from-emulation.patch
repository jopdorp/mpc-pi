+
+void sdl_osd_interface::set_external_event_pump_ready(bool ready)
+{
+	if (!m_external_event_loop)
+		return;
+
+	std::unique_lock<std::mutex> lock(m_external_event_mutex);
+	m_external_pump_ready = ready;
+	if (!ready)
+	{
+		m_external_event_condition.wait(lock, [this]() { return !m_external_pump_active; });
+	}
+}
