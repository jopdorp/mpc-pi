+
+void sdl_osd_interface::service_external_event_loop()
+{
+	if (!m_external_event_loop)
+		return;
+
+	std::unique_lock<std::mutex> lock(m_external_event_mutex);
+	if (m_external_event_state == external_event_state::INIT_REQUESTED)
+	{
+		m_external_event_state = external_event_state::INIT_RUNNING;
+		lock.unlock();
+		int const result = SDL_InitSubSystem(SDL_INIT_VIDEO);
+		lock.lock();
+		m_external_sdl_result = result;
+		m_external_event_state = external_event_state::INIT_COMPLETE;
+		m_external_event_condition.notify_all();
+		return;
+	}
+	if (m_external_event_state == external_event_state::QUIT_REQUESTED)
+	{
+		m_external_event_state = external_event_state::QUIT_RUNNING;
+		lock.unlock();
+		SDL_QuitSubSystem(SDL_INIT_VIDEO);
+		lock.lock();
+		m_external_event_state = external_event_state::QUIT_COMPLETE;
+		m_external_event_condition.notify_all();
+		return;
+	}
+	if (!m_external_pump_ready || m_external_pump_active)
+		return;
+
+	m_external_pump_active = true;
+	lock.unlock();
+	SDL_PumpEvents();
+	lock.lock();
+	m_external_pump_active = false;
+	m_external_event_condition.notify_all();
 }
 
 
