+	std::unique_lock<std::mutex> lock(m_external_event_mutex);
+	m_external_event_state = external_event_state::QUIT_REQUESTED;
+	m_external_event_condition.notify_all();
+	m_external_event_condition.wait(lock, [this]()
+		{
+			return m_external_event_state == external_event_state::QUIT_COMPLETE;
+		});
+}
