+
+void device_v5x_interface::direct_brc_advance(const attotime &now)
+{
+	while (m_direct_brc_next <= now)
+	{
+		m_scu->clock_cycle_high();
+		m_direct_brc_next += m_direct_brc_interval;
+	}
+}
+
+void device_v5x_interface::direct_brc_fast_forward(const attotime &now)
+{
+	if (m_direct_brc_next <= now)
+	{
+		const u64 clocks = (now - m_direct_brc_next).as_ticks(m_direct_brc_frequency) + 1;
+		m_direct_brc_next += m_direct_brc_interval * clocks;
+	}
+}
+
+void device_v5x_interface::direct_brc_reschedule(const attotime &now)
+{
+	m_direct_brc_timer->adjust(attotime::never);
+	const int clocks = m_scu->clocks_until_event();
+	if (!m_brc_enable || !clocks)
+		return;
+
+	const attotime target = m_direct_brc_next + (m_direct_brc_interval * (clocks - 1));
+	m_direct_brc_timer->adjust(target > now ? target - now : attotime::zero);
+}
+
+void device_v5x_interface::rxd_w(int state)
+{
+	const attotime now = device().machine().time();
+	m_direct_rxd_state = state ? 1 : 0;
+
+	if (!m_direct_brc_timer_enabled || !m_brc_enable)
+	{
+		m_scu->write_rxd(m_direct_rxd_state);
+		return;
+	}
+
+	if (m_scu->clock_idle())
+		direct_brc_fast_forward(now);
+	else
+		direct_brc_advance(now);
+	m_scu->write_rxd(m_direct_rxd_state);
+	direct_brc_reschedule(now);
+}
