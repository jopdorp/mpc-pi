+void i8251_device::clock_cycle_high()
+{
+	// A complete high-low-high clock cycle matching the V5X internal BRC.
+	// TX advances on the falling edge before RX samples on the rising edge.
+	if (m_txc)
+		transmit_clock();
+	m_txc = 1;
+	m_rxc = 0;
+	if (m_sync_byte_count == 1)
+		sync1_rxc();
+	else if (m_sync_byte_count == 2)
+		sync2_rxc();
+	else
+		receive_clock();
+	m_rxc = 1;
+}
+
+bool i8251_device::clock_idle() const
+{
+	const bool receive_idle =
+		!BIT(m_command, 2) || (m_rxd && is_receive_register_idle_high());
+	const bool transmit_idle =
+		!m_sync_byte_count &&
+		is_transmit_register_empty() &&
+		((m_status & (I8251_STATUS_TX_READY | I8251_STATUS_TX_EMPTY)) ==
+			(I8251_STATUS_TX_READY | I8251_STATUS_TX_EMPTY)) &&
+		!m_break_release_pending;
+	return receive_idle && transmit_idle;
+}
+
+int i8251_device::clocks_until_event() const
+{
+	int clocks = 0;
+	if (BIT(m_command, 2) && (!m_rxd || !is_receive_register_idle_high()))
+		clocks = m_rxc_count ? m_rxc_count : 1;
+
+	const bool transmit_idle =
+		!m_sync_byte_count &&
+		is_transmit_register_empty() &&
+		((m_status & (I8251_STATUS_TX_READY | I8251_STATUS_TX_EMPTY)) ==
+			(I8251_STATUS_TX_READY | I8251_STATUS_TX_EMPTY)) &&
+		!m_break_release_pending;
+	if (!transmit_idle)
+	{
+		const int transmit_clocks = m_br_factor - m_txc_count;
+		clocks = clocks ? std::min(clocks, transmit_clocks) : transmit_clocks;
+	}
+	return clocks;
+}
