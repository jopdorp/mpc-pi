From: mpc-pi
Subject: [PATCH] l7a1045: optional direct-pointer wave-RAM window

The DSP mix loop reads one sample per voice per output frame through the
memory cache, which dispatches into a handler entry. The MPC2000XL wave RAM
is one flat .ram() region, so MAME_MPC_DSP_WINDOW caches a direct host
pointer to the containing 64 KiB page with the same both-ends contiguity
check as the V33 windows; flash-backed pages do not resolve and keep the
handler path.

Frozen 48 kHz all-output PCM is bit-identical off and on. Desktop wall-clock
effect is inside run-to-run noise (median +0.9% over eight interleaved
runs); retained default-off as a Cortex-A53 candidate alongside the V33 data
window.

diff --git a/src/devices/sound/l7a1045_l6028_dsp_a.h b/src/devices/sound/l7a1045_l6028_dsp_a.h
--- a/src/devices/sound/l7a1045_l6028_dsp_a.h
+++ b/src/devices/sound/l7a1045_l6028_dsp_a.h
@@ -96,6 +96,27 @@
 	memory_access<25, 1, 0, ENDIANNESS_LITTLE>::cache m_cache;
 	memory_access<25, 1, 0, ENDIANNESS_LITTLE>::cache m_rom_cache;
 
+	// MAME_MPC_DSP_WINDOW: direct-pointer window over contiguous wave RAM.
+	static constexpr offs_t DSP_PAGE_MASK = 0xffff;
+	bool m_dsp_window_enable = false;
+	u8 *m_window_base = nullptr;
+	offs_t m_window_start = 1;
+	offs_t m_window_end = 0;
+	u8 *fill_dsp_window(offs_t address);
+	inline u16 window_read_word(offs_t address)
+	{
+		if (m_dsp_window_enable && EXPECTED((address & DSP_PAGE_MASK) != DSP_PAGE_MASK))
+		{
+			if (EXPECTED(address >= m_window_start && address <= m_window_end))
+				return u16(m_window_base[address - m_window_start])
+					| (u16(m_window_base[address - m_window_start + 1]) << 8);
+			if (u8 *const base = fill_dsp_window(address))
+				return u16(base[address - m_window_start])
+					| (u16(base[address - m_window_start + 1]) << 8);
+		}
+		return m_cache.read_word(address);
+	}
+
 	void voice_select_w(offs_t offset, uint16_t data, uint16_t mem_mask = ~0);
 	uint16_t voiceregs_r(offs_t offset);
 	void voiceregs_w(offs_t offset, uint16_t data);
diff --git a/src/devices/sound/l7a1045_l6028_dsp_a.cpp b/src/devices/sound/l7a1045_l6028_dsp_a.cpp
--- a/src/devices/sound/l7a1045_l6028_dsp_a.cpp
