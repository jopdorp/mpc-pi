+#include <cstdlib>
 #include "l7a1045_l6028_dsp_a.h"
 #include "debugger.h"
 
@@ -216,6 +218,7 @@
 
 	// Allocate the stream
 	m_sample_rate = clock() / 768.0f;
+	m_dsp_window_enable = (std::getenv("MAME_MPC_DSP_WINDOW") != nullptr);
 	m_stream = stream_alloc(0, 10, m_sample_rate);
 
 	m_dma_timer = timer_alloc(FUNC(l7a1045_sound_device::dma_timer_callback), this);
@@ -253,6 +256,25 @@
 	m_key = 0;
 }
 
+u8 *l7a1045_sound_device::fill_dsp_window(offs_t address)
+{
+	const offs_t start = address & ~offs_t(DSP_PAGE_MASK);
+	const offs_t end = start | DSP_PAGE_MASK;
+	auto *const lo = static_cast<u16 *>(m_cache.read_ptr(start));
+	auto *const hi = static_cast<u16 *>(m_cache.read_ptr(end & ~offs_t(1)));
+	if (lo && hi && (hi == lo + ((end & ~offs_t(1)) - start) / 2))
+	{
+		m_window_base = reinterpret_cast<u8 *>(lo);
+		m_window_start = start;
+		m_window_end = end;
+		return m_window_base;
+	}
+	m_window_base = nullptr;
+	m_window_start = 1;
+	m_window_end = 0;
+	return nullptr;
+}
+
 void l7a1045_sound_device::sound_stream_update(sound_stream &stream)
 {
 	for (int i = 0; i < NUM_VOICES; i++)
@@ -286,7 +308,7 @@
 				{
 					case 0: // 16-bit linear, little-endian
 						address = ((start << 1) + (pos << 1));
-						sample = (int16_t)m_cache.read_word(address);
+						sample = (int16_t)window_read_word(address);
 						break;
 
