@@ -319,6 +319,37 @@ inline uint64_t mulu_64x64(uint64_t a, uint64_t b, uint64_t &hi)
 
 
 /*-------------------------------------------------
+    compute_divu_64x32_reciprocal - precompute a
+    reciprocal for repeated unsigned 64 bit x 32
+    bit division
+-------------------------------------------------*/
+
+constexpr uint64_t compute_divu_64x32_reciprocal(uint32_t divisor)
+{
+	return (divisor > 1) ? ((~uint64_t(0) / divisor) + 1) : 0;
+}
+
+
+/*-------------------------------------------------
+    divu_64x32_reciprocal - perform an unsigned
+    64 bit x 32 bit divide using a precomputed
+    reciprocal and return the 32 bit quotient
+-------------------------------------------------*/
+
+inline uint32_t divu_64x32_reciprocal(uint64_t dividend, uint32_t divisor, uint64_t reciprocal)
+{
+	if (!reciprocal)
+		return uint32_t(dividend);
+
+	uint64_t quotient;
+	mulu_64x64(dividend, reciprocal, quotient);
+	if ((quotient >> 32) || (quotient * divisor > dividend))
+		--quotient;
+	return uint32_t(quotient);
+}
