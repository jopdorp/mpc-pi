+void i8251_device::clock_cycle()
+{
+	// A complete low-high-low clock cycle.  This is equivalent to calling
+	// write_txc(1), write_rxc(1), write_txc(0), write_rxc(0), without four
+	// separate state-normalising call boundaries.
+	m_txc = 1;
+	if (!m_rxc)
+	{
+		if (m_sync_byte_count == 1)
+			sync1_rxc();
+		else if (m_sync_byte_count == 2)
+			sync2_rxc();
+		else
+			receive_clock();
+	}
+	m_rxc = 1;
+	m_txc = 0;
+	transmit_clock();
+	m_rxc = 0;
+}
+
 // forcibly kill hunt mode
