#!/bin/bash
# Netboot the MPC appliance: DHCP + TFTP + NFS root from the mpc-pi build.
#
# Serves scripts/../.cache/br-rpi5 so the Pi boots the MPC rig itself,
# not the neighbouring rpi-pedal firmware, and so iterating on the
# appliance costs a reboot instead of an SD-card swap.
#
# Designed to be run through a scoped NOPASSWD sudoers rule (see
# install-privileges.sh), so it takes NO path arguments: everything it
# touches is fixed at the top. A privileged helper that accepts paths
# from its caller is a privilege-escalation hole, and this one is meant
# to be callable without a password.
#
#   mpcpi-netboot start | stop | status
set -uo pipefail

REPO="/home/jopdorp/development/mpc-pi"
BUILD="$REPO/.cache/br-rpi5"
IMAGES="$BUILD/images"
# Which rootfs to serve. The appliance base is Raspberry Pi OS now, but
# the Buildroot tree still boots the emulator half, so both are keepable
# and a marker file picks one. Netboot is the iteration loop: edit on the
# host, reboot the Pi, no card ever leaves the slot.
ROOT_KIND_FILE="/etc/mpcpi-netboot.root"
ROOT_KIND="$(cat "$ROOT_KIND_FILE" 2>/dev/null || echo pios)"
PIOS_ROOT="/srv/nfs/mpcpi-pios"
if [ "$ROOT_KIND" = "buildroot" ]; then
	NFS_ROOT="$BUILD/target"
else
	NFS_ROOT="$PIOS_ROOT"
fi
TFTP_ROOT="/srv/tftp/mpcpi"
SERVER_IP="192.168.7.1"
SUBNET="192.168.7.0/24"
DHCP_RANGE="192.168.7.100,192.168.7.200,12h"
PIDFILE="/run/mpcpi-netboot.pid"
LOGFILE="/srv/tftp/mpcpi-netboot.log"   # world-readable: the
                                        # whole point is that
                                        # diagnosis needs no root
IFACE_FILE="/etc/mpcpi-netboot.iface"

NM_DROPIN=/etc/NetworkManager/conf.d/99-mpcpi-netboot.conf

die() { echo "mpcpi-netboot: $*" >&2; exit 1; }

# The Pi 5 boots from EEPROM: it needs a kernel, the DTBs, the overlays
# and a config/cmdline pair. No start.elf or bootcode.bin.
populate_tftp() {
	if [ "$ROOT_KIND" = "buildroot" ]; then
		cp "$IMAGES/Image" "$TFTP_ROOT/Image" || die "no kernel in $IMAGES"
		cp "$IMAGES/Image" "$TFTP_ROOT/kernel_2712.img"
		cp "$IMAGES"/bcm2712*.dtb "$TFTP_ROOT/" 2>/dev/null
		[ -d "$IMAGES/rpi-firmware/overlays" ] &&
			cp -r "$IMAGES/rpi-firmware/overlays" "$TFTP_ROOT/"
		cp "$REPO/board/rpi5/config.txt" "$TFTP_ROOT/config.txt" 2>/dev/null
	else
		# A Pi OS root carries its own kernel and firmware in /boot.
		local b="$NFS_ROOT/boot/firmware"
		[ -d "$b" ] || b="$NFS_ROOT/boot"
		[ -d "$b" ] || die "no Pi OS root yet - run: mpcpi-netboot fetch-pios"
		cp "$b"/kernel*.img "$TFTP_ROOT/" 2>/dev/null
		cp "$b"/*.dtb "$TFTP_ROOT/" 2>/dev/null
		cp "$b"/start*.elf "$b"/fixup*.dat "$TFTP_ROOT/" 2>/dev/null
		[ -d "$b/overlays" ] && cp -r "$b/overlays" "$TFTP_ROOT/"
		cp "$b/config.txt" "$TFTP_ROOT/config.txt" 2>/dev/null
	fi
}

# Interface choice, in order: the pinned one, else the wired link that
# actually has a cable in it. Picking by carrier is what stops the
# server binding to an unplugged dongle, which is exactly the failure
# that wasted a boot cycle with the older script.
pick_iface() {
	if [ -r "$IFACE_FILE" ]; then
		local pinned
		pinned=$(tr -d '[:space:]' < "$IFACE_FILE")
		if [ -n "$pinned" ] && [ -e "/sys/class/net/$pinned" ]; then
			echo "$pinned"; return
		fi
	fi
	local best=""
	for i in /sys/class/net/*; do
		local n; n=$(basename "$i")
		case "$n" in
			lo|wl*|docker*|virbr*|veth*|tap*|wg*|br-*|mpqemubr*) continue ;;
		esac
		if [ "$(cat "$i/carrier" 2>/dev/null)" = "1" ]; then
			best="$n"; break
		fi
		[ -z "$best" ] && best="$n"
	done
	echo "$best"
}

IFACE=$(pick_iface)

status() {
	echo "interface : ${IFACE:-none found}"
	if [ -n "$IFACE" ]; then
		echo "carrier   : $(cat "/sys/class/net/$IFACE/carrier" 2>/dev/null || echo '?') (1 = cable present)"
		addr=$(ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}')
		if [ "$addr" = "$SERVER_IP/24" ]; then
			echo "address   : $addr"
		elif [ -z "$addr" ]; then
			# The exact shape of the outage this check exists for.
			echo "address   : NONE - the server has no address."
			echo "            The board can netboot only when $IFACE holds"
			echo "            $SERVER_IP. Re-run: sudo $0 start"
			nmcli -t -f DEVICE,STATE device 2>/dev/null |
				grep "^$IFACE:" | grep -q ":unmanaged" ||
				echo "            NetworkManager still manages $IFACE - it took the"
			echo "            address once before; start writes $NM_DROPIN to stop that."
		else
			echo "address   : $addr - WRONG, expected $SERVER_IP/24"
		fi
	fi
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "dnsmasq   : running (pid $(cat "$PIDFILE"))"
		tr ' ' '\n' < "/proc/$(cat "$PIDFILE")/cmdline" 2>/dev/null |
			grep -E "^--interface|^--tftp-root" | sed 's/^/            /'
	else
		echo "dnsmasq   : not running"
	fi
	echo "tftp root : $TFTP_ROOT $([ -d "$TFTP_ROOT" ] && echo "($(ls -1 "$TFTP_ROOT" 2>/dev/null | wc -l) files)" || echo '(absent)')"
	echo "nfs root  : $NFS_ROOT $([ -d "$NFS_ROOT" ] && echo present || echo MISSING)"
	echo "exported  : $(exportfs -s 2>/dev/null | grep -c "$NFS_ROOT") entry"
	if command -v ufw >/dev/null && ufw status 2>/dev/null | head -1 | grep -q active; then
		if ufw status 2>/dev/null | grep -q "Anywhere on $IFACE"; then
			echo "firewall  : ufw active, $IFACE allowed"
		else
			echo "firewall  : ufw active and $IFACE is NOT allowed -"
			echo "            the Pi's DHCP is dropped before dnsmasq sees it"
		fi
	fi
	echo "log       : $LOGFILE"
}

start() {
	[ "$(id -u)" -eq 0 ] || die "must run as root (see install-privileges.sh)"
	[ -n "$IFACE" ] || die "no wired interface found"
	[ -d "$IMAGES" ] || die "no build at $IMAGES - run scripts/build-sysroot-rpi5.sh"
	[ -d "$NFS_ROOT" ] || die "no target rootfs at $NFS_ROOT"

	if [ "$(cat "/sys/class/net/$IFACE/carrier" 2>/dev/null)" != "1" ]; then
		echo "warning: $IFACE has no carrier - is the cable in?" >&2
	fi

	# Another DHCP/TFTP server on this link would fight us for port 67
	# and hand the Pi somebody else's kernel. The rpi-pedal script is
	# the likely candidate, so say so by name rather than failing
	# cryptically.
	local foreign
	foreign=$(pgrep -af "dnsmasq.*--interface=$IFACE" |
		grep -v "tftp-root=$TFTP_ROOT" | head -1)
	if [ -n "$foreign" ]; then
		echo "another DHCP/TFTP server is already on $IFACE:" >&2
		echo "  $foreign" >&2
		echo "stop it first, e.g. the rpi-pedal one:" >&2
		echo "  sudo ~/development/rpi-pedal-buildroot/scripts/pxe-server.sh stop rpi5" >&2
		exit 1
	fi

	echo "using interface $IFACE"

	# Take the interface away from NetworkManager BEFORE addressing it.
	# `ip addr add` is a hand-placed address, and NetworkManager flushes
	# hand-placed addresses the moment it decides to manage a link - on a
	# carrier bounce, on a service restart, on resume from suspend. That
	# is not hypothetical: this server ran for a day, the link flapped
	# once, and NM took enp45s0 back to "connecting (getting IP
	# configuration)" - trying to OBTAIN a lease on the interface whose
	# whole job is to SERVE them. The address vanished, dnsmasq kept
	# running and kept logging, and the board netbooted into nothing for
	# hours while every symptom pointed at the board.
	if command -v nmcli >/dev/null 2>&1; then
		mkdir -p /etc/NetworkManager/conf.d
		printf '# %s serves DHCP/TFTP for the Pi; NM must not touch it.\n[keyfile]\nunmanaged-devices=interface-name:%s\n' \
			"$IFACE" "$IFACE" > "$NM_DROPIN"
		nmcli device set "$IFACE" managed no >/dev/null 2>&1
		nmcli general reload conf >/dev/null 2>&1
		echo "  NetworkManager told to leave $IFACE alone ($NM_DROPIN)"
	fi

	# Only disturb the address if it is actually wrong. A running board
	# has its NFS ROOT on the far end of this interface, so flushing is
	# not a free no-op - it is pulling the filesystem out from under a
	# live machine. `start` is also the documented recovery command, so
	# it gets run on a healthy rig by someone fixing something else.
	if [ "$(ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}')" \
		= "$SERVER_IP/24" ]; then
		echo "  address already $SERVER_IP/24, left alone"
	else
		ip addr flush dev "$IFACE" 2>/dev/null
		ip addr add "$SERVER_IP/24" dev "$IFACE" || die "could not set $SERVER_IP"
	fi
	ip link set "$IFACE" up

	mkdir -p "$TFTP_ROOT"
	populate_tftp

	# Root over NFS, and keep the appliance's own isolcpus/threadirqs
	# tuning so a netbooted rig behaves like a flashed one.
	{
		printf 'console=serial0,115200 console=tty1 '
		printf 'root=/dev/nfs nfsroot=%s:%s,vers=3,tcp rw ' "$SERVER_IP" "$NFS_ROOT"
		printf 'ip=dhcp rootwait isolcpus=2-3 threadirqs\n'
	} > "$TFTP_ROOT/cmdline.txt"

	if ! grep -qF "$NFS_ROOT" /etc/exports 2>/dev/null; then
		echo "$NFS_ROOT $SUBNET(rw,sync,no_subtree_check,no_root_squash)" \
			>> /etc/exports
	fi
	exportfs -ra 2>/dev/null || echo "warning: exportfs failed" >&2

	stop_quiet
	dnsmasq --interface="$IFACE" --bind-interfaces \
		--dhcp-range="$DHCP_RANGE" --dhcp-option=66,"$SERVER_IP" \
		--pxe-service=0,"Raspberry Pi Boot" \
		--enable-tftp --tftp-root="$TFTP_ROOT" \
		--log-dhcp --log-facility="$LOGFILE" \
		--pid-file="$PIDFILE" --port=0 ||
		die "dnsmasq failed to start"

	open_firewall

	echo "netboot ready on $IFACE ($SERVER_IP), serving $TFTP_ROOT"
	echo "watch: sudo tail -f $LOGFILE"
}

# A listening socket is not a reachable one. With ufw active and its
# default deny-incoming policy, the Pi's DHCP DISCOVER is counted by the
# NIC and then dropped by netfilter before dnsmasq ever sees it - the
# lease log stays empty while rx_packets climbs, which reads exactly like
# a board that is not booting at all. That cost a full diagnosis cycle.
#
# The rule is scoped to the netboot interface rather than to ports: NFS
# drags in rpcbind, mountd and statd, and mountd's port is dynamic, so
# enumerating them is both fragile and longer. This interface is a direct
# cable to our own board, so allowing it wholesale opens nothing the Pi
# cannot already reach, and leaves wifi and every other link untouched.
open_firewall() {
	command -v ufw >/dev/null || return 0
	ufw status 2>/dev/null | head -1 | grep -q "active" || return 0
	if ufw status 2>/dev/null | grep -q "Anywhere on $IFACE"; then
		return 0
	fi
	echo "opening $IFACE in ufw (dhcp/tftp/nfs must reach us)"
	ufw allow in on "$IFACE" comment "mpcpi netboot" >/dev/null 2>&1 ||
		echo "warning: could not add the ufw rule" >&2
}

close_firewall() {
	command -v ufw >/dev/null || return 0
	ufw delete allow in on "$IFACE" >/dev/null 2>&1
	return 0
}

stop_quiet() {
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	pkill -f "dnsmasq.*tftp-root=$TFTP_ROOT" 2>/dev/null
	return 0
}

stop() {
	[ "$(id -u)" -eq 0 ] || die "must run as root"
	stop_quiet
	close_firewall
	[ -n "$IFACE" ] && ip addr del "$SERVER_IP/24" dev "$IFACE" 2>/dev/null
	# Also clear the address wherever else it may have been left, which
	# is how the older script stranded it on an unplugged dongle.
	for i in /sys/class/net/*; do
		n=$(basename "$i")
		ip addr del "$SERVER_IP/24" dev "$n" 2>/dev/null
	done
	echo "netboot stopped"
}

case "${1:-status}" in
	start) start ;;
	stop) stop ;;
	status) status ;;
	log) tail -n "${2:-40}" "$LOGFILE" 2>/dev/null || echo "no log yet" ;;
	sniff)
		# Capture on the netboot link and summarise who is talking.
		#
		# The DHCP log answers "did the Pi ask for an address"; it cannot
		# answer "is the Pi sending anything at all". When a board links
		# up at 1Gb but never appears in the lease log, the difference
		# between a silent PHY and a bootloader speaking some other
		# protocol is the whole diagnosis, and only a capture shows it.
		#
		# Capture is read-only, bounded by a duration, and confined to
		# the netboot interface, so it is safe behind a passwordless
		# rule: it can see nothing but the cable to the Pi.
		[ "$(id -u)" -eq 0 ] || die "must run as root"
		[ -n "$IFACE" ] || die "no interface with a carrier"
		command -v tcpdump >/dev/null || die "tcpdump not installed"
		secs="${2:-20}"
		case "$secs" in *[!0-9]*) die "sniff <seconds>" ;; esac
		pcap="/srv/tftp/mpcpi-link.pcap"
		echo "capturing ${secs}s on $IFACE ..."
		timeout $((secs + 3)) tcpdump -i "$IFACE" -n -s 256 -c 2000 \
			-G "$secs" -W 1 -w "$pcap" >/dev/null 2>&1
		chmod 644 "$pcap" 2>/dev/null
		n=$(tcpdump -r "$pcap" -n 2>/dev/null | wc -l)
		echo "packets: $n  ($pcap)"
		[ "$n" -eq 0 ] && {
			echo "the link is silent: the board sent nothing at all,"
			echo "so it is not attempting any boot over this cable."
			exit 0
		}
		echo "-- source MACs --"
		tcpdump -r "$pcap" -n -e 2>/dev/null |
			grep -oE '^[0-9:.]+ [0-9a-f:]{17}' |
			awk '{print $2}' | sort | uniq -c | sort -rn | head -8
		echo "-- protocols --"
		tcpdump -r "$pcap" -n 2>/dev/null |
			awk '{for(i=1;i<=NF;i++) if($i ~ /^(ARP|BOOTP\/DHCP|ICMP6?|UDP|TCP|IP6?)$/){print $i; break}}' |
			sort | uniq -c | sort -rn | head -8
		echo "-- first lines --"
		tcpdump -r "$pcap" -n 2>/dev/null | head -12
		;;
	root)
		# Switch which rootfs is served. Fixed set of values, so this
		# stays safe to expose through a passwordless rule.
		[ "$(id -u)" -eq 0 ] || die "must run as root"
		case "${2:-}" in
			pios|buildroot) echo "$2" > "$ROOT_KIND_FILE"
				echo "serving $2 root on next start" ;;
			*) echo "current: $ROOT_KIND (pios|buildroot)" ;;
		esac
		;;
	fetch-pios)
		# Unpack a Raspberry Pi OS arm64 image into an NFS root. Needs
		# root for the loop mount and to preserve ownership, which is
		# exactly why it lives in this helper rather than a user script.
		[ "$(id -u)" -eq 0 ] || die "must run as root"
		img="${MPCPI_PIOS_IMG:-/var/tmp/pios-arm64-lite.img.xz}"
		url="https://downloads.raspberrypi.com/raspios_lite_arm64_latest"
		mkdir -p "$PIOS_ROOT" /var/tmp
		if [ ! -s "$img" ]; then
			echo "downloading Raspberry Pi OS Lite arm64..."
			curl -fL --progress-bar "$url" -o "$img" || die "download failed"
		fi
		raw="${img%.xz}"
		[ -s "$raw" ] || { echo "decompressing..."; xz -dk -T0 "$img" || die "xz failed"; }
		# Partition 2 is the root filesystem on every Pi OS image.
		off=$(partx -g -o START -s -n 2:2 "$raw" | tr -d ' ')
		[ -n "$off" ] || die "could not find the root partition"
		mnt=$(mktemp -d)
		mount -o loop,offset=$((off * 512)) "$raw" "$mnt" || die "mount failed"
		echo "copying rootfs (this takes a few minutes)..."
		cp -a "$mnt/." "$PIOS_ROOT/" 2>/dev/null
		umount "$mnt"; rmdir "$mnt"
		# And the boot partition, which carries the kernel and firmware.
		boff=$(partx -g -o START -s -n 1:1 "$raw" | tr -d ' ')
		mnt=$(mktemp -d)
		mount -o loop,offset=$((boff * 512)) "$raw" "$mnt" 2>/dev/null &&
			{ mkdir -p "$PIOS_ROOT/boot/firmware"
			  cp -a "$mnt/." "$PIOS_ROOT/boot/firmware/" 2>/dev/null
			  umount "$mnt"; }
		rmdir "$mnt" 2>/dev/null
		# NFS root must not fsck or mount its own SD partitions.
		sed -i "s/^[^#].*[[:space:]]\/[[:space:]].*//" "$PIOS_ROOT/etc/fstab" 2>/dev/null
		sed -i "s/^[^#].*\/boot.*//" "$PIOS_ROOT/etc/fstab" 2>/dev/null
		echo "Pi OS root ready at $PIOS_ROOT"
		;;
	deploy)
		# Refresh what the Pi will fetch, without disturbing a running
		# server: kernel and rootfs change far more often than the
		# DHCP/TFTP daemon needs restarting.
		[ "$(id -u)" -eq 0 ] || die "must run as root"
		cp "$IMAGES/Image" "$TFTP_ROOT/Image" && \
		cp "$IMAGES/Image" "$TFTP_ROOT/kernel_2712.img" && \
		cp "$IMAGES"/bcm2712*.dtb "$TFTP_ROOT/" 2>/dev/null
		[ -d "$IMAGES/rpi-firmware/overlays" ] &&
			cp -r "$IMAGES/rpi-firmware/overlays" "$TFTP_ROOT/"
		cp "$REPO/board/rpi5/config.txt" "$TFTP_ROOT/config.txt" 2>/dev/null
		"$REPO/scripts/netboot/deploy-daw.sh" "$NFS_ROOT" || true
		echo "redeployed kernel, dtbs, overlays and DAW layer"
		;;
	*) die "usage: mpcpi-netboot start|stop|status|log [n]|deploy|root [pios|buildroot]|fetch-pios" ;;
esac
