#!/usr/bin/env python3
"""The daemon: MPC transport in, Ardour control out, panel state on disk.

This is the process that makes the parts one system. Every 10 ms it:

  1. reads the emulator's transport export (elapsed ms, playing),
  2. advances the loop engine, which owns bar quantisation,
  3. turns the engine's actions into Ardour OSC,
  4. writes the panel's state as JSON for daw-ui-daemon to render.

Commands arrive as lines on a FIFO, which is what maschine-hub writes
when a button or pad is pressed. A FIFO rather than a socket because a
FIFO survives either side restarting without a reconnect dance, which on
stage is the only property that matters.

    daw-ctl --session-strips LOOP1,LOOP2,...  [--dry-run] [--self-test]
"""
import argparse
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import browser as browserlib                              # noqa: E402
import daw_ctl                                            # noqa: E402
import osc as osclib                                      # noqa: E402
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "maschine"))
import ardour_bindings                                    # noqa: E402

TRANSPORT = "/dev/shm/mpc-transport"
STATE = "/dev/shm/daw-ui-state.json"
FIFO = "/run/daw-ctl.fifo"
# Region work goes to the Lua side, which owns the playlist. Same default as
# session-governor.lua and run-session.sh, and the same reasoning as the FIFO
# above: a file survives either side restarting with no reconnect dance.
QUEUE = os.environ.get("DAW_QUEUE", "/dev/shm/daw-region-queue")
# ...and the same channel the other way: the region list the Lua side
# publishes after every change. Without it EDIT and WAVE draw a grid, a
# cursor and a pair of trim handles over an empty timeline - there is
# nothing to select, so nothing to split, slide, fade, erase or normalise.
# See session-governor.lua's publish() for the format and for why the
# header carries Ardour's sample rate and transport position.
REGIONS = os.environ.get("DAW_REGIONS", "/dev/shm/daw-regions")
# The plugin chains, from the same file session-template.lua instantiates
# the session from. chains.py promises "the chips drawn on the FX page are
# literally this list", and reading the builder's own input is what makes
# that true: a chain hardcoded here would drift from the session the first
# time chains.py changed, and the FX page would browse plugins that are
# not there.
CHAINS_JSON = os.environ.get("CHAINS_JSON", os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "chains.json"))


def load_chains(path=CHAINS_JSON):
    """{track: [{name, kind, bypass...}]} - or nothing, said plainly.

    An unreadable chain file is a session this process cannot describe,
    not a reason to refuse to mix: every FX verb answers NO CHAIN and the
    other five pages work untouched.
    """
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in data.items() if isinstance(v, list)}
# Where a floppy chosen on the panel is published for the emulator.
#
# READ BY scripts/daw/mpcpi-autoplay.lua, which runs as MAME's autoboot script
# and therefore already lives inside the machine: it polls this path and calls
# the drive's own load(). That is why this never needed a MAME patch - the Lua
# image interface is the supported way to swap media at runtime, and an
# autoboot script is a place it can be called from.
DISK_REQUEST = os.environ.get("MPCPI_DISK_REQUEST", "/dev/shm/mpc-disk")
# What the emulator says HAPPENED - "ok <path>" or "error <message>".
#
# The request alone cannot tell the player anything: a path can be a
# directory, the wrong size, or gone by the time the drive looks at it, and a
# panel that prints LOAD the instant a key is pressed is reporting its own
# keypress rather than the machine's answer. This is the answer.
DISK_STATUS = os.environ.get("MPCPI_DISK_STATUS", "/dev/shm/mpc-disk-status")
# The same choice, somewhere that survives a power cycle.
#
# /dev/shm is a tmpfs, so without this the drive silently reverts to the unit's
# hardcoded -flop on every boot and the disk the player chose last night is
# gone. The emulator seeds from this at startup when there is no live request.
DISK_MEMORY = os.environ.get(
    "MPCPI_DISK_MEMORY",
    os.path.join(os.environ.get("MAME_RUNTIME_DIR", "/var/lib/mpcpi"), "disk"))

# Column order is the contract: strip N on the panel is OSC ssid N+1 and
# the same column the UI draws. Changing this changes three things at
# once, so it lives in exactly one place - and that place is control_map,
# which the Maschine panel and the session template already read.
#
# It used to be a fourth, independent copy of the list, and it silently kept
# the old names through a rename: the panel drew LOOP1..LOOP5 while this file
# still believed in MPC/GTR1/GTR2/MIC, so knob N moved whatever route happened
# to sit at index N. Indices, not names, go out over OSC, so nothing errored.
import control_map                                        # noqa: E402
STRIPS = list(control_map.STRIPS)
# The recordable lanes are the loop tracks - everything that is not a send or
# the master. Derived, so adding a sixth loop needs one edit, not two.
LANES = [n for n in STRIPS if n not in ("DELAY", "REVERB", "MASTER")]


class Daw:
    # The appliance's sample rate, and the session's. It is 44.1k
    # everywhere - the graph clock, the emulator and the USB gadget - and
    # daw_ctl.Transport defaults to 48000, which nothing here overrode: every
    # length this process put on the queue was 8.8% long, so a four-bar loop
    # was fitted to four bars and eight percent of a fifth. The published
    # region header carries the session's real rate and overrides this.
    RATE = int(os.environ.get("MPCPI_RATE", "44100"))

    def __init__(self, client, strips=None, lanes=None, bpm=120.0,
                 queue=QUEUE, regions=REGIONS, chains=None):
        self.osc = client
        self.queue = queue
        self.strips = list(strips or STRIPS)
        self.transport = daw_ctl.Transport(rate=self.RATE)
        self.transport.bpm = bpm
        self.engine = daw_ctl.Engine(self.transport)
        for name in (lanes or LANES):
            self.engine.add_lane(name, bars=4)
        self.page = "LOOP"
        self.mode = "MPC"
        # No focus_bank. All eight knobs address all eight strips at once,
        # so there was never a second bank to focus - see control_map.MODES.
        # dB, not fader position. It was 0.8 here and read as dB by
        # the readout, which printed "0.8 DB" for a strip nobody had
        # touched - a unity fader claiming +0.8.
        self.gains = {n: 0.0 for n in self.strips}
        self.mutes = {n: False for n in self.strips}
        self.solos = {n: False for n in self.strips}
        # Loop recording is punch in / punch out against a transport that is
        # already running - the MPC owns the clock, so REC starts nothing. It
        # decides what D1-D7 mean, and the punches land on bar lines. See
        # docs/daw-interaction.md, "Recording a loop".
        #
        # So the state is "is the desk arming" plus "which strips are
        # rolling", the same shape maschine-hub keeps, not a mode.
        self.focus = self.strips[0]
        self.armed = False
        self.rolling = set()
        # What we believe Ardour's global record-enable is. See
        # set_session_record: the OSC path is a toggle, and we cannot read it
        # back over OSC - but the governor publishes what it IS in the region
        # header, so follow_ardour() reconciles the belief instead of
        # carrying it for ever.
        self.session_record = False
        self.record_sent = 0.0
        self.record_fixes = 0
        # Is the MPC playing? None until the first line of the export is
        # read, so the first observation is always an edge and Ardour is put
        # where it belongs whichever state the appliance came up in.
        self.mpc_playing = None
        self.roll_asked = 0.0
        # What the governor last said Ardour is doing. None means "it has not
        # said" - an older governor publishes neither field - and nothing is
        # asserted about a transport nobody has reported on.
        self.ardour_rolling = None
        self.ardour_record = None
        # The file browser, opened from the panel with SHIFT+NAVIGATE. This
        # process owns the cursor and the listing because it owns every other
        # piece of screen state; two owners of one cursor is how a screen and
        # a controller end up disagreeing about which row is selected. The hub
        # keeps one bit - is it open - and that decides where its keys point.
        self.browser = browserlib.Browser()
        self.files = False
        self.files_rows = []
        self.disk_request = DISK_REQUEST
        self.disk_status = DISK_STATUS
        self.disk_memory = DISK_MEMORY
        # The last status line consumed from the emulator, so a change can be
        # told from a repeat. Without it the answer to one load would be
        # re-applied to the screen every 10 ms and no later message could ever
        # be seen.
        self.disk_seen = None
        self.message = ""
        self.playhead = 0
        self.xruns = 0
        # --- what the jog points at ---
        #
        # One knob, four pages, four different things to move - so the target
        # cannot live in the knob, it has to live in the page. See jog().
        #
        # The EDIT cursor is in SAMPLES, like the playhead, because that is
        # what every position on the wire already is; converting at the edges
        # is what keeps a bar count from being compared against a sample count
        # somewhere in the middle.
        self.cursor = 0
        self.snap = self.SNAPS[0]
        # WAVE's two trim handles as fractions of the take, and which one the
        # jog and K1/K2 are holding. Fractions because the renderer draws them
        # that way and a take's length is not known until there is one.
        self.wave_trim = [0.0, 1.0]
        self.wave_handle = 0
        self.wave_zoom = 1.0
        self.wave_gain = 1.0
        # Which page WAVE was drilled into from, so backing out returns there
        # rather than to a default.
        self.drilled_from = None
        # --- the regions, as published by the Lua side -------------------
        #
        # THE ONLY THING THIS PROCESS KNOWS ABOUT THE AUDIO. The playlist
        # belongs to session-governor.lua; this is its mirror, re-read
        # whenever the file changes, and every region verb below addresses
        # it by the names it finds here rather than by names it invented.
        self.regions_path = regions
        self.regions = {}          # track -> [ {name,pos,len,fi,fo,gain} ]
        self.regions_stamp = None  # (mtime_ns, size) of the last file read
        self.regions_gen = 0
        # Where ARDOUR's transport is. EDIT and WAVE work in Ardour's
        # timeline, not the MPC's: the two free-run against each other by an
        # unknown constant, and a split at a cursor in the wrong coordinates
        # does not land slightly off, it lands in another part of the song.
        self.ardour_playhead = 0
        # The selected region, by NAME, on the focused lane. A name because
        # editing renames: a split makes two regions neither side named, so
        # an index would point at whatever moved into the slot.
        self.sel_region = None
        # Where the take started when WAVE was drilled into, so the trim
        # handles stay fractions of the ORIGINAL take. Without it each trim
        # would be a fraction of the already-trimmed region and the handles
        # could only ever eat inward.
        self.wave_base = None
        # Knob edits waiting to be sent. See defer(): a knob reports tens of
        # times a second and each report would otherwise be one queue line
        # and one region edit, so they settle first.
        self.deferred = {}
        # --- the FX page's place in the chain ----------------------------
        #
        # Which slot of the focused strip's chain the knobs and BYP act on.
        # One integer, reset when focus moves, because the chain it indexes
        # changes with it - a slot carried across a refocus would point at
        # whatever plugin happens to share its position.
        self.chains = load_chains() if chains is None else chains
        self.fx_slot = 0
        # What we believe each slot's bypass is, seeded from the chain
        # definition's own bypass flags - the state session-template builds.
        # Optimistic like the mutes: osc.Client is send-only, so believed
        # is all this can ever be.
        self.fx_bypass = {name: {i for i, s in enumerate(ch)
                                 if s.get("bypass")}
                          for name, ch in self.chains.items()}
        # Accumulated plugin parameter values, keyed (strip, slot, knob).
        # The OSC path takes an ABSOLUTE 0..1 value and the encoder reports
        # deltas, so somebody has to hold the running value - and it opens
        # at 0.5 because a send-only client cannot ask the plugin.
        self.fx_values = {}
        # --- the markers, as published by the Lua side -------------------
        #
        # (position, name), sorted, in ARDOUR's timeline like the regions:
        # they come off the same file and jumping to one is a /locate.
        self.markers = []

    # --- Ardour ---

    def ssid(self, name):
        return ardour_bindings.ssid(self.strips.index(name))

    def setup(self):
        for line in ardour_bindings.SETUP:
            parts = line.split()
            self.osc.send(parts[0], *[int(p) for p in parts[1:]])

    # The engine actions that are region work rather than mixer work. OSC
    # cannot express any of them - Ardour's surface has no "close this take"
    # or "lay that region again" - so they go to the session governor, which
    # holds the session open and has the Lua API. See loop-ops.lua.
    QUEUED = ("finalize", "repeat", "clear")

    def enqueue(self, action):
        """Append one engine action to the governor's queue, verbatim.

        VERBATIM is the point. The action strings are the wire format on both
        sides, so there is no second vocabulary to keep in step - this file
        has already shipped three bugs that were nothing but two halves
        disagreeing about a name (the knobs, the punch verbs, a renamed strip
        list), and each of them passed both sides' own tests.

        Opened per line so the governor can take the whole queue with a
        rename; a writer holding the fd open would keep appending into a file
        nobody reads any more.
        """
        try:
            with open(self.queue, "a") as f:
                f.write(action + "\n")
        except OSError:
            # A queue that cannot be written is a loop that will not repeat,
            # but it is not a reason to take the control process - and with
            # it the mixer and the panel - down.
            self.message = "NO QUEUE"

    def perform(self, action):
        """Turn one engine action string into Ardour calls."""
        parts = action.split()
        verb = parts[0]
        punch = ardour_bindings.RECORD["strip_punch"]
        if verb in ("arm", "record-start") and len(parts) > 1:
            lane = parts[1]
            if lane in self.strips:
                self.osc.send(punch, self.ssid(lane),
                              1 if verb == "record-start" else 0)
        elif verb == "disarm" and len(parts) > 1:
            if parts[1] in self.strips:
                self.osc.send(punch, self.ssid(parts[1]), 0)
        elif verb in self.QUEUED:
            self.enqueue(action)
        return action

    # --- the region channel ------------------------------------------------

    def poll_regions(self, path=None):
        """Re-read the published region list when it has changed.

        Cheap on the hot path: one stat per 10 ms tick, and the file is only
        read when its mtime or size moves. The governor republishes twice a
        second even when nothing was edited, because the header carries
        Ardour's transport position and that is the EDIT playhead.
        """
        path = path or self.regions_path
        try:
            info = os.stat(path)
        except OSError:
            return False
        stamp = (info.st_mtime_ns, info.st_size)
        if stamp == self.regions_stamp:
            return False
        try:
            with open(path) as f:
                text = f.read()
        except OSError:
            return False
        self.regions_stamp = stamp
        self.load_regions(text)
        return True

    def load_regions(self, text):
        """Parse one published frame. See session-governor.lua's publish()."""
        found = {}
        marks = []
        for line in text.splitlines():
            if line.startswith("#"):
                words = line[1:].split()
                kw = dict(zip(words[0::2], words[1::2]))
                # ARDOUR'S RATE WINS. Everything on the wire is samples, and
                # the two sides have to agree what a sample is worth or every
                # bar count, loop length and cursor position is out by the
                # ratio - which is exactly the bug this replaced.
                rate = int(kw.get("rate") or 0)
                if rate > 0:
                    self.transport.rate = rate
                self.ardour_playhead = int(kw.get("transport") or 0)
                self.regions_gen = int(kw.get("gen") or 0)
                # What Ardour's transport and record-enable ACTUALLY are.
                # Absent from an older governor, and absence is not "off":
                # follow_ardour() asserts nothing about a field nobody sent.
                if "rolling" in kw:
                    self.ardour_rolling = kw["rolling"] not in ("0", "")
                if "rec" in kw:
                    self.ardour_record = int(kw["rec"] or 0)
                continue
            parts = line.split("\t")
            # A marker is a three-field row on purpose: a daw-ctl older
            # than markers requires seven fields and skips these, so the
            # two sides can be deployed in either order.
            if len(parts) == 3 and parts[0] == "mark":
                try:
                    marks.append((int(parts[2]), parts[1]))
                except ValueError:
                    pass
                continue
            if len(parts) < 7:
                continue
            try:
                found.setdefault(parts[0], []).append({
                    "name": parts[1], "pos": int(parts[2]),
                    "len": int(parts[3]), "fade_in": int(parts[4]),
                    "fade_out": int(parts[5]), "gain": float(parts[6])})
            except ValueError:
                continue
        for rows in found.values():
            rows.sort(key=lambda r: (r["pos"], r["name"]))
        self.regions = found
        self.markers = sorted(marks)
        self.resync_selection()
        self.adopt_region_gain()
        return found

    def adopt_region_gain(self):
        """Let the published gain move WAVE's gain knob.

        This is the channel closing: NORM sends a verb and the Lua side
        decides the factor, so the only way the knob can show what actually
        happened is to read it back. Not while a gain edit of our own is
        still pending, or the knob would snap back to the old value between
        the hand moving and the edit landing.
        """
        r = self.selected()
        if self.page != "WAVE" or r is None:
            return
        if "gain %s" % r["name"] in self.deferred:
            return
        self.wave_gain = r["gain"]

    def lane_regions(self, track=None):
        return self.regions.get(track or self.focus, [])

    def selected(self):
        for r in self.lane_regions():
            if r["name"] == self.sel_region:
                return r
        return None

    def region_near(self, pos):
        """The region under `pos`, else the nearest one by start."""
        rows = self.lane_regions()
        if not rows:
            return None
        for r in rows:
            if r["pos"] <= pos < r["pos"] + r["len"]:
                return r
        return min(rows, key=lambda r: abs(r["pos"] - pos))

    def resync_selection(self):
        """Keep a selection across a republish, whatever got renamed.

        A split turns the selected region into two regions with new names,
        so holding the old name would leave the page with nothing selected
        immediately after the one edit most likely to be followed by
        another. Falling back to the region under the cursor puts the
        selection on the half the cut just made.
        """
        if self.selected():
            return
        near = self.region_near(self.cursor)
        self.sel_region = near["name"] if near else None
        # WAVE's handles are fractions of a take; a different take is a
        # different set of samples under them.
        if near is not None and self.page == "WAVE":
            self.wave_base = (near["pos"], near["len"])

    # Knob edits settle before they are sent.
    #
    # The MK1's encoders report an absolute angle many times a second, so a
    # quarter turn of the fade knob is dozens of deltas. One queue line each
    # would be dozens of region edits, dozens of republishes and dozens of
    # undo entries for one gesture - and the player would have to press UNDO
    # dozens of times to take it back. So the LAST value of a gesture is what
    # is sent, keyed by what it edits, and a press flushes whatever is
    # pending first so the order on the queue is the order of the hands.
    COMMIT_DELAY = float(os.environ.get("MPCPI_EDIT_COMMIT", "0.25"))

    def defer(self, key, line, now=None):
        now = time.monotonic() if now is None else now
        self.deferred[key] = (line, now + self.COMMIT_DELAY)
        return [line]

    def flush(self, now=None, force=False):
        now = time.monotonic() if now is None else now
        due = [k for k, (_, at) in self.deferred.items() if force or now >= at]
        out = []
        for key in sorted(due):
            line, _ = self.deferred.pop(key)
            self.enqueue(line)
            out.append(line)
        return out

    # --- region edits ------------------------------------------------------

    def region_op(self, line, message):
        """Send one region edit now, after anything a knob left pending."""
        self.flush(force=True)
        self.enqueue(line)
        self.message = message
        return [line]

    def no_region(self):
        # Naming which lane is empty beats a key that appears to do nothing,
        # which is indistinguishable from a key that has broken.
        self.message = "NO REGION ON %s" % self.focus
        return ["error no-region %s" % self.focus]

    def step_region(self, way):
        """browse_left / browse_right: the previous or next region.

        The cursor FOLLOWS the selection to the region's start. The EDIT
        window is drawn around the cursor, so a selection the cursor did not
        follow would be a bright region somewhere off screen - and every verb
        that acts at the cursor would then act somewhere the eye is not.
        """
        rows = self.lane_regions()
        if not rows:
            return self.no_region()
        names = [r["name"] for r in rows]
        if self.sel_region in names:
            i = names.index(self.sel_region) + (1 if way == "next" else -1)
            i = max(0, min(len(rows) - 1, i))
        else:
            i = 0 if way == "next" else len(rows) - 1
        self.sel_region = rows[i]["name"]
        self.cursor = rows[i]["pos"]
        self.message = "%s  %d/%d" % (self.sel_region, i + 1, len(rows))
        return ["region %s" % self.sel_region]

    def split_region(self):
        r = self.selected()
        if r is None:
            return self.no_region()
        # A cut outside the region is not a cut. Ardour accepts the call and
        # does nothing, so without this the button reports a split that never
        # happened - the one answer worse than refusing.
        if not (r["pos"] < self.cursor < r["pos"] + r["len"]):
            self.message = "CURSOR NOT IN %s" % r["name"]
            return ["error cursor-outside %s" % r["name"]]
        return self.region_op(
            "split %s %s %d" % (self.focus, r["name"], self.cursor),
            "SPLIT %s" % r["name"])

    def duplicate_region(self):
        r = self.selected()
        if r is None:
            return self.no_region()
        return self.region_op(
            "duplicate %s %s %d" % (self.focus, r["name"], self.cursor),
            "COPY %s" % r["name"])

    def erase_region(self):
        r = self.selected()
        if r is None:
            return self.no_region()
        # Let go of the name before the playlist does. The next publish will
        # pick a neighbouring region; holding a name that no longer exists
        # would leave the page selecting nothing until something else moved.
        self.sel_region = None
        return self.region_op("remove %s %s" % (self.focus, r["name"]),
                              "ERASED %s" % r["name"])

    def normalize_region(self):
        r = self.selected()
        if r is None:
            return self.no_region()
        return self.region_op("normalize %s %s" % (self.focus, r["name"]),
                              "NORM %s" % r["name"])

    def region_undo(self):
        """UNDO on EDIT and WAVE: the last region edit, put back.

        NOT Ardour's undo, which does not exist here: Session:undo is not
        bound in Lua on either the appliance's Ardour 8 or the build host's
        9 (measured - begin_reversible_command and add_stateful_diff_command
        are bound, so an edit can be pushed onto a history nothing in this
        process can ever pop). loop-ops.lua keeps an inverse-op stack
        instead, and this is the key that pops it.
        """
        return self.region_op("undo", "UNDO")

    # --- the FX chain's slot -----------------------------------------------

    def chain(self, track=None):
        return self.chains.get(track or self.focus, [])

    def no_chain(self):
        # Same reasoning as no_region: naming the empty lane beats a key
        # that appears to do nothing, which reads as a key that broke.
        self.message = "NO CHAIN ON %s" % self.focus
        return ["error no-chain %s" % self.focus]

    def step_slot(self, way):
        """browse_left / browse_right on FX: the previous or next slot."""
        ch = self.chain()
        if not ch:
            return self.no_chain()
        i = self.fx_slot + (1 if way == "next" else -1)
        self.fx_slot = max(0, min(len(ch) - 1, i))
        self.message = "%s %d/%d %s" % (
            self.focus, self.fx_slot + 1, len(ch),
            ch[self.fx_slot].get("name", "?"))
        return ["slot %d" % self.fx_slot]

    def toggle_bypass(self):
        """BYP: the focused slot, in and out of the signal path.

        Ardour's OSC has a path per direction rather than a toggle, which
        for once is the good shape: what is sent states the outcome, so a
        double-press cannot invert the belief the way /rec_enable_toggle
        can. The plugin id is the slot index + 1 - the chain is built from
        the same list this process reads, in order, so the two counts
        cannot disagree without the session builder disagreeing with its
        own input.
        """
        ch = self.chain()
        if not ch:
            return self.no_chain()
        book = self.fx_bypass.setdefault(self.focus, set())
        name = ch[self.fx_slot].get("name", "?")
        off = self.fx_slot not in book
        if off:
            book.add(self.fx_slot)
            self.osc.send("/strip/plugin/deactivate",
                          self.ssid(self.focus), self.fx_slot + 1)
        else:
            book.discard(self.fx_slot)
            self.osc.send("/strip/plugin/activate",
                          self.ssid(self.focus), self.fx_slot + 1)
        self.message = "%s %s" % (name, "BYP" if off else "ON")
        return ["byp %s %d %d" % (self.focus, self.fx_slot, 1 if off else 0)]

    # --- the markers --------------------------------------------------------

    def drop_marker(self):
        """MARK: a section marker, stamped by the side that owns the clock.

        The verb goes down the queue with NO position, the same shape as
        normalize: this process's playhead is the MPC's clock and Ardour's
        transport free-runs against it, so any position sent from here
        would be in the wrong coordinates by an unknown constant. The
        governor stamps the marker at Ardour's own transport sample and
        the published list brings it back within one drain.
        """
        return self.region_op("mark", "MARK BAR %d" % (
            self.ardour_playhead // (self.transport.samples_per_bar() or 1)
            + 1))

    def step_marker(self, way):
        """browse_left / browse_right on SONG: the neighbouring marker.

        A locate, like the jog: it moves Ardour's view and the MPC's clock
        is untouched. Strictly before / strictly after, off the position
        the governor last published, and the belief is advanced to the
        marker so a second press keeps walking rather than re-finding the
        same neighbour for two publish intervals.
        """
        if not self.markers:
            self.message = "NO MARKERS"
            return ["error no-markers"]
        here = self.ardour_playhead
        if way == "next":
            ahead = [m for m in self.markers if m[0] > here]
            target = ahead[0] if ahead else None
        else:
            behind = [m for m in self.markers if m[0] < here]
            target = behind[-1] if behind else None
        if target is None:
            self.message = "NO MARKER %s" % \
                ("AHEAD" if way == "next" else "BEFORE")
            return ["error no-marker %s" % way]
        pos, name = target
        self.ardour_playhead = pos
        self.osc.send("/locate", pos, 0)
        self.message = "MARKER %s" % name
        return ["locate %d" % pos]

    # --- take-level ERASE and UNDO -----------------------------------------

    def take_undo(self, what):
        """Discard the focused lane's loop. ERASE and UNDO on the LOOP page.

        One path, honestly: the engine has a single `clear`, so both keys
        take the take off the timeline and leave the captured audio on disk.
        The regions go because a lane whose engine state says idle while its
        repetitions are still laid ahead of the playhead goes on playing with
        no button left that means stop.
        """
        # ASK FIRST. The engine answers "clear LANE" for a lane that holds
        # nothing at all - it has no error for it - so this reported ERASED
        # on an empty lane and put a no-op on the queue. A key that claims
        # to have done something it did not is the failure this panel
        # already ships tests against.
        lane = self.engine.lanes.get(self.focus)
        if lane is None or (lane.state == "idle" and not lane.length_samples):
            self.message = "NO TAKE ON %s" % self.focus
            return ["error no-take %s" % self.focus]
        out = self.apply(self.engine.command("undo %s" % self.focus,
                                             self.playhead))
        if any(a.startswith("error") for a in out):
            self.message = "NO TAKE ON %s" % self.focus
        else:
            self.message = "%s %s" % (what, self.focus)
        return out

    # --- commands from the panel ---

    def command(self, line):
        parts = line.strip().split()
        if not parts:
            return []
        verb = parts[0]
        if verb == "page" and len(parts) > 1:
            self.page = parts[1].upper()
            return []
        if verb == "mode" and len(parts) > 1:
            self.mode = parts[1].upper()
            return []
        if verb == "gain" and len(parts) > 2:
            name, db = parts[1], float(parts[2])
            self.gains[name] = db
            self.osc.send("/strip/gain", self.ssid(name), db)
            self.message = "%s %.1f DB" % (name, db)
            return []
        if verb in ("mute", "solo") and len(parts) > 1:
            name = parts[1]
            book = self.mutes if verb == "mute" else self.solos
            book[name] = not book.get(name, False)
            self.osc.send("/strip/%s" % verb, self.ssid(name),
                          1 if book[name] else 0)
            return []
        # Encoders. The hub emits "knob <page> <target> <delta>", and
        # nothing here understood it: the line fell through to the loop
        # engine, which does not speak encoder, and every knob on the
        # mixer was silently dead. Found by the interaction tests, which
        # is the whole reason they exist - the routing test proved the
        # hub sends this, and the panel test proved the screen can draw
        # it, and neither could notice that nothing joins them.
        # The bar grid's tempo, when something other than the emulator knows
        # it. The export publishes it when it can read it out of the
        # sequencer; this is the way in for a project whose tempo the export
        # cannot see, and for the tests.
        if verb == "tempo" and len(parts) > 1:
            try:
                out = self.set_tempo(float(parts[1]))
            except ValueError:
                return ["error bad-tempo %s" % parts[1]]
            self.message = "TEMPO %.1f" % (self.transport.bpm or 0)
            return out
        if verb == "knob" and len(parts) > 3:
            page, target, delta = parts[1], parts[2], int(parts[3])
            return self.knob(page, target, delta)

        # LOOP RECORDING. maschine-hub has emitted these four verbs since the
        # button row was built, and nothing here understood a single one of
        # them: focus/arm/punch_in/punch_out all fell through to the loop
        # engine, which answered "unknown-command" to a string nobody read.
        # The panel's own self-test was green throughout - it proves the hub
        # SENDS them - so pressing REC and a strip button moved the screen
        # and recorded nothing. Same failure the knobs had, same lesson: two
        # green tests either side of a gap do not test the gap.
        if verb == "focus" and len(parts) > 1:
            return self.set_focus(parts[1])
        if verb == "arm" and len(parts) > 1:
            # "0"/"1" from the hub, which toggles its own copy of the state.
            return self.set_armed(parts[1] not in ("0", "off", "false"))
        if verb in ("punch_in", "punch_out") and len(parts) > 1:
            return self.punch(verb == "punch_in", parts[1])

        # THE JOG. maschine-hub has surface-gated the big knob to this verb
        # since the DAW jog was specified - MPC surface it is the DATA wheel,
        # DAW surface it is "jog %+d" - and nothing here understood the word,
        # so it fell through to the loop engine and came back as UNKNOWN
        # COMMAND JOG on every page. The panel half was built and reported as
        # built; the knob moved nothing on any page.
        if verb == "jog" and len(parts) > 1:
            return self.jog(int(parts[1]))
        # EDIT's snap, cycled rather than set: three values on one button.
        if verb == "snap":
            return self.cycle_snap()
        # WAVE is a DRILL-IN, not a page in the group row: you always open it
        # on something. SELECT opens it on the focused lane and closes it
        # again - the way in is also the way out, the same idiom
        # SHIFT+NAVIGATE already uses for the browser.
        #
        # THE WAY BACK CANNOT BE D8. That is the surface toggle and it is
        # never rebound; a drill-in whose exit was the toggle would put the
        # player on the MPC when they asked for the mixer.
        if verb in ("select", "back"):
            return self.drill(verb)

        # THE REGION VERBS. Every one of them was blocked on the same thing -
        # nothing published the region list - so the buttons were left
        # deliberately unbound rather than wired to a verb that would answer
        # UNKNOWN COMMAND. They address what poll_regions read, by name.
        #
        # The browse pair is page vocabulary, the same shape as ERASE and
        # UNDO below: the hub sends one word and the page decides what the
        # previous/next THING is. On FX it is a chain slot, on SONG a
        # marker, everywhere else the region selection the EDIT and WAVE
        # verbs act on.
        if verb == "region" and len(parts) > 1:
            if self.page == "FX":
                return self.step_slot(parts[1])
            if self.page == "SONG":
                return self.step_marker(parts[1])
            return self.step_region(parts[1])
        if verb == "byp":
            return self.toggle_bypass()
        if verb == "mark":
            return self.drop_marker()
        if verb == "split":
            return self.split_region()
        if verb == "duplicate":
            return self.duplicate_region()
        if verb == "norm":
            return self.normalize_region()
        # ERASE and UNDO mean "undo what THIS PAGE does". On EDIT and WAVE
        # that is the region under the hand; on the strips page it is the
        # take on the focused lane, which is the only thing that page makes.
        # One key that always undoes what you were just doing beats two keys
        # that each work on one page and report a fault on the other.
        if verb == "erase" and len(parts) == 1:
            if self.page in ("EDIT", "WAVE"):
                return self.erase_region()
            return self.take_undo("ERASED")
        if verb == "undo" and len(parts) == 1:
            if self.page in ("EDIT", "WAVE"):
                return self.region_undo()
            return self.take_undo("UNDO")

        # The file browser. One verb with a sub-verb rather than five top-level
        # words, because everything under it is meaningless unless the browser
        # is open and grouping says so on the wire.
        if verb == "files":
            return self.files_command(parts[1:])

        # anything else is loop-engine vocabulary
        return self.apply(self.engine.command(line, self.playhead))

    def apply(self, actions):
        out = []
        for a in actions:
            # An engine refusal is information the player needs. "rec"
            # with a stopped transport is legitimate - a loop lane needs
            # a bar grid to quantise to - but answering it with a screen
            # that does not move is indistinguishable from a dead pad.
            if a.startswith("error "):
                self.message = a[6:].replace("-", " ").upper()
                out.append(a)
            else:
                out.append(self.perform(a))
        return out

    # --- loop recording ---

    def set_focus(self, name):
        """One strip is focused; the page-level verbs act on it."""
        if name not in self.strips:
            self.message = "NO STRIP %s" % name
            return ["error no-strip %s" % name]
        self.focus = name
        # A new strip is a new chain; slot 3 of the old one is nothing on
        # this one. Bypass and parameter beliefs are keyed by strip, so
        # they keep; only the position resets.
        self.fx_slot = 0
        # Ardour has to agree about what is focused: /select/* - which is what
        # the FX page edits - addresses "the selected strip". If focus were
        # only a panel idea, the FX knobs would edit whichever strip was last
        # clicked in a GUI that, on this appliance, nobody is looking at.
        #
        # No deselect for the strip we came from: selection is single-valued,
        # so the new one replaces it, and an explicit 0 would just leave
        # /select/* addressing nothing.
        self.osc.send(ardour_bindings.RECORD["focus"], self.ssid(name), 1)
        self.message = "FOCUS %s" % name
        return ["focus %s" % name]

    def set_session_record(self, on):
        """Ardour's global record-enable, which is a TOGGLE, not a setter.

        /rec_enable_toggle is the whole API - the same one-way door as Lua's
        maybe_enable_record, which phase3-poc.lua found turns recording back
        OFF when called a second time. osc.Client is send-only, so the real
        state cannot be read back; we track what we sent and only send when
        it differs. A blind send per arm would disengage recording on every
        second press of REC, which on stage looks exactly like a dead take.

        The assumption this leaves is one line long and worth stating: the
        session starts with record disengaged, which is how session-template
        creates it and how Ardour opens one.
        """
        if on == self.session_record:
            return
        self.session_record = on
        # Stamp it, so follow_ardour() does not read a frame the governor
        # published before this toggle landed and "correct" it straight back.
        self.record_sent = time.monotonic()
        self.osc.send(ardour_bindings.RECORD["session_arm"])

    def set_armed(self, on):
        if on == self.armed:
            return []          # idempotent, because the toggle below is not
        self.armed = on
        out = []
        if not on:
            # "REC again disarms and clears any rolling state." The hub drops
            # its own rolling set on that same press, so if we did not close
            # these here nothing ever would: they would keep writing to disk
            # with no button left that means stop. Still bar-quantised - one
            # bar late is a usable take, an off-grid one is not, and a panic
            # that ruins the take is not much of a rescue.
            for name in sorted(self.rolling, key=self.strips.index):
                out.extend(self.apply(self.engine.command(
                    "punch_out %s" % name, self.playhead)))
            self.rolling.clear()
        self.set_session_record(on)
        self.message = "ARMED" if on else "DISARMED"
        return out

    def punch(self, into, name):
        if name not in self.engine.lanes:
            # D1-D7 covers the sends and, on some desks, the master: strips,
            # not lanes. Saying so beats a button that reads as broken.
            self.message = "NO LANE %s" % name
            return ["error no-lane %s" % name]
        if not self.armed:
            # The hub only punches while armed, but the FIFO is a public
            # protocol that anything can write to. Recording without REC lit
            # is the one surprise a looper must never spring.
            self.message = "NOT ARMED"
            return ["error not-armed %s" % name]
        # Punch-in IS the engine's "rec": arm now, start on the next bar. It
        # is reused rather than given a synonym so there is one quantised
        # path - and one set of tests - behind both the pads and the buttons.
        out = self.apply(self.engine.command(
            ("rec %s" if into else "punch_out %s") % name, self.playhead))
        if not any(a.startswith("error") for a in out):
            if into:
                self.rolling.add(name)
            else:
                self.rolling.discard(name)
            self.message = "PUNCH %s %s" % ("IN" if into else "OUT", name)
        return out

    # --- the file browser ---

    def files_command(self, args):
        """The panel's browser gestures. See control_map.FILES_BUTTONS.

        Every one of them clears the message first. A refusal - "NOT MOUNTED",
        "NOT A DISK" - is about the row you were standing on, and leaving it up
        after you have moved somewhere else makes it read as a refusal of the
        new row, which is worse than saying nothing.
        """
        verb = args[0] if args else ""
        self.message = ""
        if verb == "open":
            self.files = True
        elif verb == "close":
            self.files = False
        elif verb == "move" and len(args) > 1:
            self.browser.move(int(args[1]))
        elif verb == "up":
            if not self.browser.up():
                # Already at the sources. Saying so beats a key that does
                # nothing, which is indistinguishable from a key that broke.
                self.message = "AT THE TOP"
        elif verb in ("into", "enter"):
            row = self.browser.current()
            # browse_right NAVIGATES and refuses to load; ENTER loads. A
            # right-arrow that swaps the media under a running instrument is a
            # foot-gun, and the two keys are one finger apart.
            if verb == "into" and row is not None and row.kind == "disk":
                self.message = "ENTER TO LOAD"
            else:
                kind, arg = self.browser.enter()
                if kind == "load":
                    self.files_rows = self.browser_rows()
                    return self.load_disk(arg)
                if kind == "none":
                    self.message = arg.upper()
        else:
            return ["error no-files %s" % verb]
        self.files_rows = self.browser_rows()
        return []

    def browser_rows(self):
        """The listing, flattened into what the renderer draws.

        SNAPSHOTTED, not listed on demand: write_state runs every 10 ms, and
        walking a directory at 100 Hz to redraw a menu that has not changed
        would keep a USB stick awake for as long as the browser is open. The
        rows can only change when a browser command moves, so that is when
        they are taken.
        """
        return [{"name": e.name, "kind": e.kind, "exact": e.exact,
                 "size": e.size, "present": getattr(e, "present", True)}
                for e in self.browser.rows()]

    def _publish(self, path, text):
        """Write-then-rename, so a reader can never see half a path."""
        tmp = "%s.%d.tmp" % (path, os.getpid())
        with open(tmp, "w") as f:
            f.write(text + "\n")
        os.replace(tmp, path)

    def load_disk(self, path):
        """Ask the emulator for this image, and remember the choice.

        Two files, because they answer two different questions. The REQUEST is
        what the drive should hold now and lives on tmpfs, where a stale one
        after a crash would be a lie. The MEMORY is what it should hold after a
        power cycle and has to survive one, so it goes on the card.

        The screen says LOADING, not LOADED. All that has happened here is that
        a path was written to a file; whether a disk went in is the emulator's
        answer, and poll_disk picks it up a frame or two later. Reporting the
        keypress as the outcome is how the panel came to claim loads that never
        happened.
        """
        try:
            self._publish(self.disk_request, path)
        except OSError as e:
            self.message = "CANNOT REQUEST DISK"
            return ["error disk-request %s" % e]
        self.message = "LOADING %s" % os.path.basename(path).upper()
        return ["load %s" % path]

    # --- encoders ---

    # dB per encoder UNIT - and a unit is not a detent.
    #
    # This was 0.5, written as "8 detents is 4 dB", which would be right if the
    # hardware sent one count per detent. It does not: mk1_encoders decodes an
    # ABSOLUTE angle normalised to FULL_TURN = 1000 units per revolution, and
    # the delta is however many of those units the knob moved between reports.
    # So 0.5 dB/unit meant one revolution swept 500 dB across a fader whose
    # entire range is 25.3 dB (-19.3 to +6.0) - the whole range crossed in 51
    # units, five percent of one turn. Unusable, and the reason the knobs felt
    # like they were on a hair trigger.
    #
    # 25.3 dB over two revolutions is 0.0126 dB/unit. Two turns end to end is a
    # normal feel for an endless encoder on a fader, and with the tracker's
    # deadband of 3 units the finest step is 0.038 dB.
    KNOB_DB_STEP = float(os.environ.get("MPCPI_KNOB_DB_STEP", "0.0126"))

    # Same arithmetic for a normalised 0..1 plugin parameter: 0.01 per unit
    # crossed the whole parameter in a tenth of a turn. 1.0 over two
    # revolutions is 0.0005.
    KNOB_FX_STEP = float(os.environ.get("MPCPI_KNOB_FX_STEP", "0.0005"))

    def knob(self, page, target, delta):
        if page == "LOOP":
            # One strips page. MIX was the same geometry drawn by the same
            # function with a flag, so it was merged rather than maintained.
            if target not in self.gains:
                return ["error no-strip %s" % target]
            db = self.gains[target] + delta * self.KNOB_DB_STEP
            db = max(-19.3, min(6.0, db))
            self.gains[target] = db
            self.osc.send("/strip/gain", self.ssid(target), db)
            self.message = "%s %.1f DB" % (target, db)
            return ["gain %s %.1f" % (target, db)]
        if page == "FX":
            # Two fixes with one shape. The plugin id was hardcoded to 1,
            # so every knob edited the first slot whatever chip the browse
            # keys had focused; and the DELTA went on the wire as the
            # value, so a turn set the parameter to within a whisker of
            # zero - the path takes an absolute 0..1 and the encoder
            # reports movement, and nothing held the running value between
            # them. It is held here now, per (strip, slot, knob), opening
            # at 0.5 because a send-only client cannot ask the plugin
            # where it really is.
            ch = self.chain()
            if not ch:
                return self.no_chain()
            key = (self.focus, self.fx_slot, int(target))
            value = self.fx_values.get(key, 0.5)
            value = max(0.0, min(1.0, value + delta * self.KNOB_FX_STEP))
            self.fx_values[key] = value
            self.message = "%s P%d %.2f" % (
                ch[self.fx_slot].get("name", "FX"), int(target) + 1, value)
            self.osc.send("/strip/plugin/parameter",
                          self.ssid(self.focus), self.fx_slot + 1,
                          int(target) + 1, value)
            return ["fx %s %.4f" % (target, value)]
        if page == "SONG":
            if target == "0":
                return self.scrub(delta)
            return ["view %s %+d" % (target, delta)]
        if page == "WAVE":
            # K1/K2 are the two trim handles, K3 zoom, K4 gain. Turning a
            # trim knob also SELECTS that handle, so the jog picks up
            # whichever one the hand last touched without a separate key to
            # choose with.
            if target in ("0", "1"):
                return self.trim(int(target), delta * self.KNOB_FX_STEP)
            if target == "2":
                # ZOOM IS THE ONE KNOB HERE THAT TOUCHES NO AUDIO. It is how
                # much of the take the 253 pixels show, so it commits nothing.
                self.wave_zoom = max(1.0, min(64.0, self.wave_zoom *
                                              (1.0 + delta * 0.002)))
                self.message = "WAVE ZOOM %.1fX" % self.wave_zoom
                return ["wave zoom %.2f" % self.wave_zoom]
            if target == "3":
                self.wave_gain = max(0.0, min(4.0, self.wave_gain +
                                              delta * self.KNOB_FX_STEP * 2))
                self.message = "WAVE GAIN %.2f" % self.wave_gain
                return self.commit_gain(self.wave_gain)
            return ["error no-knob WAVE %s" % target]
        if page == "EDIT":
            # K1 slides the region, K2/K3 are its fades, K4 its gain - all
            # four on the SELECTED region, and all four deferred, because a
            # knob reports far faster than a playlist wants to be edited.
            r = self.selected()
            if r is None:
                return self.no_region()
            if target == "0":
                return self.slide(r, delta)
            if target in ("1", "2"):
                return self.fade(r, int(target) - 1, delta)
            if target == "3":
                gain = max(0.0, min(4.0,
                                    r["gain"] + delta * self.KNOB_FX_STEP * 2))
                r["gain"] = gain
                self.message = "%s GAIN %.2f" % (r["name"], gain)
                return self.defer("gain %s" % r["name"],
                                  "gain %s %s %.4f" % (self.focus, r["name"],
                                                       gain))
            return ["error no-knob EDIT %s" % target]
        return ["error no-knob %s" % page]

    # One turn of a knob is one bar of slide. The encoder reports 1000 units
    # per revolution (see KNOB_DB_STEP), and a bar per turn is the move this
    # knob is for - the sample-accurate one is the jog's job on WAVE.
    def slide(self, region, delta):
        bar = self.transport.samples_per_bar() or self.transport.rate
        pos = max(0, region["pos"] + int(delta * bar / 1000.0))
        region["pos"] = pos
        self.message = "%s AT %.2f" % (region["name"], pos / float(bar) + 1)
        return self.defer("move %s" % region["name"],
                          "move %s %s %d" % (self.focus, region["name"], pos))

    def fade(self, region, which, delta):
        key = "fade_in" if which == 0 else "fade_out"
        # A fade is a length in samples, held as a fraction of the region so
        # one turn means the same gesture on a two-bar take and a ten-bar one.
        frac = region[key] / float(max(1, region["len"]))
        frac = max(0.0, min(1.0, frac + delta * self.KNOB_FX_STEP))
        region[key] = int(frac * region["len"])
        self.message = "%s %s %.0f%%" % (
            region["name"], "FADE IN" if which == 0 else "FADE OUT",
            frac * 100)
        verb = "fadein" if which == 0 else "fadeout"
        return self.defer("%s %s" % (verb, region["name"]),
                          "%s %s %s %d" % (verb, self.focus, region["name"],
                                           region[key]))

    def commit_gain(self, gain):
        r = self.selected()
        if r is None:
            return ["wave gain %.2f" % gain]
        r["gain"] = gain
        return self.defer("gain %s" % r["name"],
                          "gain %s %s %.4f" % (self.focus, r["name"], gain))

    def commit_trim(self):
        """Turn WAVE's two handles into one trim of the take.

        Against the bounds the take had WHEN THE PAGE WAS OPENED, not against
        what the last trim left: cumulative fractions can only ever eat
        inward, so a handle pulled back out would never restore the audio it
        just hid. Ardour clamps the result to what the source actually holds.
        """
        r = self.selected()
        if r is None or self.wave_base is None:
            return []
        pos, length = self.wave_base
        t0, t1 = self.wave_trim
        start = pos + int(t0 * length)
        end = pos + int(t1 * length)
        if end - start < 1:
            return []
        return self.defer("trim %s" % r["name"],
                          "trim %s %s %d %d" % (self.focus, r["name"],
                                                start, end))

    # --- the jog, and the pages it points at -------------------------------

    # EDIT's snap, in the order the button cycles. The spec's three values,
    # and BAR first because a loop lands on bars and that is the cut you
    # make most.
    SNAPS = ("BAR", "BEAT", "OFF")

    def snap_samples(self):
        """How far one jog detent moves the EDIT cursor.

        OFF is not "no snap unit" - the cursor still has to move by
        SOMETHING per detent, and a sample per detent would need forty
        thousand turns to cross a bar. It is a sixteenth, which is the
        finest musical unit the panel can show, and the reason the label
        says OFF rather than 1/16 is that it is the grid that is off: the
        cursor is no longer being rounded onto one.
        """
        bar = self.transport.samples_per_bar()
        if not bar:
            return 0
        if self.snap == "BAR":
            return bar
        beat = bar // max(1, self.transport.beats_per_bar)
        return beat if self.snap == "BEAT" else max(1, beat // 4)

    def cycle_snap(self):
        i = (self.SNAPS.index(self.snap) + 1) % len(self.SNAPS)
        self.snap = self.SNAPS[i]
        self.message = "SNAP %s" % self.snap
        return ["snap %s" % self.snap]

    def trim(self, handle, amount):
        """Move one WAVE trim handle, and keep the two in order.

        Clamped against each other, not just against 0..1: a start handle
        dragged past the end produces an inside-out region that Ardour will
        accept and no one can see, which is a worse outcome than a handle
        that stops.
        """
        self.wave_handle = handle
        t = list(self.wave_trim)
        t[handle] = max(0.0, min(1.0, t[handle] + amount))
        if t[0] > t[1]:
            t[handle] = self.wave_trim[handle]
        self.wave_trim = t
        self.message = "TRIM %s %.3f" % ("START" if handle == 0 else "END",
                                         t[handle])
        # ...and the audio follows the handle. "State only" was what these
        # knobs did for as long as no region list existed to point them at:
        # real, clamped, drawn, and touching nothing.
        self.commit_trim()
        return ["trim %d %.4f" % (handle, t[handle])]

    def drill(self, verb):
        """Open WAVE on the focused lane, or come back out.

        "back" only ever leaves; "select" toggles. Where it returns TO is
        remembered rather than defaulted, because a drill-in that always
        dropped you on MIX would lose the page you were working on - which
        is the same reason the FILES overlay leaves self.page alone.
        """
        if self.page == "WAVE":
            self.page = self.drilled_from or "LOOP"
            self.drilled_from = None
            self.message = ""
            return ["page %s" % self.page]
        if verb == "back":
            # Nothing to back out of. Not an error: BACK on a top-level page
            # is a key with no job here, and this panel does not shout about
            # those - see jog() on MIX.
            return []
        self.drilled_from = self.page
        self.page = "WAVE"
        # A fresh take is a fresh trim. Carrying the last lane's handles onto
        # a different lane would silently apply one take's edit points to
        # another's audio.
        self.wave_trim = [0.0, 1.0]
        self.wave_handle = 0
        # WHICH take, and what its bounds are: the handles are fractions of
        # this, for as long as the drill-in lasts. Selection comes from the
        # published list, so opening WAVE on a lane with nothing recorded
        # says so rather than presenting handles over nothing.
        self.sel_region = None
        self.resync_selection()
        r = self.selected()
        if r is None:
            self.wave_base = None
            self.message = "NO TAKE ON %s" % self.focus
        else:
            self.wave_base = (r["pos"], r["len"])
            self.wave_gain = r["gain"]
            self.message = "WAVE %s %s" % (self.focus, r["name"])
        return ["page WAVE"]

    def scrub(self, delta):
        """SONG's scrub, off the jog and K1 both.

        Snapped to the bar, and it moves ARDOUR'S VIEW, not the clock: the
        MPC owns the transport, so this is a locate and the drums keep
        playing through it.

        In ARDOUR'S coordinates, where it used to move this process's
        mirror of the MPC's clock. The markers and sections on this page
        come off the published list in Ardour's timeline, and a playhead
        scrubbed in another clock's coordinates sits outside the section
        it is playing by the offset between the two - it also snapped
        straight back on the next transport poll, which rewrites the
        MPC-clock mirror every 10 ms. The scrub advances the same belief
        the governor's publish reconciles, so what the knob moves is what
        the page draws.
        """
        step = self.transport.samples_per_bar()
        if not step:
            self.message = "NO TEMPO YET"
            return ["error no-tempo"]
        self.ardour_playhead = max(0, self.ardour_playhead + delta * step)
        self.osc.send("/locate", self.ardour_playhead, 0)
        self.message = "BAR %d" % (self.ardour_playhead // step + 1)
        return ["locate %d" % self.ardour_playhead]

    def jog(self, delta):
        """One knob, four pages, four things to move.

        THE TARGET LIVES IN THE PAGE, not in the knob. The master-knob
        handler in maschine-hub used to end with a hardcoded "master %+d",
        so the moment a second DAW target existed the jog would have moved
        the master fader instead of the cursor; the same mistake on this
        side would be a single verb that always meant the playhead.
        """
        # Defensive: the hub routes the wheel to the browser itself while a
        # listing is up, so this should not arrive. If it ever does, the
        # listing is what is under the hand and moving the playhead behind it
        # would be the surprise.
        if self.files:
            self.browser.move(delta)
            self.files_rows = self.browser_rows()
            return []
        if self.page == "SONG":
            return self.scrub(delta)
        if self.page == "EDIT":
            step = self.snap_samples()
            if not step:
                self.message = "NO TEMPO YET"
                return ["error no-tempo"]
            self.cursor = max(0, self.cursor + delta * step)
            if self.snap != "OFF":
                # SNAP means the cursor lands ON the grid, not that it moves
                # by a grid step from wherever it happened to be. Stepping
                # alone kept whatever offset the cursor picked up from
                # following a region's start, so a "bar" cut could land
                # anywhere inside a bar.
                self.cursor = (self.cursor // step) * step
            bar = self.transport.samples_per_bar()
            self.message = "CURSOR %.2f  SNAP %s" % (
                self.cursor / float(bar) + 1, self.snap)
            return ["cursor %d" % self.cursor]
        if self.page == "WAVE":
            # Sample-accurate, so the detent is the finest move on the panel
            # - this is the knob you reach for after the trim knob has got
            # you close.
            return self.trim(self.wave_handle,
                             delta / float(self.WAVE_JOG_DIVISOR))
        # MIX: nothing, by specification. Not an error - a knob that has no
        # job on this page is not a fault, and saying UNKNOWN COMMAND about
        # it is how a working panel comes to look broken.
        return []

    # A jog detent on WAVE, as a fraction of the take. One turn of the knob
    # (WHEEL_UNITS_PER_STEP-scaled by the hub) crosses about a fiftieth of
    # it, which is the "last few samples" move the trim knob cannot make.
    WAVE_JOG_DIVISOR = 2000.0

    # --- the loop ---

    def poll_transport(self, path=TRANSPORT):
        """One line of the emulator's transport export. See its header.

        Three fields for years - playing, elapsed ms, emulated seconds - and
        a fourth, the sequencer's tempo, only when the export knows where to
        read it. Parsed by POSITION with a tolerant tail rather than by an
        exact unpack, because the appliance's emulator and this process are
        deployed as separate files and one of them is always newer.
        """
        try:
            with open(path) as f:
                fields = f.read().split()
            playing, elapsed_ms = int(fields[0]), int(fields[1])
        except (OSError, ValueError, IndexError):
            return False
        if len(fields) > 3:
            try:
                self.set_tempo(float(fields[3]))
            except ValueError:
                pass
        # THE PLAYHEAD FIRST, then the grid that is anchored to it. This ran
        # the other way round, so the bar anchor was computed against the
        # PREVIOUS poll's playhead: every next_bar_sample() came back one
        # tick early and jittered by the poll interval, and a "four bar" take
        # was four bars give or take ten milliseconds - measurably not a bar
        # multiple, which is the one property the whole punch path is for.
        # Both quantities are exact functions of elapsed_ms, so in this order
        # the anchor is exactly playhead - (playhead mod bar).
        previous = self.playhead
        self.playhead = int(elapsed_ms * self.transport.rate / 1000.0)
        self.transport.update_from_export(playing, elapsed_ms, self.playhead)
        out = []
        if self.playhead < previous and self.mpc_playing:
            out = self.rewound(previous)
        out += self.follow_transport(bool(playing))
        return bool(playing)

    def rewound(self, previous):
        """The MPC's clock went backwards. Musical time is discontinuous.

        The export counts milliseconds since PLAY, so STOP and PLAY START
        both reset it - and both do so one frame BEFORE the playing flag
        drops, which is what makes this its own case rather than part of the
        stop below. Measured on the appliance: 6206 ms to 30 ms across a
        press of STOP, with `playing` still 1 on that frame.

        Anything recording has to close on the last bar line the OLD clock
        passed, not on a playhead that has already jumped to a second and a
        half. Without that a take is closed against a start sample now in the
        future, comes out shorter than a bar, and is discarded as a mis-hit -
        the whole take, silently, at the moment the player pressed stop.
        """
        out = self.apply(self.engine.close_open_takes(previous))
        self.rolling.clear()
        self.engine.rebase(previous - self.playhead)
        return out

    # --- Ardour follows -----------------------------------------------------

    def set_tempo(self, bpm):
        """The bar grid's only free variable, and it must be the MPC's.

        Everything else in the punch path is exact arithmetic off a shared
        hardware clock; the tempo is the one number that has to come from
        somewhere. When the emulator publishes it, it wins - a bar grid at a
        tempo the drums are not playing quantises punches to lines that are
        not there, which is worse than not quantising at all.
        """
        if not bpm or bpm <= 0:
            return []
        if self.transport.bpm and abs(self.transport.bpm - bpm) < 0.05:
            return []
        self.transport.bpm = bpm
        return ["tempo %.1f" % bpm]

    def follow_transport(self, playing):
        """Roll Ardour behind the MPC, and only behind it.

        THE TRANSPORT BELONGS TO THE MPC. This is not a control - no button
        reaches it - it is the consequence of what the emulator's export
        says, which is the whole of "Ardour follows" (docs/daw-interaction
        .md, "Recording a loop"). Nothing did this at all: a capture needs a
        rolling transport, so every punch that reached Ardour wrote to a
        timeline sitting still at sample 0, and loop recording could not
        produce a take from the panel however the buttons behaved.

        Edge-triggered, because the roll is a request and re-requesting one
        Ardour is already honouring is noise. The Lua side guards it with
        transport_rolling() anyway, and the watchdog below covers the case
        this misses - a governor that restarted under a playing MPC.
        """
        if playing == self.mpc_playing:
            return []
        self.mpc_playing = playing
        if playing:
            self.enqueue("transport roll")
            self.roll_asked = time.monotonic()
            return ["transport roll"]
        # A STOP ENDS THE TAKES TOO. Ardour drops a rec-enabled lane's
        # capture when the transport stops, so a lane left rolling here
        # would come back as an unclaimed region and be swallowed by the
        # next finalize on that lane. Close them on the last bar line that
        # passed - the engine owns that arithmetic - and only then stop.
        out = self.apply(self.engine.close_open_takes(self.playhead))
        self.rolling.clear()
        self.enqueue("transport stop")
        return out + ["transport stop"]

    # How long to wait before believing what the governor published about
    # Ardour, rather than what we last sent it. One publish is 500 ms and a
    # punch-out's stop-and-reroll is 65-110 ms, so two seconds is several
    # frames clear of both.
    FOLLOW_SETTLE_S = 2.0
    # How many times to correct the record-enable before giving up. A
    # toggle is the only control there is, so an Ardour that refuses to
    # engage would otherwise be toggled at 0.5 Hz for ever - which on a
    # rolling transport means a stream of junk captures. Three corrections
    # is generous for a state that normally agrees on the next frame.
    RECORD_FIXES_MAX = 3

    def follow_ardour(self, now):
        """Assert the JOIN: the MPC is playing, so Ardour must be moving.

        Two green tests either side of a gap do not test the gap, and this
        gap has an observer - the governor publishes `rolling` and `rec` in
        the region header, so what Ardour is actually doing is readable
        rather than merely believed. What that buys:

          * a governor that restarted while the MPC was playing comes back
            to a stopped transport, and the edge-triggered roll above has
            already been sent, so nothing would ever roll it again;
          * the session record-enable is a TOGGLE with no setter, and Ardour
            drops it itself whenever the transport stops while recording -
            which is exactly what closing a take does. A belief that has
            drifted turns the next press of REC into a silent disarm.
        """
        out = []
        if self.ardour_rolling is False and self.mpc_playing and \
                now - self.roll_asked > self.FOLLOW_SETTLE_S:
            self.roll_asked = now
            self.enqueue("transport roll")
            out.append("transport roll")
        if self.ardour_record is None:
            return out
        observed = self.ardour_record > 0
        if observed == self.session_record:
            self.record_fixes = 0
            return out
        if now - self.record_sent <= self.FOLLOW_SETTLE_S:
            return out
        if self.record_fixes >= self.RECORD_FIXES_MAX:
            return out
        self.record_fixes += 1
        # Adopt the truth FIRST, so the toggle below is sent against what
        # Ardour is rather than against what we hoped.
        self.session_record = observed
        self.set_session_record(self.armed)
        out.append("record %d" % (1 if self.armed else 0))
        return out

    def poll_disk(self):
        """Turn the emulator's answer about the drive into a screen message.

        Only on CHANGE. The status file keeps its last line forever, so
        applying it every tick would nail one answer to the status line and
        make every later message - a level readout, a refusal - invisible.

        A load the player did not ask for still gets reported: the emulator
        seeds the drive from the remembered choice at startup, and "LOADED
        BEAT02.IMG" on the first screen is exactly the confirmation that the
        appliance came back where it was left.
        """
        try:
            with open(self.disk_status) as f:
                line = f.read().strip()
        except OSError:
            return None
        if not line or line == self.disk_seen:
            return None
        self.disk_seen = line
        verb, _, rest = line.partition(" ")
        if verb == "ok":
            self.message = "LOADED %s" % os.path.basename(rest).upper()
            # REMEMBER ONLY WHAT LOADED. Writing the choice at keypress time
            # instead put refused images into the boot seed: one ENTER on a
            # file the drive cannot read and every subsequent boot came up
            # with an empty drive and an error on the status line, with no
            # way back except picking something else. A power cycle must not
            # be able to inherit a failure.
            #
            # A failure to remember is not a failure to load - the disk is in
            # the drive either way - so this reports and carries on.
            try:
                self._publish(self.disk_memory, rest)
            except OSError as e:
                print("daw-ctl: cannot remember disk choice: %s" % e,
                      file=sys.stderr)
        else:
            # The emulator's own words, not ours. "NOT A FLOPPY IMAGE" from
            # the drive is worth more than a generic refusal invented here.
            self.message = rest.upper()[:40] or "DISK FAILED"
        return line

    def tick(self, now=None):
        self.poll_disk()
        self.poll_regions()
        # Knob edits that have settled go out here, so one gesture is one
        # region edit and one undo entry rather than dozens of each.
        out = self.flush(now)
        # ...and then what the governor said Ardour is doing, against what
        # this process asked it to do. poll_regions() above is what makes
        # that observable, so it has to come after it.
        out += self.follow_ardour(now if now is not None else time.monotonic())
        return out + [self.perform(a) for a in self.engine.tick(self.playhead)]

    # Fader position from dB. This was hardcoded to 0.8 for every strip,
    # so the readout moved and the fader graphic never did: the mixer
    # showed nine identical faders whatever the levels were. Linear in dB
    # across the strip's range - not Ardour's exact taper, but monotonic
    # and honest, which is what a 28px column can convey.
    GAIN_MIN_DB = -19.3
    GAIN_MAX_DB = 6.0

    def fader(self, db):
        span = self.GAIN_MAX_DB - self.GAIN_MIN_DB
        return max(0.0, min(1.0, (db - self.GAIN_MIN_DB) / span))

    # The panel's loop vocabulary is not the engine's. daw_ui draws "rec",
    # "dub", "play" and "armed"; the engine thinks in "recording" and
    # "looping". The state went out raw, so a recording lane arrived at the
    # screen as "recording", matched none of the drawing cases and rendered
    # as an ordinary idle column - at the one moment the screen exists for.
    # Translating here rather than in daw_ui keeps the engine's words out of
    # the renderer, which has no business knowing them.
    LANE_UI_STATE = {"armed": "armed", "recording": "rec", "looping": "play"}

    def lane_ui(self, lane):
        state = self.LANE_UI_STATE.get(lane.state, lane.state)
        return "dub" if (state == "rec" and lane.layer) else state

    def edit_lanes(self, bar):
        """The published regions, as the EDIT renderer's stacked lanes.

        Only lanes that HOLD something, plus the focused one whether it does
        or not. The renderer divides the body by the number of lanes, so
        listing all five when one has been recorded would draw five slivers
        and no waveform; the focused lane is always there because its tag is
        how the page says which lane the verbs will act on.
        """
        out = []
        for name in self.strips:
            rows = self.regions.get(name, [])
            if not rows and name != self.focus:
                continue
            out.append({
                # Two characters is all the gutter has: LOOP1 -> L1, so the
                # five lanes are told apart rather than all reading "LO".
                "tag": (name[:1] + name[-1:]).upper(),
                "sel": name == self.focus,
                "regions": [{"name": r["name"], "start": r["pos"] / float(bar),
                             "len": r["len"] / float(bar),
                             "fade_in": r["fade_in"] / float(max(1, r["len"])),
                             "fade_out": r["fade_out"] / float(max(1,
                                                                  r["len"])),
                             "gain": r["gain"],
                             "sel": (name == self.focus and
                                     r["name"] == self.sel_region)}
                            for r in rows],
            })
        return out

    def ui_state(self):
        lanes = []
        for name in self.strips[:8]:
            lane = self.engine.lanes.get(name)
            if lane is None or lane.state == "idle":
                continue
            spb = self.transport.samples_per_bar() or 1
            played = max(0, self.playhead - (lane.start_sample or 0))
            bar = (played // spb) % max(1, lane.bars)
            # Bars remaining is the number the design gives the biggest
            # glyphs on the screen, so it has to be the number the player is
            # actually waiting on: bars until the punch lands, whichever
            # punch that is. Only a lane that is looping is counting through
            # its own length.
            if lane.state == "armed":
                remaining = -(-(lane.start_sample - self.playhead) // spb)
            elif lane.stop_at is not None:
                remaining = -(-(lane.stop_at - self.playhead) // spb)
            else:
                remaining = lane.bars - bar
            lanes.append({
                "name": name, "state": self.lane_ui(lane), "bars": lane.bars,
                "bar": bar, "phase": (played % spb) / spb,
                "bars_remaining": max(0, int(remaining)),
                "level": 0.0,
            })
        st = {
            "page": self.page, "mode": self.mode,
            "playing": self.transport.playing,
            "recording": sum(1 for l in self.engine.lanes.values()
                             if l.state == "recording"),
            # What the loop-record panel needs and could not see: which strip
            # the verbs act on, whether REC is lit, and which strips are
            # writing. Names, not indices - the same words the commands use,
            # so a rename cannot make these agree with the wrong column.
            "focus": self.focus, "armed": self.armed,
            "rolling": [n for n in self.strips if n in self.rolling],
            "xruns": self.xruns, "message": self.message,
            "lanes": lanes,
            "mixer": [{"name": n,
                       "gain": self.fader(self.gains.get(n, 0.0)),
                       "db": "%.1f" % self.gains.get(n, 0.0),
                       "level": 0.0, "peak": 0.0,
                       "mute": self.mutes.get(n, False),
                       "solo": self.solos.get(n, False)}
                      for n in self.strips],
            "master": {"name": "MSTR", "db": "0.0", "gain": 0.85,
                       "level_l": 0.0, "level_r": 0.0},
        }
        # THE PAGES THE JOG POINTS AT have to report where their cursor is, or
        # turning the knob moves a number nobody can see - and now they carry
        # the REGIONS too, straight from what the Lua side published.
        #
        # IN ARDOUR'S COORDINATES, not the MPC's. The playhead drawn here is
        # Ardour's transport as published, not this process's own count of the
        # emulator's elapsed milliseconds: the two free-run against each other
        # by an unknown constant (loop-ops.lua ignores daw-ctl's positions for
        # that reason), and a page that drew regions on one clock and its
        # cursor on the other would cut in the wrong place while looking right.
        bar = self.transport.samples_per_bar() or 1
        st["edit"] = {
            "snap": self.snap,
            # The renderer's window and playhead are in BARS; the cursor is
            # kept in samples for the same reason the playhead is.
            "cursor": self.cursor / float(bar),
            "playhead": self.ardour_playhead / float(bar),
            "window": (max(0.0, self.cursor / float(bar) - 4.0),
                       max(8.0, self.cursor / float(bar) + 4.0)),
            "lanes": self.edit_lanes(bar),
        }
        sel = self.selected()
        st["wave"] = {
            "lane": self.focus,
            "region": sel["name"] if sel else "-",
            "length": ("%.2f BARS" % (sel["len"] / float(bar))) if sel else "",
            "trim": tuple(self.wave_trim),
            "handle": self.wave_handle,
            "zoom": self.wave_zoom,
            "gain": self.wave_gain,
            "peaks": [],
        }
        # THE FX PAGE'S CHAIN, four chips windowed around the focused slot
        # so the chip the knobs act on is always one of the four drawn -
        # browsing into a fifth slot off the right edge would be the same
        # bug as a selection the cursor did not follow. Bypass is the LIVE
        # belief, not the chain file's opening flag: the chip must dim when
        # BYP is pressed, not when the config was written.
        ch = self.chain()
        first = max(0, self.fx_slot - 3)
        bypassed = self.fx_bypass.get(self.focus, set())
        st["fx"] = {
            "track": self.focus,
            "chain": [{"name": s.get("name", "?"),
                       "bypass": (first + i) in bypassed}
                      for i, s in enumerate(ch[first:first + 4])],
            "slot": self.fx_slot - first,
            "kind": ch[self.fx_slot].get("kind", "params") if ch else "params",
            "knobs": [{"name": "P%d" % (k + 1),
                       "norm": self.fx_values.get(
                           (self.focus, self.fx_slot, k), 0.5)}
                      for k in range(4)],
        }
        # SONG in Ardour's coordinates throughout - playhead, markers and
        # the sections between them - for the reason at scrub(): one page,
        # one clock. Sections are what the markers imply, each running to
        # the next marker and the last to the edge of the drawn ribbon,
        # which also grows to keep every marker on it.
        song_pos = self.ardour_playhead / float(bar)
        total = max(1, int(song_pos) + 8)
        marks = [(p / float(bar), n) for p, n in self.markers]
        if marks:
            total = max(total, int(marks[-1][0]) + 4)
        sections = []
        for i, (at, name) in enumerate(marks):
            end = marks[i + 1][0] if i + 1 < len(marks) else float(total)
            sections.append({"start": at, "length": max(0.0, end - at),
                             "name": name,
                             "current": at <= song_pos < end})
        st["song"] = {"position": song_pos, "bars": total,
                      "zoom": 0.5, "sections": sections}
        # The browser is an OVERLAY: it reports itself as the page so the
        # renderer draws it, and self.page is left alone so closing puts back
        # the page that was underneath rather than a remembered default.
        if self.files:
            st["page"] = "FILES"
            st["files"] = {"rows": self.files_rows,
                           "cursor": self.browser.cursor,
                           # At the sources there is no directory to name, and
                           # "SOURCES" is what that row set is.
                           "path": self.browser.cwd() or "SOURCES",
                           "root": self.browser.at_root()}
        return st

    def write_state(self, path=STATE):
        # The temp name carries the pid. With a fixed ".tmp" two instances -
        # the service and someone running this by hand to see what it does -
        # write the same temp path, and whichever renames second dies with
        # FileNotFoundError because the first already moved it away. The
        # write-then-rename is there to keep the reader from ever seeing a
        # half-written frame; it should not also be a way to crash.
        tmp = "%s.%d.tmp" % (path, os.getpid())
        try:
            with open(tmp, "w") as f:
                json.dump(self.ui_state(), f)
            os.replace(tmp, path)
        except OSError:
            # A screen that misses one frame is not a reason to take the
            # control process down; the next command writes another.
            try:
                os.unlink(tmp)
            except OSError:
                pass


def self_test():
    class FakeOsc:
        def __init__(self):
            self.msgs = []

        def send(self, path, *a):
            self.msgs.append((path, a))

    o = FakeOsc()
    # A real path, not /dev/shm: the self-test must not append to the queue a
    # running governor is draining, and the round-trip below has to read back
    # what was actually written.
    import tempfile
    qdir = tempfile.mkdtemp()
    d = Daw(o, bpm=120.0, queue=os.path.join(qdir, "queue"))

    def queued():
        try:
            with open(d.queue) as f:
                return [ln.strip() for ln in f if ln.strip()]
        except OSError:
            return []
    d.setup()
    assert any(p == "/set_surface/bank_size" for p, _ in o.msgs)

    # ssid is the panel column + 1, the contract the whole system leans on
    # Written against the LIST, not against literal names. Hardcoding "MPC"
    # and "GTR1" here is what let a rename pass a green self-test while the
    # knobs addressed the wrong routes.
    assert d.ssid(STRIPS[0]) == 1 and d.ssid(STRIPS[1]) == 2
    assert LANES and all(n in STRIPS for n in LANES)

    # a mixer move reaches Ardour with the right strip and value
    d.command("gain %s -6.5" % STRIPS[2])
    assert ("/strip/gain", (3, -6.5)) in o.msgs, o.msgs

    # mute toggles rather than sets, and echoes to Ardour
    d.command("mute %s" % STRIPS[3])
    assert ("/strip/mute", (4, 1)) in o.msgs
    d.command("mute %s" % STRIPS[3])
    assert ("/strip/mute", (4, 0)) in o.msgs

    # --- ARDOUR FOLLOWS THE MPC ---------------------------------------
    #
    # The two halves loop recording had never had on the instrument, and
    # the reason it had never once produced a take from the panel: nothing
    # wrote the emulator's transport export, so every punch answered
    # `no-transport`; and nothing rolled Ardour, so a punch that did land
    # wrote to a timeline standing still. Both are asserted here as JOINS -
    # a file in, a queue line out - because two green tests either side of
    # a gap do not test the gap, and this file has shipped that same shape
    # three times.
    d.regions_path = os.path.join(qdir, "regions")
    tport = os.path.join(qdir, "mpc-transport")
    follow_lane = LANES[2]

    def export(playing, ms, bpm=None):
        """One line of scripts/daw/transport-export.lua, byte for byte."""
        with open(tport, "w") as fh:
            fh.write("%d %d %.6f%s\n" % (playing, ms, ms / 1000.0,
                                         (" %.1f" % bpm) if bpm else ""))
        return d.poll_transport(tport)

    # No export at all is what the appliance had: the punch verbs cannot
    # quantise to a grid that does not exist, and they say so.
    assert d.poll_transport(os.path.join(qdir, "nope")) is False
    d.command("arm 1")
    assert d.command("punch_in %s" % follow_lane) == \
        ["error no-transport"], "a punch with no bar grid must refuse"
    d.command("arm 0")

    # The MPC starts. Ardour is rolled BEHIND it - not by a button, which
    # would fight the one clock the system agrees on, but as a consequence
    # of what the emulator says its sequencer is doing.
    mark = len(queued())
    assert export(1, 0) is True
    assert "transport roll" in queued()[mark:], queued()[mark:]
    mark = len(queued())
    export(1, 250)
    assert "transport roll" not in queued()[mark:], \
        "the roll is an edge, not a heartbeat"

    # The fourth field is the sequencer's own tempo, and it wins: a bar grid
    # at a tempo the drums are not playing quantises to lines that are not
    # there. Absent (three fields), whatever was configured stays.
    export(1, 300, bpm=86.0)
    assert abs(d.transport.bpm - 86.0) < 0.01, d.transport.bpm
    export(1, 350)
    assert abs(d.transport.bpm - 86.0) < 0.01, "a short line reset the tempo"
    d.command("tempo 120")
    assert d.transport.bpm == 120.0, d.transport.bpm

    # THE GRID IS EXACT, and it is exact because the playhead is computed
    # before the anchor that hangs off it. The other order - which is what
    # shipped - anchored each frame to the PREVIOUS frame's playhead, so
    # every bar line came back one tick early and a "four bar" take was four
    # bars give or take the poll interval.
    spb = d.transport.samples_per_bar()
    export(1, 1234)
    assert d.transport.bar_anchor_sample == d.playhead - d.playhead % spb, \
        (d.transport.bar_anchor_sample, d.playhead, spb)
    assert d.transport.next_bar_sample(d.playhead) % spb == 0

    # ...and end to end: a punch in and a punch out driven by nothing but
    # the export produce a take that is a whole number of bars. This is the
    # property the countdown, the largest glyphs on the screen, is about.
    d.command("arm 1")
    export(1, 1500)
    d.command("punch_in %s" % follow_lane)
    for ms in range(1600, 12000, 100):
        export(1, ms)
        d.tick()
    d.command("punch_out %s" % follow_lane)
    for ms in range(12000, 22000, 100):
        export(1, ms)
        acts = d.tick()
        if any(a.startswith("finalize") for a in acts):
            break
    taken = [a for a in queued() if a.startswith("finalize %s" % follow_lane)]
    assert taken, queued()
    length = int(taken[-1].split()[-1])
    assert length % spb == 0 and length >= spb, (length, spb)

    # THE MPC STOPS. Ardour has to stop with it, and a take still rolling
    # has to be closed on the last bar line that actually passed - punch-out
    # schedules a FUTURE bar line, and no more bar lines are coming.
    d.command("punch_in %s" % follow_lane)
    for ms in range(22000, 30000, 100):
        export(1, ms)
        d.tick()
    assert d.engine.lanes[follow_lane].state == "recording"
    mark = len(queued())
    # As the hardware actually does it. STOP resets the counter to zero ONE
    # FRAME BEFORE the playing flag drops - measured on the appliance, 6206
    # ms to 30 ms with `playing` still 1 - so the take has to be closed
    # against the clock that was, not against a playhead that has already
    # jumped back to the top of the sequence.
    export(1, 30)
    assert d.engine.lanes[follow_lane].state == "looping", \
        "the take was not closed against the clock that ran"
    export(0, 30)
    after = queued()[mark:]
    assert "transport stop" in after, after
    assert any(a.startswith("finalize %s" % follow_lane) for a in after), after
    assert follow_lane not in d.rolling
    # ...and the lane's fill mark came back into the NEW coordinates with it.
    # Left in the old ones it sits a whole sequence away from a playhead that
    # has restarted at zero, and the distance between them is the only thing
    # `repetitions_needed` reads - so the loop is either never topped up
    # again or topped up all at once.
    filled = d.engine.lanes[follow_lane].filled_to
    assert abs(filled - d.playhead) < 10 * spb, (filled, d.playhead)
    d.command("arm 0")

    # THE WATCHDOG. The governor publishes what Ardour is ACTUALLY doing, so
    # a transport that is not rolling under a playing MPC - a governor that
    # restarted, say - is visible rather than merely unlikely. The edge above
    # has already been sent; without this nothing would ever roll it again.
    def header(rolling, rec, gen=1):
        with open(d.regions_path, "w") as fh:
            fh.write("# rate %d transport 0 gen %d rolling %d rec %d\n"
                     % (d.transport.rate, gen, rolling, rec))
        d.regions_stamp = None
        d.poll_regions()

    export(1, 31000)
    header(rolling=0, rec=0)
    d.roll_asked = 0.0
    mark = len(queued())
    d.tick(now=time.monotonic())
    assert "transport roll" in queued()[mark:], queued()[mark:]
    header(rolling=1, rec=0, gen=2)
    mark = len(queued())
    d.tick(now=time.monotonic())
    assert "transport roll" not in queued()[mark:], "a rolling Ardour is left alone"

    # ...and the record-enable, which is the one Ardour drops BY ITSELF:
    # stopping the transport while recording disengages it, and the OSC path
    # is a toggle with no setter, so a belief that has drifted turns the next
    # press of REC into a silent disarm. What is published wins.
    d.command("arm 1")
    assert d.session_record
    d.record_sent = 0.0
    header(rolling=1, rec=0, gen=3)
    mark = len(o.msgs)
    d.tick(now=time.monotonic())
    assert (ardour_bindings.RECORD["session_arm"], ()) in o.msgs[mark:], \
        "a record-enable Ardour had dropped was not put back"
    assert d.session_record
    # Bounded: an Ardour that will not engage must not be toggled for ever,
    # which on a rolling transport is a stream of junk captures.
    d.record_sent = 0.0
    header(rolling=1, rec=0, gen=4)
    d.tick(now=time.monotonic())
    d.record_sent = 0.0
    header(rolling=1, rec=0, gen=5)
    d.tick(now=time.monotonic())
    d.record_sent = 0.0
    header(rolling=1, rec=0, gen=6)
    mark = len(o.msgs)
    d.tick(now=time.monotonic())
    assert o.msgs[mark:] == [], "the record toggle is not bounded"
    d.command("arm 0")

    # Leave nothing of this behind: the lane goes back to idle, the queue is
    # emptied, and nothing more is asserted about an Ardour nobody is
    # publishing - the sections below check the queue line for line.
    d.command("undo %s" % follow_lane)
    d.ardour_rolling = None
    d.ardour_record = None
    d.mpc_playing = None
    d.record_fixes = 0
    open(d.queue, "w").close()
    os.unlink(d.regions_path)
    d.regions_stamp = None

    # transport export drives the bar grid; recording arms at the bar
    d.transport.update_from_export(1, 0, 0)
    d.playhead = 0
    out = d.command("rec %s" % LANES[0])
    assert out and out[0].startswith("arm %s" % LANES[0]), out
    d.playhead = d.transport.samples_per_bar()
    acts = d.tick()
    assert any(a.startswith("record-start") for a in acts), acts
    assert ("/strip/recenable", (d.ssid(LANES[0]), 1)) in o.msgs, o.msgs

    # --- loop recording ----------------------------------------------
    #
    # The four verbs maschine-hub emits, asserted against STRIPS/LANES
    # rather than literal names: the hub's own test proves it sends
    # "focus LOOP2", and it stayed green while nothing here acted on it.
    #
    # LANES[-1] rather than LANES[0], which the block above left recording.
    lane = LANES[-1]
    other = [n for n in STRIPS if n not in LANES]

    d.command("focus %s" % STRIPS[1])
    assert d.focus == STRIPS[1], d.focus
    assert (ardour_bindings.RECORD["focus"], (d.ssid(STRIPS[1]), 1)) in o.msgs
    assert d.command("focus NOPE")[0].startswith("error no-strip")
    assert d.focus == STRIPS[1], "a bad focus must not move the good one"

    # ARM is the desk's global record-enable, and the OSC path is a toggle:
    # sending it twice for one state would disengage recording.
    d.command("arm 1")
    assert d.armed and d.session_record
    assert (ardour_bindings.RECORD["session_arm"], ()) in o.msgs
    mark = len(o.msgs)
    d.command("arm 1")
    assert o.msgs[mark:] == [], "re-arming must not flip the toggle back off"
    # Same guard one level down, because the outer one hides it: this is the
    # call that must never repeat itself, whoever ends up making it.
    d.set_session_record(d.session_record)
    assert o.msgs[mark:] == [], "the record toggle must only be sent on change"

    # Punching a strip that is not a loop lane is refused rather than silent.
    if other:
        out = d.command("punch_in %s" % other[0])
        assert out[0].startswith("error no-lane"), out

    # PUNCH IN lands on the next bar line, not now.
    spb = d.transport.samples_per_bar()
    d.playhead = spb // 2                       # half a bar in
    mark = len(o.msgs)
    d.command("punch_in %s" % lane)
    assert lane in d.rolling
    assert (ardour_bindings.RECORD["strip_punch"], (d.ssid(lane), 1)) \
        not in o.msgs[mark:], "punch-in must wait for the bar line"
    assert d.tick() == [], "and must not start between bars"
    d.playhead = spb
    assert any(a.startswith("record-start %s" % lane) for a in d.tick())
    assert (ardour_bindings.RECORD["strip_punch"], (d.ssid(lane), 1)) in o.msgs

    # PUNCH OUT closes on a bar line too, and the take's length is what was
    # played: punched 10 samples into the fourth bar, closed on the fifth.
    d.playhead = 3 * spb + 10
    mark = len(o.msgs)
    d.command("punch_out %s" % lane)
    assert lane not in d.rolling
    assert (ardour_bindings.RECORD["strip_punch"], (d.ssid(lane), 0)) \
        not in o.msgs[mark:], "punch-out must not close where it was asked"
    # ON a bar line, which is the actual claim - "not immediately" is also
    # true of any other wrong answer.
    stop_at = d.engine.lanes[lane].stop_at
    assert stop_at % spb == 0, stop_at
    # ...and while it waits, the screen counts the bar down.
    ln = [l for l in d.ui_state()["lanes"] if l["name"] == lane][0]
    assert ln["state"] == "rec" and ln["bars_remaining"] == 1, ln
    d.playhead = 4 * spb
    acts = d.tick()
    assert any(a.startswith("finalize %s" % lane) for a in acts), acts
    assert (ardour_bindings.RECORD["strip_punch"], (d.ssid(lane), 0)) in o.msgs
    rec = d.engine.lanes[lane]
    assert rec.state == "looping" and rec.bars == 3, rec.bars
    assert rec.length_samples == 3 * spb

    # THE TAKE REACHES THE PLAYLIST. Closing a take emits region work that
    # OSC cannot express, and until this test existed it was emitted to
    # nobody: the strip recorded and no loop ever appeared. What goes on the
    # queue is the engine's action string unchanged, which is what
    # loop-ops.lua parses - assert the words, because a rename on either side
    # is exactly how the knobs and the punch verbs both shipped dead.
    q = queued()
    assert "finalize %s length %d" % (lane, 3 * spb) in q, q
    assert any(a.startswith("repeat %s at " % lane) and " times " in a
               for a in q), q
    # Mixer and punch traffic must NOT end up on it: those are OSC, and a
    # governor asked to "arm" answers "unknown op" for as long as REC is held.
    assert not any(a.split()[0] in ("arm", "disarm", "record-start", "gain")
                   for a in q), q
    # The lookahead is what keeps it sounding: the loop must be laid out
    # ahead of the playhead, not just once.
    laid = sum(int(a.split()[-1]) for a in q if a.startswith("repeat "))
    assert laid >= 1, q
    # UNDO takes it away again. A lane that has gone idle while its
    # repetitions are still laid out plays on with no button left to stop it.
    d.command("undo %s" % lane)
    assert "clear %s" % lane in queued(), queued()

    # DISARM closes anything still rolling. The hub forgets on the same
    # press, so if daw-ctl did not do this the strip would record forever.
    d.playhead = 5 * spb
    d.command("punch_in %s" % lane)
    d.playhead = 6 * spb
    d.tick()
    assert d.engine.lanes[lane].state == "recording" and d.rolling
    d.playhead = 6 * spb + 10
    mark = len(o.msgs)
    d.command("arm 0")
    assert not d.armed and not d.rolling and not d.session_record
    assert (ardour_bindings.RECORD["session_arm"], ()) in o.msgs[mark:]
    d.playhead = 7 * spb
    d.tick()
    assert d.engine.lanes[lane].state == "looping", "disarm closes the take"
    assert (ardour_bindings.RECORD["strip_punch"], (d.ssid(lane), 0)) \
        in o.msgs[mark:], "and must rec-disable the strip in Ardour"

    # And once disarmed, the strip buttons cannot record by accident.
    assert d.command("punch_in %s" % lane)[0].startswith("error not-armed")

    # The panel gets the loop-record state, in the words daw_ui draws with.
    st = d.ui_state()
    assert st["focus"] == d.focus and st["armed"] is False
    assert st["rolling"] == []
    states = {l["name"]: l["state"] for l in st["lanes"]}
    assert states[lane] == "play", states
    assert states[LANES[0]] == "rec", states   # still rolling from above
    assert set(states.values()) <= {"armed", "rec", "dub", "play"}, states

    # the UI state is renderable by the panel code
    st = d.ui_state()
    sys.path.insert(0, os.path.join(os.path.dirname(
        os.path.dirname(os.path.abspath(__file__))), "maschine"))
    import daw_ui
    frame = daw_ui.render(dict(daw_ui.sample_state("LOOP"), **st))
    assert len(frame.px) == 255 * 64

    # THE FILE BROWSER, end to end against a real directory.
    #
    # browser.py's own self-test proves the listing and the cursor; the hub's
    # proves the panel emits these lines. Neither can notice that nothing
    # joins them - which is exactly how the knobs and then the punch verbs
    # both shipped dead - so this is the join, on a real tree.
    import tempfile, shutil
    tmp = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(tmp, "KITS"))
        img = os.path.join(tmp, "BEAT.IMG")
        with open(img, "wb") as fh:
            fh.write(b"\0" * browserlib.FLOPPY_BYTES)
        with open(os.path.join(tmp, "NOTES.TXT"), "w") as fh:
            fh.write("x")
        d.browser = browserlib.Browser(
            roots=[("LIB", tmp), ("USB", os.path.join(tmp, "nope"))])
        d.disk_request = os.path.join(tmp, "request")
        d.disk_memory = os.path.join(tmp, "memory")
        d.disk_status = os.path.join(tmp, "status")

        d.command("files open")
        assert d.files and d.ui_state()["page"] == "FILES", \
            "the browser must report itself as the page, or nothing draws it"
        assert d.page == "LOOP", "the page underneath must survive the overlay"
        rows = d.ui_state()["files"]["rows"]
        assert [r["name"] for r in rows] == ["LIB", "USB"], rows
        assert rows[1]["present"] is False, "a missing source is still a row"

        # The wheel moves the cursor; entering a source that is not mounted
        # says why rather than doing nothing.
        d.command("files move +1")
        assert d.browser.cursor == 1
        assert d.command("files enter") == []
        assert d.message == "NOT MOUNTED", d.message
        d.command("files move -1")
        assert d.message == "", "a refusal outlived the row it was about"

        d.command("files into")
        assert not d.browser.at_root()
        names = [r["name"] for r in d.ui_state()["files"]["rows"]]
        assert names == ["KITS", "BEAT.IMG", "NOTES.TXT"], names
        assert d.ui_state()["files"]["path"] == tmp

        # browse_right refuses to load; only ENTER does.
        d.browser.cursor = names.index("BEAT.IMG")
        assert d.command("files into") == []
        assert d.message == "ENTER TO LOAD", d.message
        assert not os.path.exists(d.disk_request), \
            "browse_right swapped the disk under a running instrument"
        out = d.command("files enter")
        assert out == ["load %s" % img], out
        with open(d.disk_request) as fh:
            assert fh.read().strip() == img
        # LOADING, not LOADED. Nothing has been loaded yet - a path was
        # written to a file. Claiming the outcome at keypress time is exactly
        # how the panel came to report loads that never happened.
        assert d.message == "LOADING BEAT.IMG", d.message
        assert not os.path.exists(d.disk_memory), \
            "a choice was remembered before the drive had accepted it"

        # THE EMULATOR'S ANSWER REACHES THE SCREEN. This is the half that did
        # not exist: the request was published and nothing ever read it, so the
        # panel could only ever report its own keypress.
        with open(d.disk_status, "w") as fh:
            fh.write("ok %s\n" % img)
        d.poll_disk()
        assert d.message == "LOADED BEAT.IMG", d.message
        # ...and only now is it worth surviving a power cycle.
        with open(d.disk_memory) as fh:
            assert fh.read().strip() == img, "the disk choice was not remembered"
        # Applied once, not every tick - otherwise one answer nails itself to
        # the status line and no later message can ever be seen.
        d.message = "SOMETHING ELSE"
        assert d.poll_disk() is None
        assert d.message == "SOMETHING ELSE", d.message
        # And a refusal arrives in the emulator's own words - and MUST NOT be
        # remembered. A refused image in the boot seed meant every subsequent
        # boot came up with an empty drive and an error, with no way back
        # except picking something else.
        with open(d.disk_status, "w") as fh:
            fh.write("error not a floppy image\n")
        d.poll_disk()
        assert d.message == "NOT A FLOPPY IMAGE", d.message
        with open(d.disk_memory) as fh:
            assert fh.read().strip() == img, \
                "a refused image overwrote the remembered one"

        # A file that is not a disk says so, and up leaves the tree.
        d.browser.cursor = names.index("NOTES.TXT")
        d.command("files enter")
        assert d.message == "NOT A DISK", d.message
        d.command("files up")
        assert d.browser.at_root()
        d.command("files up")
        assert d.message == "AT THE TOP", d.message

        # THE VERBS COME FROM THE MAP THE HUB SENDS THEM FROM, not from
        # strings typed here. A key whose command this process does not parse
        # is precisely the gap that shipped the knobs dead and then the punch
        # verbs dead: two green self-tests either side of a rename.
        d.browser = browserlib.Browser(roots=[("LIB", tmp)])
        for _line in sorted(control_map.FILES_BUTTONS.values()) + [
                "files open", "files close", "files move +1"]:
            assert "error no-files" not in " ".join(d.command(_line)), \
                "the panel sends %r and daw-ctl does not parse it" % _line
        d.command("files open")

        # And the panel can draw what all of that produced.
        frame = daw_ui.render(dict(daw_ui.sample_state("FILES"), **d.ui_state()))
        assert len(frame.px) == 255 * 64
        d.command("files close")
        assert not d.files and d.ui_state()["page"] == "LOOP"
        assert "files" not in d.ui_state()

        # --- THE JOG ---------------------------------------------------
        #
        # maschine-hub has surface-gated the big knob to "jog %+d" since the
        # DAW jog was specified, and nothing here parsed the word: it fell
        # through to the loop engine and came back UNKNOWN COMMAND JOG on
        # every page. The panel test proved the hub sends it and the panel
        # test was green, which is the third time that exact shape of gap has
        # shipped a dead control here - so this asserts the JOIN, page by
        # page, against the table in docs/daw-interaction.md.
        d.transport.bpm = 120.0
        spb = d.transport.samples_per_bar()

        # MIX: nothing, and specifically not an error. A knob with no job on
        # this page is not a fault, and answering UNKNOWN COMMAND to it is how
        # a working panel comes to look broken.
        d.command("page LOOP")
        d.message = ""
        assert d.command("jog +1") == [], "the jog must be silent on MIX"
        assert d.message == "", "MIX's idle jog reported something"

        # SONG: the playhead, snapped to the bar - and it is a LOCATE, not a
        # transport action. The MPC owns the clock. What moves is the
        # ARDOUR-side belief, not the MPC-clock mirror: the mirror is
        # rewritten by every transport poll, so a scrub kept there snapped
        # back within 10 ms - and the markers this page jumps between are
        # published in Ardour's timeline, so the scrub must live in the
        # same coordinates or PREV lands outside the section on screen.
        d.command("page SONG")
        d.ardour_playhead = 0
        mpc_clock = d.playhead
        out = d.command("jog +2")
        assert out == ["locate %d" % (2 * spb)], out
        assert d.ardour_playhead == 2 * spb
        assert d.playhead == mpc_clock, "the scrub touched the MPC's clock"
        assert ("/locate", (2 * spb, 0)) in o.msgs, \
            "SONG's jog did not reach Ardour"
        d.command("jog -99")
        assert d.ardour_playhead == 0, \
            "the playhead ran off the front of the session"

        # EDIT: the cursor, snapped per SNAP - and SNAP cycles through the
        # three the spec names.
        d.command("page EDIT")
        d.cursor = 0
        assert d.snap == "BAR"
        d.command("jog +1")
        assert d.cursor == spb, (d.cursor, spb)
        assert d.command("snap") == ["snap BEAT"]
        d.cursor = 0
        d.command("jog +1")
        assert d.cursor == spb // 4, "BEAT snap did not move by one beat"
        assert d.command("snap") == ["snap OFF"]
        assert d.command("snap") == ["snap BAR"], "SNAP must cycle, not stick"

        # WAVE: the selected trim handle, and the handle is whichever trim
        # knob was last touched - so there is no separate key to choose with.
        d.command("page WAVE")
        d.wave_trim = [0.0, 1.0]
        d.command("knob WAVE 1 100")          # K2 = the END handle
        assert d.wave_handle == 1
        before = d.wave_trim[1]
        d.command("jog -5")
        assert d.wave_trim[1] < before, "the jog did not move the held handle"
        # The handles cannot cross. An inside-out region is one Ardour will
        # accept and nobody can see.
        d.wave_trim = [0.5, 0.5]
        d.command("knob WAVE 0 100000")
        assert d.wave_trim[0] <= d.wave_trim[1], d.wave_trim

        # --- WAVE IS A DRILL-IN -----------------------------------------
        #
        # SELECT emitted "daw:select" from the panel and daw-ctl had never
        # heard the word, so the button printed UNKNOWN COMMAND SELECT across
        # the status line. It opens the take on the focused lane now, and the
        # way back is the same key - it CANNOT be D8, which is the surface
        # toggle and is never rebound.
        d.command("page SONG")
        d.command("focus LOOP4")
        assert d.command("select") == ["page WAVE"]
        assert d.page == "WAVE"
        # Nothing has been published for LOOP4, so the page says so instead of
        # presenting a pair of trim handles over no audio.
        assert d.message == "NO TAKE ON LOOP4", d.message
        # Backing out returns to the page it was opened FROM, not a default -
        # a drill-in that always dropped you on MIX loses your place.
        assert d.command("select") == ["page SONG"]
        assert d.page == "SONG"
        # A fresh drill-in starts with fresh handles: carrying the last
        # lane's trim onto another lane applies one take's edit points to a
        # different take's audio.
        d.command("select")
        d.wave_trim = [0.2, 0.7]
        d.command("back")
        assert d.page == "SONG"
        d.command("select")
        assert d.wave_trim == [0.0, 1.0], d.wave_trim
        d.command("back")
        # BACK on a top-level page is a key with no job, not a fault.
        d.message = ""
        assert d.command("back") == [] and d.message == ""

        # --- THE REGION CHANNEL ------------------------------------------
        #
        # The one missing piece the whole EDIT and WAVE column was blocked
        # on. session-governor.lua publishes the playlist; this reads it,
        # and every verb below addresses what it found BY NAME - which is
        # the join, and the join is the thing that has shipped dead three
        # times here. Both halves are exercised against a real file, in the
        # format the governor actually writes.
        regions_file = os.path.join(tmp, "daw-regions")
        d.regions_path = regions_file
        d.command("focus LOOP1")
        spb = d.transport.samples_per_bar()

        def publish(rows, transport=0, rate=None, marks=()):
            """Write one frame exactly as session-governor.lua's publish()."""
            with open(regions_file, "w") as fh:
                fh.write("# rate %d transport %d gen 1\n"
                         % (rate or d.transport.rate, transport))
                for track, name, pos, ln, fi, fo, gain in rows:
                    fh.write("%s\t%s\t%d\t%d\t%d\t%d\t%.4f\n"
                             % (track, name, pos, ln, fi, fo, gain))
                for name, pos in marks:
                    fh.write("mark\t%s\t%d\n" % (name, pos))
            # The stat-based poll must not be fooled by a same-second write.
            d.regions_stamp = None
            assert d.poll_regions(), "a changed file was not picked up"

        # An EMPTY session publishes a header and no rows, and that is a
        # different thing from no file at all: the page has to be able to say
        # the lane is empty rather than draw handles over nothing.
        publish([])
        assert d.regions == {} and d.selected() is None
        d.command("page EDIT")
        assert d.command("split")[0].startswith("error no-region")
        assert d.message == "NO REGION ON LOOP1", d.message

        publish([("LOOP1", "LOOP1-1.1", 0, 4 * spb, 0, 0, 1.0),
                 ("LOOP1", "LOOP1-1.1@1", 4 * spb, 4 * spb, 0, 0, 1.0),
                 ("LOOP2", "LOOP2-1.1", 2 * spb, 3 * spb, 0, 0, 0.5)],
                transport=6 * spb)
        assert [r["name"] for r in d.lane_regions()] == \
            ["LOOP1-1.1", "LOOP1-1.1@1"], d.lane_regions()
        # The header is not decoration: the playhead EDIT draws is ARDOUR's,
        # published with the regions, not this process's count of the MPC's
        # elapsed milliseconds. They free-run against each other.
        assert d.ui_state()["edit"]["playhead"] == 6.0, d.ui_state()["edit"]
        # ...and the rate comes with them, because everything on the wire is
        # samples and the two sides have to agree what one is worth.
        publish([], rate=48000)
        assert d.transport.rate == 48000
        publish([("LOOP1", "LOOP1-1.1", 0, 4 * spb, 0, 0, 1.0),
                 ("LOOP1", "LOOP1-1.1@1", 4 * spb, 4 * spb, 0, 0, 1.0)],
                rate=d.RATE)
        spb = d.transport.samples_per_bar()

        # A published frame always leaves SOMETHING selected, so the first
        # press of a region key is not spent choosing a starting point.
        d.cursor = 0
        d.resync_selection()
        assert d.sel_region == "LOOP1-1.1", d.sel_region

        # ...and the two keys that move it. The cursor FOLLOWS: the window is
        # drawn around the cursor, so a selection it did not follow would be
        # bright somewhere off screen and every verb would act out of sight.
        assert d.command("region next") == ["region LOOP1-1.1@1"]
        assert d.cursor == 4 * spb, "the cursor must follow the selection"
        assert d.command("region next") == ["region LOOP1-1.1@1"], \
            "the last region is the last region, not an error"
        assert d.command("region prev") == ["region LOOP1-1.1"]
        assert d.cursor == 0

        # SPLIT cuts the selected region AT THE CURSOR, in Ardour's samples.
        d.command("jog +2")                      # two bars in, snapped to bar
        assert d.cursor == 2 * spb
        mark = len(queued())
        assert d.command("split") == ["split LOOP1 LOOP1-1.1 %d" % (2 * spb)]
        assert queued()[mark:] == ["split LOOP1 LOOP1-1.1 %d" % (2 * spb)]
        # A cut outside the region is refused rather than reported as done:
        # Ardour accepts the call and does nothing, so the button would lie.
        d.cursor = 40 * spb
        assert d.command("split")[0].startswith("error cursor-outside")

        # DUPLICATE - unbound on the panel until there was a region op to
        # answer it with, which is what this is.
        d.cursor = 9 * spb
        assert d.command("duplicate") == \
            ["duplicate LOOP1 LOOP1-1.1 %d" % (9 * spb)]

        # ERASE on EDIT is the region; on the strips page it is the take.
        # One key that undoes what the page in front of you does.
        mark = len(queued())
        assert d.command("erase") == ["remove LOOP1 LOOP1-1.1"]
        assert d.page == "EDIT"
        d.command("page LOOP")
        # A lane that has never recorded. The engine has no error for that -
        # it answers "clear LANE" regardless - so this used to report ERASED
        # for a lane with nothing on it, and put a no-op on the queue.
        d.command("focus %s" % LANES[1])
        out = d.command("erase")
        assert out[0].startswith("error no-take"), out
        assert d.message == "NO TAKE ON %s" % LANES[1], d.message
        assert "remove" not in " ".join(queued()[mark + 1:]), \
            "ERASE on the strips page must not delete a region"
        # ...and a lane that IS holding one is discarded, which is the same
        # single `clear` the take-level UNDO sends.
        d.command("focus %s" % LANES[0])
        assert d.command("erase") == ["clear %s" % LANES[0]]
        assert d.message == "ERASED %s" % LANES[0], d.message
        d.command("page EDIT")
        d.command("focus LOOP1")

        # UNDO on EDIT pops the Lua side's inverse-op stack. It is NOT
        # Ardour's undo - Session:undo is not bound in Lua on Ardour 8 or 9
        # (measured), so there is no session history to pop.
        mark = len(queued())
        assert d.command("undo") == ["undo"]
        assert queued()[mark:] == ["undo"], queued()
        # ...and `undo LANE` still means the loop engine's take-level undo,
        # which is a different stack and a different key.
        d.command("undo LOOP2")
        assert "clear LOOP2" in queued(), queued()

        # THE KNOBS. All four are DEFERRED: the MK1 reports an absolute
        # angle many times a second, so one gesture must be one region edit
        # and one undo entry, not thirty of each.
        publish([("LOOP1", "TAKE", 4 * spb, 4 * spb, 0, 0, 1.0)])
        assert d.sel_region == "TAKE", d.sel_region
        mark = len(queued())
        for _ in range(5):
            d.command("knob EDIT 0 +100")        # K1: slide
        assert queued()[mark:] == [], "a knob edit went out per report"
        d.tick(now=time.monotonic() + 1.0)
        out = queued()[mark:]
        assert len(out) == 1 and out[0].startswith("move LOOP1 TAKE "), out
        assert int(out[0].split()[-1]) > 4 * spb, "the slide went nowhere"

        mark = len(queued())
        d.command("knob EDIT 1 +500")            # K2: fade in
        d.command("knob EDIT 2 +500")            # K3: fade out
        d.command("knob EDIT 3 -400")            # K4: region gain
        d.tick(now=time.monotonic() + 1.0)
        verbs = [a.split()[0] for a in queued()[mark:]]
        assert sorted(verbs) == ["fadein", "fadeout", "gain"], verbs

        # A PRESS FLUSHES WHAT A KNOB LEFT PENDING, so the queue carries the
        # gestures in the order the hands made them - a split that overtook
        # the slide before it would cut the region somewhere it no longer is.
        mark = len(queued())
        d.command("knob EDIT 0 +100")
        d.cursor = 5 * spb
        d.command("split")
        out = queued()[mark:]
        assert [a.split()[0] for a in out] == ["move", "split"], out

        # --- WAVE, ON A REAL TAKE ----------------------------------------
        publish([("LOOP1", "TAKE", 4 * spb, 8 * spb, 0, 0, 0.75)])
        d.command("page LOOP")
        d.command("select")
        assert d.page == "WAVE" and d.sel_region == "TAKE"
        assert d.message == "WAVE LOOP1 TAKE", d.message
        # The gain knob starts where the REGION is, not at unity: a knob that
        # reads 1.0 over a region at 0.75 jumps the moment it is touched.
        assert d.wave_gain == 0.75, d.wave_gain
        assert d.ui_state()["wave"]["region"] == "TAKE"

        # K1/K2 and the jog now CUT, and the cut is against the take's
        # bounds at drill-in, not against what the last trim left - so a
        # handle pulled back out restores audio instead of eating further in.
        mark = len(queued())
        d.command("knob WAVE 0 +200")            # K1: start handle inward
        d.tick(now=time.monotonic() + 1.0)
        out = queued()[mark:]
        assert len(out) == 1 and out[0].startswith("trim LOOP1 TAKE "), out
        start, end = (int(x) for x in out[0].split()[3:5])
        assert 4 * spb < start < end <= 12 * spb, (start, end)
        first_start = start
        d.command("knob WAVE 0 -100")            # back out again
        d.tick(now=time.monotonic() + 1.0)
        start2 = int(queued()[-1].split()[3])
        assert start2 < first_start, "the handle could only eat inward"
        assert start2 >= 4 * spb, "a trim escaped the take it belongs to"

        # NORM. Ardour binds no normalize() to Lua, so the Lua side computes
        # the factor from the region's peak - what goes on the wire is the
        # verb, and the answer comes back as the region's gain.
        mark = len(queued())
        assert d.command("norm") == ["normalize LOOP1 TAKE"]
        assert queued()[mark:] == ["normalize LOOP1 TAKE"]
        publish([("LOOP1", "TAKE", 4 * spb, 8 * spb, 0, 0, 1.8891)])
        assert abs(d.ui_state()["wave"]["gain"] - 1.8891) < 1e-4, \
            "the normalised gain never came back to the knob"

        # UNDO on WAVE is the same stack as EDIT's.
        mark = len(queued())
        assert d.command("undo") == ["undo"]
        assert queued()[mark:] == ["undo"]
        # BACK still leaves, and D8 is still not involved.
        d.command("back")
        assert d.page == "LOOP"

        # --- FX: THE CHAIN'S SLOT ----------------------------------------
        #
        # The knobs edited plugin slot 1 whatever chip the player meant,
        # and sent the encoder's DELTA where the OSC path takes an ABSOLUTE
        # 0..1 - so the first turn of any FX knob set the parameter to a
        # whisker above zero. Asserted as one join: hub verb in, OSC out,
        # chip state published.
        d.chains = {"LOOP1": [{"name": "OD", "kind": "drive"},
                              {"name": "AMP", "kind": "amp"},
                              {"name": "EQ", "kind": "eq"},
                              {"name": "COMP", "kind": "comp",
                               "bypass": True},
                              {"name": "CHOR", "kind": "mod"}]}
        d.fx_bypass = {"LOOP1": {3}}
        d.command("focus LOOP1")
        d.command("page FX")
        assert d.fx_slot == 0
        # browse on FX steps the slot, not the region selection.
        assert d.command("region next") == ["slot 1"]
        assert d.command("region prev") == ["slot 0"]
        assert d.command("region prev") == ["slot 0"], \
            "the first slot is the first slot, not an error"
        d.command("region next")
        d.command("region next")                       # slot 2, the EQ
        mark = len(o.msgs)
        d.command("knob FX 0 +200")
        path, sent = o.msgs[-1]
        assert path == "/strip/plugin/parameter"
        assert sent[0] == d.ssid("LOOP1") and sent[1] == 3, \
            "the knob edited a slot the browse keys did not choose"
        assert sent[2] == 1, sent
        assert 0.5 < sent[3] <= 0.7, sent
        d.command("knob FX 0 +100")
        assert o.msgs[-1][1][3] > sent[3], "the value did not accumulate"
        d.command("knob FX 0 +999999")
        assert o.msgs[-1][1][3] == 1.0, "the value must clamp, not wrap"
        # BYP states the outcome on the wire, both directions - a path per
        # direction, so a double press cannot invert the belief the way a
        # toggle can.
        assert d.command("byp") == ["byp LOOP1 2 1"]
        assert o.msgs[-1] == ("/strip/plugin/deactivate",
                              (d.ssid("LOOP1"), 3)), o.msgs[-1]
        assert d.message == "EQ BYP", d.message
        assert d.command("byp") == ["byp LOOP1 2 0"]
        assert o.msgs[-1] == ("/strip/plugin/activate",
                              (d.ssid("LOOP1"), 3)), o.msgs[-1]
        # The published chain is windowed around the slot, carries the LIVE
        # bypass, and the focused chip is always one of the four drawn.
        fx = d.ui_state()["fx"]
        assert fx["track"] == "LOOP1"
        assert [c["name"] for c in fx["chain"]] == \
            ["OD", "AMP", "EQ", "COMP"], fx["chain"]
        assert fx["slot"] == 2 and fx["kind"] == "eq", fx
        assert fx["chain"][3]["bypass"] is True, "the seeded bypass is lost"
        d.command("region next")
        d.command("region next")                       # slot 4, off the edge
        fx = d.ui_state()["fx"]
        assert [c["name"] for c in fx["chain"]] == \
            ["AMP", "EQ", "COMP", "CHOR"], fx["chain"]
        assert fx["slot"] == 3, fx
        # A strip with no chain says so instead of doing nothing, and a
        # refocus resets the slot - slot 4 of another chain is nothing on
        # this one.
        d.command("focus LOOP2")
        assert d.fx_slot == 0, "focus did not reset the slot"
        d.chains.pop("LOOP2", None)
        assert d.command("byp")[0].startswith("error no-chain")
        assert d.message == "NO CHAIN ON LOOP2", d.message
        assert d.command("knob FX 0 +100")[0].startswith("error no-chain")

        # --- SONG: THE MARKERS -------------------------------------------
        #
        # MARK goes down the queue BARE - the governor stamps it at
        # Ardour's own transport, for the same reason NORM sends no factor:
        # the side that owns the number supplies it. The markers come back
        # as three-field rows an older daw-ctl skips unread, and browse on
        # SONG steps between them.
        d.command("focus LOOP1")
        d.command("page SONG")
        assert d.command("region next") == ["error no-markers"]
        assert d.message == "NO MARKERS", d.message
        publish([], transport=6 * spb,
                marks=[("M1", 2 * spb), ("M2", 8 * spb)])
        assert d.markers == [(2 * spb, "M1"), (8 * spb, "M2")], d.markers
        assert d.command("region next") == ["locate %d" % (8 * spb)]
        assert d.message == "MARKER M2", d.message
        assert ("/locate", (8 * spb, 0)) in o.msgs
        assert d.command("region prev") == ["locate %d" % (2 * spb)]
        assert d.message == "MARKER M1", d.message
        assert d.command("region prev") == ["error no-marker prev"]
        assert d.message == "NO MARKER BEFORE", d.message
        mark = len(queued())
        assert d.command("mark") == ["mark"]
        assert queued()[mark:] == ["mark"], queued()[mark:]
        assert d.message.startswith("MARK BAR"), d.message
        # The sections the page draws are what the markers imply, each
        # running to the next and the last to the ribbon's edge, current
        # where the playhead the page draws actually is.
        song = d.ui_state()["song"]
        assert [s["name"] for s in song["sections"]] == ["M1", "M2"]
        assert song["sections"][0]["start"] == 2.0, song["sections"]
        assert song["sections"][0]["length"] == 6.0, song["sections"]
        assert song["sections"][0]["current"] is True, song["sections"]
        assert song["sections"][1]["current"] is False, song["sections"]
        d.command("page LOOP")

        # THE PAGE DRAWS WHAT THE CHANNEL PUBLISHED. Positions, not just a
        # count: this is what the EDIT renderer stacks into lanes.
        d.command("focus LOOP1")
        publish([("LOOP1", "A", 0, 2 * spb, spb // 4, spb // 8, 1.0),
                 ("LOOP2", "B", 4 * spb, 2 * spb, 0, 0, 1.0)])
        ed = d.ui_state()["edit"]
        tags = [ln["tag"] for ln in ed["lanes"]]
        assert tags == ["L1", "L2"], tags
        assert ed["lanes"][0]["sel"] is True, "the focused lane is not marked"
        reg = ed["lanes"][0]["regions"][0]
        assert reg["start"] == 0.0 and reg["len"] == 2.0, reg
        assert abs(reg["fade_in"] - 0.125) < 1e-9, reg
        assert reg["sel"] is True, "the selected region is not marked"
        # A lane nobody recorded on is not drawn - five slivers and no
        # waveform is worse than one lane you can see - but the FOCUSED lane
        # is always there, because its tag is how the page says where the
        # verbs will land.
        d.command("focus LOOP4")
        tags = [ln["tag"] for ln in d.ui_state()["edit"]["lanes"]]
        assert tags == ["L1", "L2", "L4"], tags
        d.command("focus LOOP1")

        # Every page the jog names must be drawable with the state it
        # produces - the EDIT page took the renderer down once already by
        # being opened on a session that had no "edit" key at all.
        for _page in ("LOOP", "SONG", "EDIT", "WAVE"):
            d.command("page %s" % _page)
            _st = dict(daw_ui.sample_state(_page), **d.ui_state())
            assert len(daw_ui.render(_st).px) == 255 * 64, _page
    finally:
        shutil.rmtree(tmp)
    shutil.rmtree(qdir, ignore_errors=True)
    print("daw-ctl self-test PASS: %d OSC messages, %d queued region ops, "
          "state renders" % (len(o.msgs), len(q)))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--fifo", default=FIFO)
    ap.add_argument("--state", default=STATE)
    ap.add_argument("--transport", default=TRANSPORT)
    ap.add_argument("--queue", default=QUEUE)
    ap.add_argument("--regions", default=REGIONS)
    ap.add_argument("--osc-port", type=int, default=3819)
    # The bar grid's starting tempo, for a project whose tempo the emulator's
    # transport export cannot read. When the export publishes one it wins:
    # this is a seed, not a setting.
    ap.add_argument("--bpm", type=float,
                    default=float(os.environ.get("MPCPI_BPM", "120.0")))
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()
    if args.self_test:
        return self_test()

    daw = Daw(osclib.Client(port=args.osc_port), bpm=args.bpm,
              queue=args.queue, regions=args.regions)
    daw.setup()
    if not os.path.exists(args.fifo):
        os.mkfifo(args.fifo)
    fifo = os.open(args.fifo, os.O_RDONLY | os.O_NONBLOCK)
    buf = b""
    while True:
        daw.poll_transport(args.transport)
        daw.tick()
        try:
            chunk = os.read(fifo, 4096)
            if chunk:
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    daw.command(line.decode("utf-8", "replace"))
        except BlockingIOError:
            pass
        daw.write_state(args.state)
        time.sleep(0.01)


if __name__ == "__main__":
    main()
