[Unit]
Description=Supernova power-on animation on the Maschine's screens and lamps
# As EARLY as possible: the kernel finishes at ~1.1s and this used to start
# at 4.3s, leaving three seconds of dead panel on a machine whose whole job
# is to look alive when you switch it on.
#
# DefaultDependencies=no drops the implicit ordering after basic.target,
# which is what held it until 3.2s. It genuinely needs almost nothing: the
# root filesystem (mounted before systemd runs) and udev having enumerated
# USB. In particular it does NOT need local-fs.target, which waits for
# /boot/firmware and its fsck - 2.9s of waiting for a partition this never
# reads.
DefaultDependencies=no
Wants=systemd-udevd.service
After=systemd-udevd.service
# Do not hold up shutdown for a decoration.
Conflicts=shutdown.target
Before=shutdown.target
# The controller may not be plugged in, and an instrument works perfectly
# well without its control surface.
ConditionPathExistsGlob=/sys/bus/usb/devices/*/idVendor

[Service]
# Type=simple, NOT oneshot. With oneshot, multi-user.target waits for the
# process to EXIT - and this one runs for about seven seconds by design. It
# added 9.4s to the measured boot: basic.target was reached at 3.2s and ssh
# at 3.2s, while multi-user.target sat at 12.7s waiting for an animation.
#
# "Do not delay anything" was the intent from the start; oneshot is simply
# the wrong type for a process that is supposed to run alongside the rest of
# the boot rather than in front of it.
Type=simple
# Core 0, deliberately. Cores 1-3 are isolated for audio, and a boot
# animation has no business competing with the graph for them.
CPUAffinity=0
Nice=5
ExecStart=/opt/mpc-pi-src/scripts/maschine/mk1-boot-animation.py
# It is decoration. If the Maschine is absent, asleep, or held by another
# process, that is not a boot failure.
SuccessExitStatus=0 1
TimeoutStartSec=25
RemainAfterExit=no

[Install]
WantedBy=sysinit.target
