[Unit]
Description=MPC2000XL emulator
# The audio graph must exist first: the emulator opens a PipeWire sink at
# startup and exits if it cannot.
After=basic.target sound.target user@1001.service
Wants=user@1001.service
# [Unit], not [Service]: this sat in [Service] for several boots, where
# systemd logged "Unknown key 'BindsTo' in section [Service], ignoring" and
# the binding simply did not exist.
BindsTo=user@1001.service
# ROMs are not redistributable and may simply be absent on a fresh card. An
# instrument that cannot find them should not spin in a restart loop.
ConditionPathExists=/opt/mpc-roms
ConditionPathExists=/usr/local/bin/mpc

[Service]
Type=simple
User=mpc
Group=mpc

# LAUNCH THROUGH THE TURBO SCRIPT. Do not hand-write the command line here.
#
# This unit used to spell out its own `mpc mpc2000xl -rompath ... -sound
# pipewire ...` invocation plus a hand-copied list of twenty-odd MAME_MPC_*
# variables. Every audio fault found on this appliance was a place where that
# transcription had drifted from what scripts/run-mpc2000xl-turbo.sh produces
# on the development host, where the same emulator has always been audible:
#
#   * MAME_MPC_MIDI_FAST_INPUT was missing - half of internal-pads mode - so
#     165 counted note-ons reached VirMIDI and produced silence.
#   * MPC_V53_DATA_MODE, MPC_DSP_READ_MODE, MPC_PANEL_TIMER_COUNTDOWN and
#     MPC_SOUND_UPDATES_PER_QUANTUM were set here, but those are the
#     LAUNCHER's own names. run-mpc.sh translates them into MAME_* before
#     exec; a unit that runs the binary directly and copies them sets nothing
#     the binary reads. Seventeen fast paths were compiled in and idle, and the
#     emulator ran the reference interpreter at 92% of a core.
#   * The sound cadence has to be quantum/2, and it was left sized for a
#     quantum the graph no longer used.
#
# A transcription cannot be kept in sync by care alone, so it is gone. The
# turbo script owns the preset - which is also what "always use turbo" means -
# and this unit supplies only what is genuinely appliance-specific: where the
# binary and ROMs live, which core, no video, and the instrument's own MIDI
# ports and project.
#
# run-mpc.sh does its own taskset and chrt from MAME_CPUSET / MAME_RT_PRIORITY,
# so there is no wrapper here either.
Environment=MAME_BIN=/usr/local/bin/mpc
Environment=MAME_ROM_DIR=/opt/mpc-roms
Environment=MAME_RUNTIME_DIR=/var/lib/mpcpi
Environment=MAME_BIOS=default
# Core 3, SCHED_RR 20. Cores 1-3 are isolated; PipeWire's data loop owns 1.
Environment=MAME_CPUSET=3
Environment=MAME_RT_PRIORITY=20
# Headless: no window, no renderer. The panel LCD leaves through the export
# that the Maschine hub reads, which the turbo script points at /dev/shm/mpc-lcd.
Environment=MPC_VIDEO_MODE=none
Environment=SDL_VIDEODRIVER=dummy
# 64 frames, 1.45ms. Two constraints, both of which have broken this appliance:
#
#   * MUST equal default.clock.quantum in pipewire.conf.d/95-mpcpi.conf -
#     run-mpc.sh derives the sound-update cadence from it.
#   * MUST NOT exceed api.alsa.period-size in the Duo's wireplumber rule while
#     disable-tsched is on, or the graph stops dead at QUANT 0 in silence.
#
# 64 also runs clean now - realtime 98.0%, underruns 0, codec xruns flat - and
# did not while MAME's audio threads sat at the emulation thread's SCHED_RR
# priority; see the ExecStartPost below and docs/audio-chain.md. The old reading
# that "MAME emits a whole frame's audio in one burst every 10.9ms" was of the
# CONSUMER being gated by the scheduler, not of the producer bursting.
Environment=MPC_PIPEWIRE_FRAMES=64
# One host sound update per graph quantum, so a callback consumes a whole number
# of producer updates.
Environment=MPC_SOUND_UPDATES_PER_QUANTUM=1
# Output cushion, in QUANTA. ONE - 64 frames at a 64-frame quantum, 1.45ms.
#
# This was 32 quanta, which is a leftover from when the cushion was mitigation:
# the producer was starved of 90% of its audio (docs/audio-chain.md) and depth
# was the only thing that moved the symptom. Depth is not free - it is output
# latency, in front of the DAC, and it scales with the quantum, so the same "32"
# meant 46ms at a 64-frame quantum and 93ms at 128. On an instrument that is the
# difference between playing and not.
#
# With the producer delivering full rate the ring does not need a cushion to
# survive. If one quantum is not enough, the answer is to find what is late,
# not to buy time in front of the DAC.
Environment=MAME_PIPEWIRE_PREBUFFER_QUANTA=1
Environment=MAME_PIPEWIRE_BUFFERS=16
# Stereo, as the host runs it - the machine has several speaker devices and
# only :speaker carries the program's audio.
Environment=MPC_OUTPUT_MODE=stereo
# The audio clock is the timing master, which also selects -nothrottle: MAME
# free-runs and the PipeWire backend paces it by the buffer it has queued.
#
# This was set to video/-throttle for a long time on the strength of PipeWire's
# ERR column on the emulator's node - 9556 unthrottled against 259 throttled.
# That column does not count dropouts; docs/system-placement.md had already
# recorded as much after it cost days elsewhere. Measured properly, once the
# audio threads can actually run (ExecStartPost below), over 25s each:
#
#     audio clock + -throttle     underruns 1.7/s
#     audio clock + -nothrottle   underruns 0.0/s, 99.8% of realtime
#
# -throttle caps the emulator at 100% against the HOST clock, so it can never
# build a cushion against the codec's own clock; the buffer is the only thing
# that can pace it correctly.
Environment=MAME_TIMING_MASTER=audio
Environment=MPC_THROTTLE_MODE=nothrottle
Environment=MPCPI_PROJECT=/opt/mpc-media/mpc-tutor-logic-mpc2000xl.img
# NO AUTOPLAY. This was =1, so the emulator started a beat every time the
# service came up - and every deploy restarts the service, so the loop kept
# starting under the player unasked. mpcpi-autoplay.lua is explicit that the
# flag is a TEST aid and that unset is "boot and sit there, which is the
# appliance": the unit was simply shipping the test setting.
#
# Set MPCPI_AUTOPLAY=1 in a drop-in for a smoke test; do not put it back here.
# Environment=MPCPI_AUTOPLAY=1
Environment=XDG_RUNTIME_DIR=/run/user/1001

ExecStart=/opt/mpc-pi-src/scripts/run-mpc2000xl-turbo.sh \
    -flop ${MPCPI_PROJECT} \
    -midiin1 "VirMIDI 0-0" -midiout1 "VirMIDI 0-1" \
    -autoboot_script /opt/mpc-pi-src/scripts/daw/mpcpi-autoplay.lua \
    -autoboot_delay 1

# It is -midiin1, not -midiin: MAME exposes MIDI as per-machine IMAGE devices,
# and -midiin exits with "unknown option".
#
# No -seconds_to_run: that flag belongs to measurement harnesses.

# Re-link the audio EVERY time this starts, including automatic restarts.
#
# mpcpi-monitor-route.service has PartOf=mpcpi-emulator.service, which sounds
# like it covers this and does not: PartOf propagates stop and restart only when
# the emulator is stopped or restarted through systemctl. When systemd restarts
# it itself - Restart=on-failure, after a crash or a kill -9 - the dependent unit
# is never re-triggered. The emulator comes back with a fresh PipeWire node and
# no links, the screens carry on as if nothing happened, and the instrument is
# silent for reasons nothing reports. That accounted for several rounds of
# "I hear nothing" today.
#
# '+' runs it as root: the routing script sudo's into the mpc session, which
# User=mpc cannot do. `|| true` because audio routing must never be the reason
# the instrument fails to start - and the loop waits for the node rather than
# guessing how long the graph takes to publish it.
ExecStartPost=+/bin/sh -c 'for i in $(seq 1 20); do /usr/bin/mpc-monitor-route.sh link >/dev/null 2>&1 && exit 0; sleep 2; done; true'

# AND THE USB ROUTE, for exactly the reason spelled out above.
#
# mpcpi-usb-route.service is PartOf this unit, which covers a `systemctl
# restart` and covers nothing else. PartOf propagates STOP and RESTART; it does
# not propagate START. So `systemctl stop mpcpi-emulator` takes the route
# service down with it and the following `systemctl start` leaves it down - the
# ordinary shape of a redeploy.
#
# What that costs is not obvious from the outside, and it cost a whole
# diagnosis here: the emulator comes back with a FRESH :mic node, WirePlumber
# auto-connects it to the default source, and the default source is
# mpcpi-clock's monitor - a null sink. The sampler is then wired to silence.
# Everything downstream looks perfect - the node exists, the graph runs, the
# guest's DMA drains the ADC ring at full rate - and the SAMPLE screen's level
# meter sits at zero because the audio it is metering is a null sink's.
#
# So re-link the gadget return on EVERY start, the same way the monitor route
# already is. `|| true` because audio routing must never be the reason the
# instrument fails to start.
ExecStartPost=+/bin/sh -c 'for i in $(seq 1 20); do /usr/bin/mpc-usb-route.sh on >/dev/null 2>&1 && exit 0; sleep 2; done; true'

# Put MAME's audio threads above its emulation thread. THIS is what fixed the
# crackle: chrt --rr 20 in run-mpc.sh applies to the process, so the sound
# effects thread and PipeWire's client loop inherit the emulation thread's
# priority, and SCHED_RR does not preempt at equal priority. The audio producer
# delivered 9.7% of realtime; with this it delivers 99.8%, underruns 0. The
# script explains the measurement in full. '+' for root: chrt on another user's
# threads needs it. `|| true` so a scheduling tweak can never fail the boot.
ExecStartPost=+/bin/sh -c '/usr/bin/mpc-audio-thread-priority.sh || true'

# PAM limits in /etc/security/limits.d never reach a systemd service.
LimitRTPRIO=95
LimitMEMLOCK=infinity
LimitNICE=-19

Restart=on-failure
RestartSec=2
# MAME ignores SIGTERM: it sat in "deactivating" until the stop timeout every
# single time, so every restart cost eight seconds and a stale PipeWire client.
KillSignal=SIGTERM
TimeoutStopSec=8
KillMode=mixed
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
