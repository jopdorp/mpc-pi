[Unit]
Description=Link the emulator and Ardour into the USB gadget's 22 channels
# Needs the gadget's ALSA node (from mpcpi-usb-gadget) and the emulator's and
# Ardour's PipeWire nodes (:speaker, :Master, :LOOP1..5) all to exist before a
# single link can be made.
#
# PartOf both audio units so it reruns whenever either restarts: their nodes
# are recreated with new ids each time, and the old links die with them - the
# same reason mpcpi-monitor-route.service is PartOf the emulator.
After=mpcpi-usb-gadget.service mpcpi-emulator.service mpcpi-daw.service
Requires=mpcpi-usb-gadget.service mpcpi-emulator.service mpcpi-daw.service
PartOf=mpcpi-emulator.service mpcpi-daw.service

[Service]
# Type=exec, NOT oneshot.
#
# As a oneshot this sat on the critical chain and cost 9.6s of boot - the
# single largest unit on the appliance, measured with `systemd-analyze
# critical-chain`. multi-user.target waits for a oneshot to FINISH, and this
# one only finishes after its retry loop has waited for Ardour to publish
# :Master and :LOOP1..5, which takes most of ten seconds.
#
# Nothing needs to block on it. The instrument is playable as soon as the
# emulator and the hub are up; the gadget links are a tap for a computer
# that is very probably not plugged in yet. With Type=exec systemd counts
# the unit started as soon as the process execs, so the retry loop runs
# alongside the rest of boot instead of in front of it.
#
# The tradeoff, stated plainly: `systemctl is-active` now says "active"
# while retries are still in flight, so it is no longer a synchronous
# answer to "are the links up". `mpc-usb-route.sh status` is, and that is
# what any check should use.
Type=exec
# RemainAfterExit=yes, and it is not optional.
#
# Without it this unit destroyed its own work on every boot. ExecStart is a
# retry loop that EXITS as soon as routing succeeds; systemd then saw the
# main process gone, deactivated the unit, and ran ExecStop - which is
# `mpc-usb-route.sh off`, "disconnect everything". Measured on a clean boot:
# links made at 09:01:01, `mpc-usb-route: disconnected` at 09:01:04, and the
# appliance came up with an empty graph. The unit reported "active (exited)"
# the whole time, so nothing looked wrong.
#
# With this set, the unit stays active after the loop exits and ExecStop
# fires only on a real stop - a restart of the emulator or Ardour (PartOf)
# or shutdown, which are exactly the times the stale links must go.
RemainAfterExit=yes
# The graph needs a moment after every node appears. Retrying is cheaper than
# guessing a delay - the script is idempotent, and it logs a channel as idle
# rather than failing outright when only part of the graph (e.g. Ardour) is
# not up yet, so this loop is really waiting for "as much as will ever link".
ExecStart=/bin/sh -c 'for i in $(seq 20); do /usr/bin/mpc-usb-route.sh on && exit 0; sleep 2; done; exit 1'
ExecStop=/usr/bin/mpc-usb-route.sh off

[Install]
WantedBy=multi-user.target
