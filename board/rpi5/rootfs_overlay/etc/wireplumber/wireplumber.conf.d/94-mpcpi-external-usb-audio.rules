# An external USB audio interface may join the graph, but must never drive it.
#
# The appliance's clock is a null-audio-sink at a fixed 32-frame quantum, and
# everything else follows it. A USB interface plugged in for monitoring or
# testing arrives with a perfectly respectable driver priority and can win
# the election, at which point the whole graph reclocks to whatever that
# device can manage - which for a full-speed codec is nowhere near 32
# frames. The instrument's latency would then depend on what someone
# happened to plug in.
#
# So: allowed, unsuspended, and pinned to a low driver priority. It also
# stays OUT of node.group "mpcpi-audio", because driver election happens
# per group and membership is what would let it compete at all.
#
# This is written against the DEVICE's nodes, not the device: node
# properties in a device rule do nothing, which is a trap this project has
# already paid for once.
monitor.alsa.rules = [
  {
    matches = [
      # USB audio class devices, excluding our own UAC2 gadget - that one is
      # the instrument's output to the host and is configured separately.
      {
        node.name = "~alsa_(output|input)\\.usb-.*"
        node.name = "!~alsa_.*platform-.*\\.usb.*"
      }
    ]
    actions = {
      update-props = {
        # Low enough that the null-sink clock (5000) and the gadget always
        # win, high enough to be usable.
        priority.driver  = 50
        priority.session = 50
        # Do not join the audio group: election is per group.
        node.group       = "mpcpi-external"
        # Never suspend. A monitoring interface that idles into suspend
        # produces a gap the next time something plays through it.
        node.pause-on-idle = false
        session.suspend-timeout-seconds = 0
        # Let it choose a period it can actually meet. The 32-frame period
        # forced on the gadget is not achievable on a full-speed codec, and
        # forcing it produces continuous xruns that look like a fault in the
        # appliance rather than a mismatch with the accessory.
        api.alsa.period-size = 256
        api.alsa.headroom    = 128
      }
    }
  }
]
