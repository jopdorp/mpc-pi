# The external USB audio interface is the LOCAL monitoring path - the
# stand-in for the ADC/DAC that will eventually be wired to the I2S header.
#
# So it is not merely tolerated: it carries what the player hears, and its
# output latency matters. An earlier version of this file gave it a
# 256-frame period specifically to keep it out of the way, which is the
# right rule for an accessory and the wrong one for the monitor path.
#
# What it must still NOT do is drive the graph. The appliance's clock is a
# null-audio-sink at a fixed 32-frame quantum and everything follows it; if
# this device won the driver election, the whole graph would reclock to
# whatever a full-speed codec can manage and the instrument's latency would
# depend on what is plugged in. Driver election happens per node.group, so
# keeping it in its own group is what stops it competing at all - low
# priority alone would not.
#
# Period: start at 64 frames and let it fail upward rather than assuming.
# This is a FULL SPEED device (1ms USB frames), so 32 is likely unreachable
# and 64 is the honest first attempt. api.alsa.period-size is a request, not
# a guarantee - check the running value in /proc/asound/cardN/pcm0p/sub0/
# hw_params rather than trusting this file.
monitor.alsa.rules = [
  {
    matches = [
      # USB audio class devices, excluding our own UAC2 gadget - that one is
      # the instrument's output to the host and is configured separately.
      {
        node.name = "~alsa_(output|input)\\.usb-.*"
        node.name = "!~alsa_.*platform-.*\\.usb.*"
      }
    ]
    actions = {
      update-props = {
        # Low enough that the null-sink clock (5000) and the gadget always
        # win, high enough to be usable.
        priority.driver  = 50
        priority.session = 50
        # Do not join the audio group: election is per group.
        node.group       = "mpcpi-external"
        # Never suspend. A monitoring interface that idles into suspend
        # produces a gap the next time something plays through it.
        node.pause-on-idle = false
        session.suspend-timeout-seconds = 0
        # As low as this device can hold. It is the monitoring path, so its
        # output latency is the latency the player feels when the gadget is
        # not the destination.
        api.alsa.period-size = 64
        api.alsa.period-num  = 2
        api.alsa.headroom    = 32
        api.alsa.disable-batch = true
      }
    }
  }
]
