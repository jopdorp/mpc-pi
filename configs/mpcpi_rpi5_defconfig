# MPC2000XL appliance for Raspberry Pi 5.
#
# This is buildroot's own raspberrypi5_defconfig plus this project's deltas,
# rather than a configuration written from scratch: the upstream one already
# pins a working kernel, firmware and toolchain for the board.
#
#   make BR2_EXTERNAL=/path/to/mpc-pi mpcpi_rpi5_defconfig && make

# ---- from raspberrypi5_defconfig ----
BR2_aarch64=y
BR2_cortex_a76=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi5/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment $(BR2_EXTERNAL_MPC_PI_PATH)/board/rpi5/linux-usb-audio.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MPC_PI_PATH)/board/rpi5/busybox.fragment"
BR2_PACKAGE_XZ=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
# Compiles board/rpi5/overlays at image time; the kernel's internal dtc is
# not installed into HOST_DIR.
BR2_PACKAGE_HOST_DTC=y

# ---- this project's deltas ----
BR2_TARGET_GENERIC_HOSTNAME="mpc2000xl"
BR2_TARGET_GENERIC_ISSUE="MPC2000XL appliance"

# Boot files carrying the I2S overlay and the isolated cores.
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_MPC_PI_PATH)/board/rpi5/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_MPC_PI_PATH)/board/rpi5/cmdline.txt"
# Needed for vc4-kms-v3d and for the mpc-audio overlay this project adds.
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MPC_PI_PATH)/board/rpi5/rootfs_overlay"
# Ours first: it stages the compiled overlay that the upstream script's
# genimage run then packs into the boot partition.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MPC_PI_PATH)/board/rpi5/post-image.sh board/raspberrypi5/post-image.sh"

# MAME plus its ROM set needs considerably more than the 120M sample.
BR2_TARGET_ROOTFS_EXT2_SIZE="1500M"

# Audio. PipeWire is required: the emulator's audio-clock pacing is
# implemented against it by patches 0004/0009/0011.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_ARECORD=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_PIPEWIRE=y
# PipeWire is only a graph; without a session manager no links are ever
# created and the emulator's stream would connect to nothing.
BR2_PACKAGE_WIREPLUMBER=y
# PipeWire installs its ALSA plugin whenever alsa-lib is present in 2025.11;
# there is no separate _ALSA symbol.

# Graphics: KMS/DRM only, no X11.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y

# MAME itself is cross compiled separately by scripts/build-mame-rpi5.sh and
# lands in the rootfs overlay; wrapping it as a Buildroot package was more
# friction than it was worth for something rebuilt this often.
# USB audio and USB MIDI. The Maschine is a USB device and an external audio
# interface is the fallback path while the I2S board is not attached, so both
# class drivers are built in rather than left to chance.
BR2_PACKAGE_LIBUSB_COMPAT=y
BR2_PACKAGE_USBUTILS=y

BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_LIBUSB=y

BR2_PACKAGE_MPC_MK1_DISPLAY=y
